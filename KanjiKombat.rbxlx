		part({ Name="PortalArchR"..side, Size=Vector3.new(0.9,7,0.9), Position=Vector3.new(px+2.2,4.8,-70), Color=Color3.fromRGB(60,58,78), Parent=lobby })
		part({ Name="PortalArchTop"..side, Size=Vector3.new(5.6,0.9,0.9), Position=Vector3.new(px,8,-70), Color=Color3.fromRGB(60,58,78), Parent=lobby })
		local portal = part({ Name="Portal"..side, Size=Vector3.new(3.4,5,0.4), Position=Vector3.new(px,4.8,-70), Color=Color3.fromRGB(120,90,255), Material=Enum.Material.Neon, Transparency=0.26, Parent=lobby })
		addLight(portal, Color3.fromRGB(140,110,255), 18, 2)
		local pSign = part({ Name="PortalSign"..side, Size=Vector3.new(5,1.6,0.3), Position=Vector3.new(px,9.2,-70), Color=Color3.fromRGB(18,16,22), Parent=lobby })
		local txt = (side==-1) and "RANKED / ランク" or "CASUAL / カジュアル"
		addSurfaceText(pSign, txt, nil, Color3.fromRGB(180,160,255))
	end

	-- ── 街灯 &amp; のぼり旗 ─────────────────────────────────
	for i=1,16 do
		local angle = (i/16)*math.pi*2
		local r = 78
		local x = math.cos(angle)*r
		local z = math.sin(angle)*r
		part({ Name="StreetPole"..i, Size=Vector3.new(0.6,8,0.6), Position=Vector3.new(x,4, z), Color=Color3.fromRGB(52,48,42), Parent=lobby })
		local lamp = part({ Name="StreetLamp"..i, Size=Vector3.new(1.4,1.4,1.4), Position=Vector3.new(x,8.4,z), Color=Color3.fromRGB(255,210,90), Material=Enum.Material.Neon, Parent=lobby })
		addLight(lamp, Color3.fromRGB(255,210,90), 18, 1.6)
		-- のぼり
		if i%2==0 then
			part({ Name="Nobori"..i, Size=Vector3.new(0.15,4,1.6), Position=Vector3.new(x,5, z), Color=Color3.fromRGB(188,30,42), Material=Enum.Material.Fabric, Parent=lobby })
		end
	end

	-- ── 大提灯群 (夜祭り感) ─────────────────────────────
	for i=1,8 do
		local x = -56 + (i-1)*16
		local z = -72
		local lan = part({ Name="FestLantern"..i, Size=Vector3.new(1.6,2,1.6), Position=Vector3.new(x,9,z), Color=Color3.fromRGB(255,120,90), Material=Enum.Material.Neon, Parent=lobby })
		addLight(lan, Color3.fromRGB(255,140,90), 14, 1.3)
		part({ Name="FestLanternLine"..i, Size=Vector3.new(0.12,6,0.12), Position=Vector3.new(x,12,z), Color=Color3.fromRGB(80,70,60), Parent=lobby })
	end

	-- ── スポーン ───────────────────────────────────────
	-- placeファイル側に既にSpawnLocationがある場合 (スクリプト起動前の湧き用) は二重に作らない
	if not workspace:FindFirstChildWhichIsA("SpawnLocation", true) then
		local spawnLoc = Instance.new("SpawnLocation")
		spawnLoc.Name = "Spawn"
		spawnLoc.Size = Vector3.new(12,1,12)
		spawnLoc.Position = Vector3.new(0,1.5,54)
		spawnLoc.Anchored = true
		spawnLoc.CanCollide = true
		spawnLoc.Neutral = true
		spawnLoc.Duration = 0
		spawnLoc.Color = Color3.fromRGB(90,75,110)
		spawnLoc.Parent = lobby
	end

	LobbyService.spawnCFrame = CFrame.new(0, 8, 54)
	LobbyService.spectateCFrame = CFrame.new(0, 14, 12) * CFrame.Angles(math.rad(-12), 0, 0)
end

function LobbyService.getSpawn()
	return LobbyService.spawnCFrame or CFrame.new(0, 8, 54)
end

return LobbyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">MatchService</string><ProtectedString name="Source">--!nonstrict
-- マッチメイキングと超拡張対戦進行 + 練習モード
-- 古いテスト互換を維持しつつ、コンボ・必殺・シールド・クリティカル・課金アイテムを統合

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local MatchService = {}

local QuestionBank, StatsService, ArenaService, LobbyService
local CurrencyService, ProgressionService
local S2C, C2S -- RemoteEvents

local queues = {}     -- [levelKey] = { {player, rating, enqueuedAt}, ... }
local inMatch = {}    -- [player] = match
local matches = {}    -- [match] = true
local practice = {}   -- [player] = state

local B = Config.BATTLE

local function send(player, action, data)
	data = data or {}
	data.action = action
	pcall(function()
		S2C:FireClient(player, data)
	end)
end

local function broadcastQueueCounts()
	local counts = {}
	for key, q in pairs(queues) do
		counts[key] = #q
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		send(pl, "queue", counts)
	end
end

function MatchService.init(deps)
	QuestionBank = deps.QuestionBank
	StatsService = deps.StatsService
	ArenaService = deps.ArenaService
	LobbyService = deps.LobbyService
	CurrencyService = deps.CurrencyService
	ProgressionService = deps.ProgressionService
	S2C = deps.S2C
	C2S = deps.C2S
end

-- ------------------------------------------------------------- queue
function MatchService.joinQueue(player, levelKey)
	if not Config.levelByKey(levelKey) then return end
	if inMatch[player] then return end
	MatchService.leaveQueue(player)
	if not queues[levelKey] then queues[levelKey] = {} end
	local prof = StatsService and StatsService.get(player)
	local rating = prof and prof.ratings[levelKey] or Config.DEFAULT_RATING
	table.insert(queues[levelKey], { player = player, rating = rating, t = os.clock() })
	send(player, "toast", { key = "toastSearching", args = { level = levelKey } })
	broadcastQueueCounts()
end

function MatchService.leaveQueue(player)
	for key, q in pairs(queues) do
		for i, ent in ipairs(q) do
			if ent.player == player then
				table.remove(q, i)
				break
			end
		end
	end
	broadcastQueueCounts()
end

local function popTwo(levelKey)
	local q = queues[levelKey]
	if not q then return nil end
	-- 退場済み掃除
	for i = #q, 1, -1 do
		local ent = q[i]
		if not ent.player.Parent or inMatch[ent.player] then
			table.remove(q, i)
		end
	end
	if #q &lt; 2 then return nil end
	-- レーティング近い順にソートして先頭2人を出す (簡易スキルマッチ)
	table.sort(q, function(a,b) return a.rating &lt; b.rating end)
	-- 初回はなるべくレート差が小さいペアを探す。差が200以上なら少し待つ (最大45秒のQUEUE_TIMEOUTで強制マッチ)
	local now = os.clock()
	for i=1, #q-1 do
		for j=i+1, #q do
			local diff = math.abs(q[i].rating - q[j].rating)
			local wait = math.max(now - q[i].t, now - q[j].t)
			if diff &lt; 250 or wait &gt; Config.QUEUE_TIMEOUT * 0.7 then
				local a = table.remove(q, j)
				local b = table.remove(q, i)
				return a.player, b.player
			end
		end
	end
	-- 見つからなければ先頭2人
	local a = table.remove(q, 1)
	local b = table.remove(q, 1)
	return a.player, b.player
end

function MatchService.tick()
	for _, lv in ipairs(Config.LEVELS) do
		while true do
			local a, b = popTwo(lv.key)
			if not a then break end
			MatchService.startMatch(lv.key, a, b)
		end
	end
end

-- ------------------------------------------------------------- match
local function isSingleCharPrompt(s)
	-- UTF-8の文字数を正しく数える (漢字1文字判定のバグ修正: #s はバイト長)
	if utf8 and utf8.len then
		local ok, l = pcall(function() return utf8.len(s) end)
		if ok and l then return l == 1 end
	end
	-- フォールバック: UTF-8のコードポイント数を数える
	local _, count = string.gsub(s, "[^\128-\191]", "")
	return count == 1
end

local function teleport(player, cf)
	local char = player.Character
	if char then
		-- PrimaryPartがなくてもPivotToでテレポート可能 (バグ修正)
		pcall(function() char:PivotTo(cf) end)
	end
end

local function ensureBattleState(profile, player)
	-- プロファイル側ではなく match 内の一時ステートを初期化
	return {
		combo = 0,
		maxCombo = 0,
		ult = 0,
		shield = B.START_SHIELD,
		missStreak = 0,
		perfects = 0,
		hintUsed = false,
		ultUsed = false,
		totalDealt = 0,
	}
end

local function calcDamage(correct, timeTaken, first, ownHp, state, opponentCorrect, opponentShield)
	if not correct then return 0, { isPerfect=false, isCrit=false, combo=state.combo, guard=false, shielded=false } end
	local elapsed = timeTaken
	local dmg = Config.DMG_BASE
	local flags = { isPerfect=false, isCrit=false, combo=state.combo, guard=false, shielded=false, comeback=false }
	-- 速答
	if elapsed &lt;= 3 then dmg = dmg + Config.DMG_FAST_BONUS end
	if first then dmg = dmg + Config.DMG_FIRST_BONUS end
	-- パーフェクト
	if elapsed &lt;= B.PERFECT_WINDOW then
		dmg = dmg + B.PERFECT_BONUS
		flags.isPerfect = true
	end
	-- 逆転
	if ownHp &lt;= B.COMEBACK_HP then
		dmg = dmg + B.COMEBACK_BONUS
		flags.comeback = true
	end
	-- 残り時間ボーナス (math.clamp がない環境へのフォールバック)
	local remain = Config.QUESTION_TIME - elapsed
	if remain &gt; 0 then
		local add = math.floor(remain/2)
		if math.clamp then
			dmg = dmg + math.clamp(add, 0, B.TIME_BONUS_MAX)
		else
			dmg = dmg + math.max(0, math.min(add, B.TIME_BONUS_MAX))
		end
	end
	-- コンボ
	local combo = state.combo -- この問題を正解する前の combo (呼出側で +1 する前)
	local bonus = B.COMBO_BONUS[math.min(combo+1, #B.COMBO_BONUS)] or 0
	local mult = B.COMBO_MULTIPLIER[math.min(combo+1, #B.COMBO_MULTIPLIER)] or 1
	dmg = dmg + bonus
	dmg = math.floor(dmg * mult + 0.5)
	flags.combo = combo+1
	flags.mult = mult
	-- クリティカル (12%)
	if math.random() &lt; B.CRIT_CHANCE then
		dmg = math.floor(dmg * B.CRIT_MULTIPLIER + 0.5)
		flags.isCrit = true
	end
	-- ガード (両者正解なら被ダメ側が軽減 = 与ダメ側が減る)
	if opponentCorrect then
		dmg = math.floor(dmg * (1 - B.GUARD_REDUCTION) + 0.5)
		flags.guard = true
	end
	-- シールド
	if opponentShield then
		dmg = math.floor(dmg * (1 - B.SHIELD_REDUCTION) + 0.5)
		flags.shielded = true
	end
	return dmg, flags
end

function MatchService.startMatch(levelKey, p1, p2)
	local arena = ArenaService.get(levelKey)
	if not arena then return end
	inMatch[p1] = true
	inMatch[p2] = true
	MatchService.leaveQueue(p1)
	MatchService.leaveQueue(p2)

	local match = {
		levelKey = levelKey,
		players = { p1, p2 },
		hp = { [p1] = Config.MAX_HP, [p2] = Config.MAX_HP },
		exclude = {},
		round = 0,
		answers = {}, -- [player] = {idx, t}
		answerCount = 0,
		dead = false,
		state = {
			[p1] = ensureBattleState(StatsService.get(p1), p1),
			[p2] = ensureBattleState(StatsService.get(p2), p2),
		},
		midActions = {}, -- [player] = {hint, ult}
	}
	matches[match] = true
	-- プロファイルのコスメを反映 (アリーナスキン)
	local prof1 = StatsService.get(p1)
	local prof2 = StatsService.get(p2)

	task.spawn(function()
		teleport(p1, arena.spawnA)
		teleport(p2, arena.spawnB)
		-- イントロでバトル演出を送る
		send(p1, "matchIntro", {
			levelKey = levelKey, opponent = p2.DisplayName, opponentRank = Config.rankOf(prof2.ratings[levelKey] or 1000).key,
			total = Config.ROUND_COUNT, myRank = Config.rankOf(prof1.ratings[levelKey] or 1000).key,
			myHp = Config.MAX_HP, opHp = Config.MAX_HP,
		})
		send(p2, "matchIntro", {
			levelKey = levelKey, opponent = p1.DisplayName, opponentRank = Config.rankOf(prof1.ratings[levelKey] or 1000).key,
			total = Config.ROUND_COUNT, myRank = Config.rankOf(prof2.ratings[levelKey] or 1000).key,
			myHp = Config.MAX_HP, opHp = Config.MAX_HP,
		})
		task.wait(Config.INTRO_TIME)

		local loser = nil
		for round = 1, Config.ROUND_COUNT do
			if match.dead then break end
			local ko = MatchService.playRound(match, round, false)
			if ko then loser = ko break end
			task.wait(0.35)
		end
		if match.dead then MatchService.endMatch(match, nil) return end

		local suddenCount = 0
		while not match.dead and not loser and match.hp[p1] == match.hp[p2] and suddenCount &lt; 10 do
			suddenCount = suddenCount + 1
			loser = MatchService.playRound(match, match.round + 1, true)
			if loser == "none" then loser = nil end
		end

		local winner, reason
		if loser and loser ~= "none" and loser ~= "win1" and loser ~= "win2" then
			winner = (loser == p1) and p2 or p1
			reason = "KO"
		elseif loser == "win1" then
			winner = p1; loser = p2; reason = "KO"
		elseif loser == "win2" then
			winner = p2; loser = p1; reason = "KO"
		elseif match.hp[p1] &gt; match.hp[p2] then
			winner = p1; loser = p2; reason = "HP"
		elseif match.hp[p2] &gt; match.hp[p1] then
			winner = p2; loser = p1; reason = "HP"
		else
			send(p1, "matchEnd", { draw = true, levelKey=levelKey, coins=Config.ECONOMY.REWARD_DRAW })
			send(p2, "matchEnd", { draw = true, levelKey=levelKey, coins=Config.ECONOMY.REWARD_DRAW })
			-- 引き分けでも報酬
			for _, p in ipairs(match.players) do
				if CurrencyService then CurrencyService.grant(p, Config.ECONOMY.REWARD_DRAW, 0, "draw") end
				if ProgressionService then ProgressionService.addXp(p, Config.PROGRESSION.XP_PER_LOSE, "draw") end
			end
			task.wait(2.5)
			MatchService.endMatch(match, nil)
			return
		end

		-- Elo + 報酬計算
		local dw = StatsService.applyResult(levelKey, winner, loser)
		for _, p in ipairs(match.players) do
			local prof = StatsService.get(p)
			local isWin = (p == winner)
			local coins = isWin and Config.ECONOMY.REWARD_WIN or Config.ECONOMY.REWARD_LOSE
			-- コンボやパーフェクトで追加
			local st = match.state[p]
			if st then
				if st.maxCombo &gt;=3 then coins = coins + Config.ECONOMY.REWARD_COMBO3 end
				if st.perfects &gt;=1 then coins = coins + Config.ECONOMY.REWARD_PERFECT * st.perfects end
			end
			if isWin then coins = coins + math.floor((st and st.maxCombo or 0)/2) * 5 end
			if CurrencyService then CurrencyService.grant(p, coins, 0, isWin and "win" or "lose") end
			-- XP
			if ProgressionService then
				local xp = isWin and Config.PROGRESSION.XP_PER_WIN or Config.PROGRESSION.XP_PER_LOSE
				xp = xp + (st and st.maxCombo or 0) * 4
				xp = xp + (st and st.perfects or 0) * Config.PROGRESSION.XP_PERFECT_BONUS
				ProgressionService.addXp(p, xp, isWin and "win" or "lose")
				-- ミッション
				ProgressionService.progressMission(p, isWin and "win1" or "lose1", 1)
				if isWin then ProgressionService.progressMission(p, "win10", 1) end
				ProgressionService.progressMission(p, "correct10", st and st.totalDealt and 5 or 0)
			end

			local rank = Config.rankOf(prof.ratings[levelKey])
			local prog = Config.rankProgress(prof.ratings[levelKey])
			send(p, "matchEnd", {
				win = isWin,
				reason = reason,
				opponent = (p == winner) and loser.DisplayName or winner.DisplayName,
				rating = prof.ratings[levelKey],
				delta = isWin and dw or -dw,
				wins = prof.wins,
				losses = prof.losses,
				streak = prof.streak,
				coins = coins,
				rankKey = rank.key,
				rankIcon = rank.icon,
				rankProgress = prog,
				maxCombo = st and st.maxCombo or 0,
				perfects = st and st.perfects or 0,
			})
		end
		task.wait(4)
		MatchService.endMatch(match, winner)
	end)
end

-- 1ラウンド進行。KO時は敗者playerを返す。サドンデス時は勝者を返す("none"=両方誤答)
function MatchService.playRound(match, round, sudden)
	match.round = round
	match.answers = {}
	match.answerCount = 0
	match.midActions = {}
	local q = QuestionBank.draw(match.levelKey, match.exclude)
	if not q then return nil end
	local choices, correct = QuestionBank.pack(q)
	local deadline = os.clock() + Config.QUESTION_TIME
	local qStart = os.clock()
	match.correct = correct
	match.deadline = deadline
	match.qStart = qStart
	match.choices = choices

	local hp1, hp2 = match.hp[match.players[1]], match.hp[match.players[2]]
	local st1, st2 = match.state[match.players[1]], match.state[match.players[2]]

	send(match.players[1], "question", {
		round = round, total = Config.ROUND_COUNT, sudden = sudden,
		prompt = q.p, isKanji = isSingleCharPrompt(q.p), choices = choices,
		timeLimit = Config.QUESTION_TIME, hpMe = hp1, hpOp = hp2,
		combo = st1.combo, ult = st1.ult, shield = st1.shield, opUlt = st2.ult,
	})
	send(match.players[2], "question", {
		round = round, total = Config.ROUND_COUNT, sudden = sudden,
		prompt = q.p, isKanji = isSingleCharPrompt(q.p), choices = choices,
		timeLimit = Config.QUESTION_TIME, hpMe = hp2, hpOp = hp1,
		combo = st2.combo, ult = st2.ult, shield = st2.shield, opUlt = st1.ult,
	})

	while os.clock() &lt; deadline and match.answerCount &lt; 2 do
		task.wait(0.05)
	end
	task.wait(0.1)

	local function resultOf(p)
		local a = match.answers[p]
		if not a then return { correct = false, t = math.huge, idx = 0, timeTaken = Config.QUESTION_TIME } end
		local timeTaken = a.t - qStart
		return {
			correct = (a.idx == match.correct) and a.t &lt;= deadline + 0.6,
			t = a.t,
			idx = a.idx,
			timeTaken = timeTaken,
		}
	end

	local r1 = resultOf(match.players[1])
	local r2 = resultOf(match.players[2])

	-- 必殺発動チェック (回答より前にUltボタンを押したか)
	local ult1 = match.midActions[match.players[1]] and match.midActions[match.players[1]].ult
	local ult2 = match.midActions[match.players[2]] and match.midActions[match.players[2]].ult
	local ultDmg1, ultDmg2 = 0,0
	if ult1 and st1.ult &gt;= B.ULT_MAX and r1.correct then
		ultDmg1 = B.ULT_DAMAGE
		st1.ult = 0
		st1.ultUsed = true
		-- ヒール
		match.hp[match.players[1]] = math.min(Config.MAX_HP, match.hp[match.players[1]] + B.ULT_HEAL)
		hp1 = match.hp[match.players[1]]
	end
	if ult2 and st2.ult &gt;= B.ULT_MAX and r2.correct then
		ultDmg2 = B.ULT_DAMAGE
		st2.ult = 0
		st2.ultUsed = true
		match.hp[match.players[2]] = math.min(Config.MAX_HP, match.hp[match.players[2]] + B.ULT_HEAL)
		hp2 = match.hp[match.players[2]]
	end

	-- ダメージ計算 (拡張)
	local firstT = math.min(r1.t, r2.t)
	local first1 = r1.correct and r1.t == firstT
	local first2 = r2.correct and r2.t == firstT

	local dmg1, flags1 = calcDamage(r1.correct, r1.timeTaken, first1, hp1, st1, r2.correct, st2.shield)
	local dmg2, flags2 = calcDamage(r2.correct, r2.timeTaken, first2, hp2, st2, r1.correct, st1.shield)
	-- Ult ダメージを加算
	dmg1 = dmg1 + ultDmg1
	dmg2 = dmg2 + ultDmg2

	-- シールド消費
	if flags1.shielded then st2.shield = false end
	if flags2.shielded then st1.shield = false end

	-- コンボ・ゲージ更新
	for _, pair in ipairs({{p=match.players[1], r=r1, st=st1}, {p=match.players[2], r=r2, st=st2}}) do
		if pair.r.correct then
			pair.st.combo = pair.st.combo + 1
			if pair.st.combo &gt; pair.st.maxCombo then pair.st.maxCombo = pair.st.combo end
			pair.st.missStreak = 0
			pair.st.totalDealt = pair.st.totalDealt + (pair.p == match.players[1] and dmg1 or dmg2)
			-- ゲージ
			local gain = B.ULT_GAIN_CORRECT
			if pair.r.timeTaken &lt;= B.PERFECT_WINDOW then
				gain = B.ULT_GAIN_PERFECT
				pair.st.perfects = pair.st.perfects + 1
			end
			if math.clamp then
				pair.st.ult = math.clamp(pair.st.ult + gain, 0, B.ULT_MAX)
			else
				pair.st.ult = math.max(0, math.min(pair.st.ult + gain, B.ULT_MAX))
			end
			-- 統計
			local prof = StatsService.get(pair.p)
			if prof then
				prof.totalCorrect = (prof.totalCorrect or 0)+1
				if pair.r.timeTaken &lt;= B.PERFECT_WINDOW then prof.totalPerfect = (prof.totalPerfect or 0)+1 end
				if pair.st.combo &gt; (prof.maxCombo or 0) then prof.maxCombo = pair.st.combo end
			end
			if ProgressionService then
				ProgressionService.progressMission(pair.p, "correct10", 1)
				ProgressionService.progressMission(pair.p, "correct100", 1)
				if pair.r.timeTaken &lt;= B.PERFECT_WINDOW then ProgressionService.progressMission(pair.p, "perfect3", 1) end
				if pair.st.combo &gt;=5 then ProgressionService.progressMission(pair.p, "combo5", 1) end
			end
		else
			-- 誤答: コンボリセット、ペナルティ
			pair.st.combo = 0
			pair.st.missStreak = pair.st.missStreak + 1
			if math.clamp then
				pair.st.ult = math.clamp(pair.st.ult + B.ULT_GAIN_WRONG, 0, B.ULT_MAX)
			else
				pair.st.ult = math.max(0, math.min(pair.st.ult + B.ULT_GAIN_WRONG, B.ULT_MAX))
			end
			if pair.st.missStreak &gt;= B.MISS_STREAK_PENALTY then
				-- 相手に回復させてしまう
				local other = (pair.p == match.players[1]) and match.players[2] or match.players[1]
				match.hp[other] = math.min(Config.MAX_HP, match.hp[other] + 5)
				if pair.p == match.players[1] then hp2 = match.hp[other] else hp1 = match.hp[other] end
			end
		end
	end

	-- HP反映
	match.hp[match.players[1]] = math.max(0, hp1 - dmg2)
	match.hp[match.players[2]] = math.max(0, hp2 - dmg1)

	-- セカンドチャンス (Robuxアイテム) で蘇生 (dirtyマーク修正)
	for _, p in ipairs(match.players) do
		if match.hp[p] &lt;= 0 then
			local prof = StatsService.get(p)
			if prof and prof.inventory and (prof.inventory.secondChance or 0) &gt; 0 then
				prof.inventory.secondChance = prof.inventory.secondChance - 1
				if StatsService and StatsService.markDirty then StatsService.markDirty(p) end
				match.hp[p] = 30
				send(p, "secondChanceActivated", { hp = 30 })
				send((p==match.players[1] and match.players[2] or match.players[1]), "opponentSecondChance", {})
			end
		end
	end

	local nowHp1, nowHp2 = match.hp[match.players[1]], match.hp[match.players[2]]
	send(match.players[1], "answerResult", {
		round = round, correct = r1.correct, correctIdx = match.correct,
		myIdx = r1.idx, dealt = dmg1, taken = dmg2,
		hpMe = nowHp1, hpOp = nowHp2,
		opCorrect = r2.correct,
		combo = st1.combo, maxCombo = st1.maxCombo, ult = st1.ult, opUlt = st2.ult,
		isPerfect = flags1.isPerfect, isCrit = flags1.isCrit, isGuarded = flags1.guard, wasShielded = flags1.shielded,
		mult = flags1.mult or 1, opCombo = st2.combo,
		ultDamage = ultDmg1,
	})
	send(match.players[2], "answerResult", {
		round = round, correct = r2.correct, correctIdx = match.correct,
		myIdx = r2.idx, dealt = dmg2, taken = dmg1,
		hpMe = nowHp2, hpOp = nowHp1,
		opCorrect = r1.correct,
		combo = st2.combo, maxCombo = st2.maxCombo, ult = st2.ult, opUlt = st1.ult,
		isPerfect = flags2.isPerfect, isCrit = flags2.isCrit, isGuarded = flags2.guard, wasShielded = flags2.shielded,
		mult = flags2.mult or 1, opCombo = st1.combo,
		ultDamage = ultDmg2,
	})

	if sudden then
		if r1.correct and r2.correct then
			return (r1.t &lt;= r2.t) and match.players[2] or match.players[1]
		elseif r1.correct then
			return match.players[2] == nil and "none" or "win1"
		elseif r2.correct then
			return "win2"
		end
		return "none"
	end

	if nowHp1 &lt;= 0 then return match.players[1]
	elseif nowHp2 &lt;= 0 then return match.players[2] end
	return nil
end

function MatchService.endMatch(match, winner)
	match.dead = true
	matches[match] = nil
	for _, p in ipairs(match.players) do
		inMatch[p] = nil
		-- プロファイルの streak / 統計も更新済み
		if CurrencyService then CurrencyService.sendUpdate(p) end
		teleport(p, LobbyService.getSpawn())
		send(p, "toLobby", {})
	end
end

-- ------------------------------------------------------------- practice
function MatchService.practiceStart(player, levelKey)
	if not Config.levelByKey(levelKey) then return end
	practice[player] = { levelKey = levelKey, streak = 0, exclude = {}, active = true, correct = nil }
	MatchService.practiceNext(player)
end

function MatchService.practiceNext(player)
	local st = practice[player]
	if not st or not st.active then return end
	local q = QuestionBank.draw(st.levelKey, st.exclude)
	if not q then return end
	local choices, correct = QuestionBank.pack(q)
	st.correct = correct
	st.choices = choices
	st.prompt = q.p
	send(player, "practiceQ", {
		prompt = q.p, isKanji = isSingleCharPrompt(q.p), choices = choices,
		timeLimit = 20, streak = st.streak,
		levelKey = st.levelKey,
	})
end

function MatchService.practiceSubmit(player, idx)
	local st = practice[player]
	if not st or not st.active then return end
	if not st.correct then return end
	local ok = (idx == st.correct)
	if ok then st.streak = st.streak + 1 else st.streak = 0 end
	-- 報酬
	if ok and CurrencyService then
		CurrencyService.grant(player, Config.ECONOMY.REWARD_PRACTICE_CORRECT, 0, "practice")
		if st.streak % 5 == 0 then
			CurrencyService.grant(player, Config.ECONOMY.REWARD_PRACTICE_STREAK5 - Config.ECONOMY.REWARD_PRACTICE_CORRECT, 0, "streak5")
		end
	end
	if ProgressionService then
		if ok then
			ProgressionService.addXp(player, Config.PROGRESSION.XP_PER_CORRECT, "practice")
		end
		ProgressionService.progressMission(player, ok and "correct10" or "miss", 1)
		ProgressionService.progressMission(player, "practice5", ok and 1 or 0)
	end
	send(player, "practiceResult", { correct = ok, correctIdx = st.correct, streak = st.streak })
	if ok then
		MatchService.practiceNext(player)
	else
		-- 誤答時は2秒後に次へ促すが、クライアントがpracticeNextを送るのでここでは待機
	end
	-- 経験値
end

function MatchService.practiceStop(player)
	local st = practice[player]
	if st then st.active = false end
	practice[player] = nil
end

function MatchService.practiceReroll(player)
	local st = practice[player]
	if not st or not st.active then return end
	-- コイン消費 (dirtyマーク修正)
	if CurrencyService then
		local prof = StatsService.get(player)
		if (prof.inventory.reroll or 0) &gt; 0 then
			prof.inventory.reroll = prof.inventory.reroll - 1
			if StatsService and StatsService.markDirty then StatsService.markDirty(player) end
			if CurrencyService then CurrencyService.sendUpdate(player) end
		else
			if not CurrencyService.spend(player, Config.ECONOMY.COST_REROLL_QUESTION, 0, "reroll") then
				send(player, "toast", { key = "toastNotEnoughCoins" })
				return
			end
		end
	end
	MatchService.practiceNext(player)
end

-- ------------------------------------------------------------- router
function MatchService.onRemote(player, data)
	if type(data) ~= "table" or type(data.action) ~= "string" then return end
	local a = data.action
	if a == "queue" and type(data.levelKey) == "string" then
		MatchService.joinQueue(player, data.levelKey)
	elseif a == "cancelQueue" then
		MatchService.leaveQueue(player)
	elseif a == "submit" and inMatch[player] then
		for m in pairs(matches) do
			if m.players[1] == player or m.players[2] == player then
				if m.round == data.round and not m.answers[player] and type(data.idx) == "number" then
					local idx = math.floor(data.idx)
					if idx &gt;= 1 and idx &lt;= 4 then
						m.answers[player] = { idx = idx, t = os.clock() }
						m.answerCount = m.answerCount + 1
					end
				end
				break
			end
		end
	elseif a == "useHint" and inMatch[player] then
		for m in pairs(matches) do
			if m.players[1]==player or m.players[2]==player then
				local st = m.state[player]
				if st and not st.hintUsed and m.choices then
					-- コイン or 所持品消費 (dirtyマーク修正)
					local prof = StatsService.get(player)
					local consumed = false
					if (prof.inventory.hint or 0) &gt; 0 then
						prof.inventory.hint = prof.inventory.hint - 1
						if StatsService and StatsService.markDirty then StatsService.markDirty(player) end
						if CurrencyService then CurrencyService.sendUpdate(player) end
						consumed=true
					elseif CurrencyService and CurrencyService.spend(player, Config.ECONOMY.COST_HINT, 0, "hint") then
						consumed=true
					end
					if consumed then
						st.hintUsed=true
						-- 誤答の1つをランダムに消す (正解以外)
						local wrong = {}
						for i=1,4 do if i~=m.correct then table.insert(wrong,i) end end
						local elim = wrong[math.random(#wrong)]
						send(player, "hintResult", { eliminate = elim })
					else
						send(player, "toast", { key="toastNotEnoughCoins" })
					end
				end
				break
			end
		end
	elseif a == "activateUltimate" and inMatch[player] then
		for m in pairs(matches) do
			if m.players[1]==player or m.players[2]==player then
				local st = m.state[player]
				if st and st.ult &gt;= B.ULT_MAX then
					m.midActions[player] = m.midActions[player] or {}
					m.midActions[player].ult = true
					send(player, "ultimateReady", { activated=true })
				else
					send(player, "toast", { key="toastUltNotReady" })
				end
				break
			end
		end
	elseif a == "useShield" and inMatch[player] then
		for m in pairs(matches) do
			if m.players[1]==player or m.players[2]==player then
				local st = m.state[player]
				local prof = StatsService.get(player)
				if st and not st.shield and (prof.inventory.shield or 0)&gt;0 then
					prof.inventory.shield = prof.inventory.shield - 1
					if StatsService and StatsService.markDirty then StatsService.markDirty(player) end
					st.shield = true
					send(player, "shieldActivated", {})
					if CurrencyService then CurrencyService.sendUpdate(player) end
				elseif CurrencyService and CurrencyService.spend(player, Config.ECONOMY.COST_SHIELD_REFILL, 0, "shield") then
					st.shield = true
					send(player, "shieldActivated", {})
				else
					send(player, "toast", { key="toastNotEnoughCoins" })
				end
				break
			end
		end
	elseif a == "practiceStart" and type(data.levelKey) == "string" then
		MatchService.practiceStop(player)
		MatchService.practiceStart(player, data.levelKey)
	elseif a == "practiceSubmit" and type(data.idx) == "number" then
		local idx = math.floor(data.idx)
		if idx &gt;= 1 and idx &lt;= 4 then MatchService.practiceSubmit(player, idx) end
	elseif a == "practiceNext" then
		MatchService.practiceNext(player)
	elseif a == "practiceReroll" then
		MatchService.practiceReroll(player)
	elseif a == "practiceStop" then
		MatchService.practiceStop(player)
	elseif a == "setLocale" and type(data.locale) == "string" then
		StatsService.setLocale(player, data.locale, data.source)
	end
end

Players.PlayerRemoving:Connect(function(player)
	MatchService.leaveQueue(player)
	MatchService.practiceStop(player)
	if inMatch[player] then
		for m in pairs(matches) do
			if m.players[1] == player or m.players[2] == player then
				local other = (m.players[1] == player) and m.players[2] or m.players[1]
				if not m.dead then
					m.dead = true
					local prof = StatsService.get(other)
					send(other, "matchEnd", {
						win = true, reason = "leave",
						opponent = player.DisplayName,
						rating = prof.ratings[m.levelKey],
						delta = 10, wins = prof.wins, losses = prof.losses, streak = prof.streak,
						coins = Config.ECONOMY.REWARD_WIN,
					})
					if CurrencyService then CurrencyService.grant(other, Config.ECONOMY.REWARD_WIN, 0, "leave") end
					task.delay(3, function() MatchService.endMatch(m, other) end)
				end
			end
		end
	end
end)

return MatchService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">ProgressionService</string><ProtectedString name="Source">--!nonstrict
-- 成長・バトルパス・ミッション・ランクのサーバー側
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local ProgressionService = {}
local Profiles, Dirty, S2C
local CurrencyService

function ProgressionService.init(deps)
	Profiles = deps.Profiles
	Dirty = deps.Dirty
	S2C = deps.S2C
	CurrencyService = deps.CurrencyService
end

local function send(player, action, data)
	data=data or {}
	data.action=action
	pcall(function() S2C:FireClient(player,data) end)
end

function ProgressionService.ensure(profile)
	if profile.level == nil then profile.level = 1 end
	if profile.xp == nil then profile.xp = 0 end
	if profile.passXp == nil then profile.passXp = 0 end
	if profile.passTier == nil then profile.passTier = 0 end
	if profile.missions == nil then
		profile.missions = { daily = {}, weekly = {}, lastDailyReset = 0, lastWeeklyReset = 0 }
	end
	if type(profile.missions.daily) ~= "table" then profile.missions.daily = {} end
	if type(profile.missions.weekly) ~= "table" then profile.missions.weekly = {} end
	if profile.achievements == nil then profile.achievements = {} end
	if profile.ownedCosmetics == nil then profile.ownedCosmetics = { titles = {"novice"}, arenas = {"default"}, emotes = {"bow"} } end
	if type(profile.ownedCosmetics.titles) ~= "table" then profile.ownedCosmetics.titles = {"novice"} end
	if type(profile.ownedCosmetics.arenas) ~= "table" then profile.ownedCosmetics.arenas = {"default"} end
	if type(profile.ownedCosmetics.emotes) ~= "table" then profile.ownedCosmetics.emotes = {"bow"} end
	if profile.inventory == nil then profile.inventory = { hint = 2, shield = 1, secondChance = 0, reroll = 1, streakSaver = 0 } end
end

function ProgressionService.xpForNext(level)
	local t = Config.PROGRESSION.XP_TABLE
	return t[level] or 200
end

function ProgressionService.addXp(player, amount, reason)
	local profile = Profiles[player]
	if not profile then return end
	ProgressionService.ensure(profile)
	if CurrencyService then CurrencyService.ensure(profile) end
	-- ブースト中なら2倍
	local mult = 1
	if profile.boosts and profile.boosts.doubleXpUntil and os.time() &lt; profile.boosts.doubleXpUntil then
		mult = 2
	end
	local gain = math.floor(amount * mult + 0.5)
	profile.xp = profile.xp + gain
	profile.passXp = (profile.passXp or 0) + gain

	-- レベルアップ
	while profile.xp &gt;= ProgressionService.xpForNext(profile.level) and profile.level &lt; Config.PROGRESSION.MAX_LEVEL do
		profile.xp = profile.xp - ProgressionService.xpForNext(profile.level)
		profile.level = profile.level + 1
		-- レベルアップ報酬
		local coinReward = 50 + profile.level * 5
		profile.coins = (profile.coins or 0) + coinReward
		send(player, "levelUp", { level = profile.level, rewardCoins = coinReward })
	end

	-- バトルパス進捗
	local newTier = math.floor(profile.passXp / Config.PROGRESSION.PASS_XP_PER_TIER)
	if newTier &gt; (profile.passTier or 0) then
		for tier = (profile.passTier or 0)+1, newTier do
			ProgressionService.grantPassReward(player, tier)
		end
		profile.passTier = newTier
	end

	if Dirty then Dirty[player]=true end
	send(player, "progressionUpdate", {
		level = profile.level, xp = profile.xp, xpNext = ProgressionService.xpForNext(profile.level),
		passXp = profile.passXp, passTier = profile.passTier,
		mult = mult,
	})
end

function ProgressionService.grantPassReward(player, tier)
	local profile = Profiles[player]
	if not profile then return end
	local entry = nil
	for _, r in ipairs(Config.PASS_REWARDS) do if r.tier==tier then entry=r break end end
	if not entry then return end
	-- 無料報酬は全員
	if entry.free then
		if entry.free.coins then profile.coins = (profile.coins or 0) + entry.free.coins end
		if entry.free.gems then profile.gems = (profile.gems or 0) + entry.free.gems end
		if entry.free.shield then profile.inventory = profile.inventory or {}; profile.inventory.shield = (profile.inventory.shield or 0)+(entry.free.shield or 0) end
	end
	-- プレミアムは所有者のみ (バグ修正: emote/skin/title の付与漏れ)
	if profile.premiumPass and entry.premium then
		if entry.premium.gems then profile.gems = (profile.gems or 0) + entry.premium.gems end
		if entry.premium.coins then profile.coins = (profile.coins or 0) + entry.premium.coins end
		profile.ownedCosmetics = profile.ownedCosmetics or { titles={}, arenas={}, emotes={} }
		if type(profile.ownedCosmetics.titles) ~= "table" then profile.ownedCosmetics.titles = {} end
		if type(profile.ownedCosmetics.arenas) ~= "table" then profile.ownedCosmetics.arenas = {} end
		if type(profile.ownedCosmetics.emotes) ~= "table" then profile.ownedCosmetics.emotes = {} end
		if entry.premium.titleEn or entry.premium.titleJa then
			-- 既存タイトルキーにマッピング (Apprentice-&gt;apprentice 等)
			local en = entry.premium.titleEn and string.lower(entry.premium.titleEn) or nil
			local key = en
			-- 既知の対応: なければ tier キーをフォールバック
			if not key or key == "" then key = "tier"..tier end
			-- 重複チェック
			local has = false
			for _,k in ipairs(profile.ownedCosmetics.titles) do if k==key then has=true break end end
			if not has then table.insert(profile.ownedCosmetics.titles, key) end
		end
		if entry.premium.arena then
			local has=false
			for _,k in ipairs(profile.ownedCosmetics.arenas) do if k==entry.premium.arena then has=true break end end
			if not has then table.insert(profile.ownedCosmetics.arenas, entry.premium.arena) end
		end
		if entry.premium.emote then
			local has=false
			for _,k in ipairs(profile.ownedCosmetics.emotes) do if k==entry.premium.emote then has=true break end end
			if not has then table.insert(profile.ownedCosmetics.emotes, entry.premium.emote) end
		end
		if entry.premium.skin then
			-- skin は称号として扱う (gold_kanji など)
			local has=false
			for _,k in ipairs(profile.ownedCosmetics.titles) do if k==entry.premium.skin then has=true break end end
			if not has then table.insert(profile.ownedCosmetics.titles, entry.premium.skin) end
		end
	end
	if Dirty then Dirty[player]=true end
	send(player, "passReward", { tier = tier, free = entry.free, premium = entry.premium, isPremium = profile.premiumPass })
end

-- ミッション進行
function ProgressionService.progressMission(player, key, amount)
	local profile = Profiles[player]
	if not profile then return end
	ProgressionService.ensure(profile)
	amount = amount or 1
	local now = os.time()
	-- 日次リセット (24h)
	if now - (profile.missions.lastDailyReset or 0) &gt; 24*3600 then
		profile.missions.daily = {}
		profile.missions.lastDailyReset = now
		for _, m in ipairs(Config.MISSIONS.DAILY) do profile.missions.daily[m.key]=0 end
	end
	if now - (profile.missions.lastWeeklyReset or 0) &gt; 7*24*3600 then
		profile.missions.weekly = {}
		profile.missions.lastWeeklyReset = now
		for _, m in ipairs(Config.MISSIONS.WEEKLY) do profile.missions.weekly[m.key]=0 end
	end
	-- 初期化
	if not next(profile.missions.daily) then
		for _, m in ipairs(Config.MISSIONS.DAILY) do profile.missions.daily[m.key]=0 end
	end
	if not next(profile.missions.weekly) then
		for _, m in ipairs(Config.MISSIONS.WEEKLY) do profile.missions.weekly[m.key]=0 end
	end
	-- 単純加算: key が daily/weekly にあれば加算
	if profile.missions.daily[key] ~= nil then
		profile.missions.daily[key] = profile.missions.daily[key] + amount
		local def = nil
		for _, d in ipairs(Config.MISSIONS.DAILY) do if d.key==key then def=d break end end
		if def and profile.missions.daily[key] &gt;= def.target and not profile.missions.daily[key.."_claimed"] then
			profile.missions.daily[key.."_claimed"]=true
			profile.coins = (profile.coins or 0) + def.rewardCoins
			ProgressionService.addXp(player, def.rewardXp, "mission")
			send(player, "missionComplete", { scope="daily", key=key, rewardCoins=def.rewardCoins, rewardXp=def.rewardXp })
		end
	end
	if profile.missions.weekly[key] ~= nil then
		profile.missions.weekly[key] = profile.missions.weekly[key] + amount
		local def=nil
		for _, d in ipairs(Config.MISSIONS.WEEKLY) do if d.key==key then def=d break end end
		if def and profile.missions.weekly[key] &gt;= def.target and not profile.missions.weekly[key.."_claimed"] then
			profile.missions.weekly[key.."_claimed"]=true
			profile.coins = (profile.coins or 0) + def.rewardCoins
			ProgressionService.addXp(player, def.rewardXp, "mission")
			send(player, "missionComplete", { scope="weekly", key=key, rewardCoins=def.rewardCoins, rewardXp=def.rewardXp })
		end
	end
	if Dirty then Dirty[player]=true end
	send(player, "missionProgress", { daily = profile.missions.daily, weekly = profile.missions.weekly })
end

function ProgressionService.getMissions(player)
	local profile = Profiles[player]
	if not profile then return nil end
	ProgressionService.ensure(profile)
	return profile.missions
end

return ProgressionService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">QuestionBank</string><ProtectedString name="Source">--!nonstrict
-- 問題バンク: ServerScriptService.KanjiKombat.Data の12レベル分の問題を読み込む
local QuestionBank = {}

local dataFolder = script.Parent.Parent:WaitForChild("Data")

local banks = {}
local order = { "K10", "K09", "K08", "K07", "K06", "K05", "K04", "K03", "KP2", "K02", "KP1", "K01" }

for _, key in ipairs(order) do
	local mod = dataFolder:WaitForChild("Questions_" .. key)
	local ok, result = pcall(require, mod)
	if ok and type(result) == "table" then
		banks[key] = result
	else
		warn("[QuestionBank] failed to load " .. key)
		banks[key] = {}
	end
end

-- levelKey の問題を1問引く (exclude 内のプロンプトは避ける)
function QuestionBank.draw(levelKey, exclude)
	local bank = banks[levelKey]
	if not bank or #bank == 0 then
		return nil
	end
	exclude = exclude or {}
	for _ = 1, 12 do
		local q = bank[math.random(#bank)]
		if not exclude[q.p] then
			exclude[q.p] = true
			return q
		end
	end
	-- 見つからなければ重複を許容
	local q = bank[math.random(#bank)]
	exclude[q.p] = true
	return q
end

-- 選択肢をシャッフルして正解インデックスを返す (1-4)
function QuestionBank.pack(q)
	local choices = { q.a, q.d[1], q.d[2], q.d[3] }
	for i = #choices, 2, -1 do
		local j = math.random(i)
		choices[i], choices[j] = choices[j], choices[i]
	end
	local correct = 1
	for i, c in ipairs(choices) do
		if c == q.a then
			correct = i
			break
		end
	end
	return choices, correct
end

function QuestionBank.count(levelKey)
	return banks[levelKey] and #banks[levelKey] or 0
end

return QuestionBank
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">ShopService</string><ProtectedString name="Source">--!nonstrict
-- Robux 課金 (MarketplaceService) のラッパー
-- Developer Products と GamePass を扱う。エディタ/Studio ではモックで動くように。

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local ShopService = {}
local CurrencyService, StatsService, S2C
local productIdToKey = {}
local gamePassIdToKey = {}

for _, p in ipairs(Config.PRODUCTS.DEV) do productIdToKey[p.id]=p.key end
for _, p in ipairs(Config.PRODUCTS.PASS) do gamePassIdToKey[p.id]=p.key end

function ShopService.init(deps)
	CurrencyService = deps.CurrencyService
	StatsService = deps.StatsService
	S2C = deps.S2C
	-- ProcessReceipt
	local function onReceipt(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
		local key = productIdToKey[receipt.ProductId]
		if not key then return Enum.ProductPurchaseDecision.NotProcessedYet end
		local ok, err = pcall(function()
			if CurrencyService then
				CurrencyService.grantDevProduct(player, key)
			end
			if StatsService and StatsService.markDirty then
				StatsService.markDirty(player)
			end
		end)
		if not ok then warn("[Shop] receipt error "..tostring(err)) end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	pcall(function()
		MarketplaceService.ProcessReceipt = onReceipt
	end)
	-- GamePass 購入後の付与は PromptGamePassPurchaseFinished で (バグ修正: 全パス対応)
	pcall(function()
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, id, wasPurchased)
			if not wasPurchased then return end
			local key = gamePassIdToKey[id]
			if not key then return end
			local profile = StatsService and StatsService.get(plr)
			if not profile then return end
			profile.ownedCosmetics = profile.ownedCosmetics or { titles={}, arenas={}, emotes={} }
			if type(profile.ownedCosmetics.titles) ~= "table" then profile.ownedCosmetics.titles = {} end
			if type(profile.ownedCosmetics.arenas) ~= "table" then profile.ownedCosmetics.arenas = {} end
			if type(profile.ownedCosmetics.emotes) ~= "table" then profile.ownedCosmetics.emotes = {} end
			if key=="vip" then
				profile.vip=true
			elseif key=="arena_pack" then
				for _, a in ipairs({"sakura","night","legend"}) do
					local has=false
					for _,k in ipairs(profile.ownedCosmetics.arenas) do if k==a then has=true break end end
					if not has then table.insert(profile.ownedCosmetics.arenas, a) end
				end
			elseif key=="no_ads" then
				profile.noAds = true
			elseif key=="ultimate_pack" then
				for _, e in ipairs({"kiai","gloat"}) do
					local has=false
					for _,k in ipairs(profile.ownedCosmetics.emotes) do if k==e then has=true break end end
					if not has then table.insert(profile.ownedCosmetics.emotes, e) end
				end
				for _, t in ipairs({"oni","kami"}) do
					local has=false
					for _,k in ipairs(profile.ownedCosmetics.titles) do if k==t then has=true break end end
					if not has then table.insert(profile.ownedCosmetics.titles, t) end
				end
			end
			if StatsService and StatsService.markDirty then StatsService.markDirty(plr) end
			if CurrencyService then CurrencyService.sendUpdate(plr) end
			pcall(function() S2C:FireClient(plr, { action="gamePassGranted", key=key }) end)
		end)
	end)
end

function ShopService.promptDevProduct(player, productKey)
	for _, p in ipairs(Config.PRODUCTS.DEV) do
		if p.key==productKey then
			pcall(function() MarketplaceService:PromptProductPurchase(player, p.id) end)
			return true
		end
	end
	return false
end

function ShopService.promptGamePass(player, passKey)
	for _, p in ipairs(Config.PRODUCTS.PASS) do
		if p.key==passKey then
			pcall(function() MarketplaceService:PromptGamePassPurchase(player, p.id) end)
			return true
		end
	end
	return false
end

-- クライアントからの購入リクエスト (C2S)
function ShopService.onRemote(player, data)
	if data.action=="buyDev" and type(data.key)=="string" then
		ShopService.promptDevProduct(player, data.key)
	elseif data.action=="buyPass" and type(data.key)=="string" then
		ShopService.promptGamePass(player, data.key)
	elseif data.action=="buyWithCoins" and type(data.category)=="string" then
		if CurrencyService then
			local ok = CurrencyService.buyItem(player, data.category, data.key)
			pcall(function() S2C:FireClient(player, { action="shopResult", ok=ok, category=data.category, key=data.key }) end)
		end
	elseif data.action=="equipCosmetic" and type(data.kind)=="string" then
		if CurrencyService then
			local ok = CurrencyService.equip(player, data.kind, data.key)
			pcall(function() S2C:FireClient(player, { action="equipResult", ok=ok, kind=data.kind, key=data.key }) end)
		end
	elseif data.action=="claimDaily" then
		if CurrencyService then
			local res = CurrencyService.claimDaily(player)
			pcall(function() S2C:FireClient(player, { action="dailyResult", result=res }) end)
		end
	end
end

return ShopService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">StatsService</string><ProtectedString name="Source">--!nonstrict
-- プロフィール (DataStore) とレーティング・通貨・成長の統合管理
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))
local I18n = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("I18n"))

local StatsService = {}

local store
pcall(function()
	store = DataStoreService:GetDataStore("KK_Profile_v2")
end)
-- 旧データ移行用
local legacyStore
pcall(function()
	legacyStore = DataStoreService:GetDataStore("KK_Profile_v1")
end)

local profiles = {} -- [player] = profile
local dirty = {}    -- [player] = true

-- 公開: 他サービスから参照できるように
StatsService.profiles = profiles
StatsService.dirty = dirty

local function defaultProfile()
	local ratings = {}
	for _, lv in ipairs(Config.LEVELS) do
		ratings[lv.key] = Config.DEFAULT_RATING
	end
	-- locale = プレイヤーが🌐ボタンで選んだ設定 (保存される)
	-- uiLocale = 今回のセッションの表示言語 (端末ロケールの自動判定 or locale)
	return {
		ratings = ratings, wins = 0, losses = 0, streak = 0, bestStreak = 0,
		locale = nil, uiLocale = nil,
		-- 通貨・成長・バトルパス
		coins = Config.ECONOMY.START_COINS,
		gems = Config.ECONOMY.START_GEMS,
		level = 1, xp = 0,
		passXp = 0, passTier = 0, premiumPass = false,
		inventory = { hint = 2, shield = 1, secondChance = 0, reroll = 1, streakSaver = 0 },
		dailyStreak = 0, lastDailyClaim = 0,
		ownedCosmetics = { titles = {"novice"}, arenas = {"default"}, emotes = {"bow"} },
		equipped = { title = "novice", arena = "default", emote = "bow" },
		vip = false,
		missions = { daily = {}, weekly = {}, lastDailyReset = 0, lastWeeklyReset = 0 },
		achievements = {},
		boosts = {},
		totalCorrect = 0, totalPerfect = 0, maxCombo = 0,
		createdAt = os.time(),
	}
end

local function localeOf(profile)
	local code = (profile and (profile.uiLocale or profile.locale)) or Config.DEFAULT_LOCALE
	return I18n.localeFromId(code)
end

function StatsService.get(player)
	return profiles[player] or defaultProfile()
end

local function keyFor(player)
	return "u_" .. player.UserId
end

local function migrateLegacy(data)
	-- 旧v1データがあれば新フィールドを補完
	if not data then return nil end
	return data
end

function StatsService.load(player)
	local profile = defaultProfile()
	local loaded = false
	if store then
		local ok, data = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok and type(data) == "table" then
			loaded = true
			-- マージ (新フィールドはデフォルトを上書き)
			for k,v in pairs(data) do
				profile[k] = v
			end
			-- ratings の欠損補完
			if type(data.ratings) == "table" then
				for _, lv in ipairs(Config.LEVELS) do
					if type(profile.ratings[lv.key]) ~= "number" then
						profile.ratings[lv.key] = Config.DEFAULT_RATING
					end
				end
			end
			if type(data.locale) == "string" then
				profile.locale = I18n.localeFromId(data.locale)
			end
		elseif legacyStore then
			local ok2, ldata = pcall(function() return legacyStore:GetAsync(keyFor(player)) end)
			if ok2 and type(ldata)=="table" then
				for k,v in pairs(ldata) do profile[k]=v end
				if type(ldata.ratings)=="table" then
					for _,lv in ipairs(Config.LEVELS) do
						if type(profile.ratings[lv.key])~="number" then profile.ratings[lv.key]=Config.DEFAULT_RATING end
					end
				end
			end
		end
	end
	-- 不足フィールドの補完 (旧データ互換)
	if type(profile.inventory) ~= "table" then profile.inventory = { hint = 2, shield = 1, secondChance = 0, reroll = 1, streakSaver = 0 } end
	if profile.inventory.hint == nil then profile.inventory.hint = 2 end
	if profile.inventory.shield == nil then profile.inventory.shield = 1 end
	if profile.inventory.secondChance == nil then profile.inventory.secondChance = 0 end
	if profile.inventory.reroll == nil then profile.inventory.reroll = 1 end
	if profile.inventory.streakSaver == nil then profile.inventory.streakSaver = 0 end
	if type(profile.ownedCosmetics) ~= "table" then profile.ownedCosmetics = { titles = {"novice"}, arenas = {"default"}, emotes = {"bow"} } end
	if type(profile.equipped) ~= "table" then profile.equipped = { title = "novice", arena = "default", emote = "bow" } end
	if profile.coins == nil then profile.coins = Config.ECONOMY.START_COINS end
	if profile.gems == nil then profile.gems = Config.ECONOMY.START_GEMS end
	if profile.level == nil then profile.level = 1 end
	if profile.xp == nil then profile.xp = 0 end
	if profile.boosts == nil then profile.boosts = {} end
	if profile.achievements == nil then profile.achievements = {} end
	if type(profile.missions) ~= "table" then profile.missions = { daily = {}, weekly = {}, lastDailyReset = 0, lastWeeklyReset = 0 } end
	if type(profile.missions.daily) ~= "table" then profile.missions.daily = {} end
	if type(profile.missions.weekly) ~= "table" then profile.missions.weekly = {} end
	-- 初回ミッション初期化
	if not next(profile.missions.daily) then
		for _, m in ipairs(Config.MISSIONS.DAILY) do profile.missions.daily[m.key]=0 end
	end
	if not next(profile.missions.weekly) then
		for _, m in ipairs(Config.MISSIONS.WEEKLY) do profile.missions.weekly[m.key]=0 end
	end
	profiles[player] = profile
	StatsService.setupLeaderstats(player, profile)
	-- 初回ボーナス: DataStoreが空ならプレゼント
	if not loaded then
		StatsService.markDirty(player)
	end
end

-- リーダーボード (勝数 / Wins) — 表示言語に合わせて名前を切り替える + レベルも表示
function StatsService.setupLeaderstats(player, profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end
	local wins = ls:FindFirstChild("勝数") or ls:FindFirstChild("Wins")
	if not wins then
		wins = Instance.new("IntValue")
		wins.Parent = ls
	end
	wins.Name = (localeOf(profile) == "ja") and "勝数" or "Wins"
	wins.Value = profile.wins
	-- レベル表示
	local lvl = ls:FindFirstChild("レベル") or ls:FindFirstChild("Level")
	if not lvl then
		lvl = Instance.new("IntValue")
		lvl.Parent = ls
	end
	lvl.Name = (localeOf(profile)=="ja") and "レベル" or "Level"
	lvl.Value = profile.level or 1
end

-- クライアントから通知された表示言語 (source = "manual" のときだけ保存する)
function StatsService.setLocale(player, code, source)
	local profile = profiles[player]
	if not profile then
		return
	end
	local normalized = I18n.localeFromId(code)
	profile.uiLocale = normalized
	if source == "manual" then
		profile.locale = normalized
		StatsService.markDirty(player)
	end
	StatsService.setupLeaderstats(player, profile)
end

function StatsService.markDirty(player)
	dirty[player] = true
end

local function save(player)
	local profile = profiles[player]
	if not store or not profile then
		return
	end
	pcall(function()
		store:SetAsync(keyFor(player), profile)
	end)
end

function StatsService.savePlayer(player)
	save(player)
	dirty[player] = nil
end

function StatsService.saveAll()
	for p,_ in pairs(profiles) do
		if dirty[p] then save(p) end
	end
end

-- Elo: winner/loser は player インスタンス + 追加報酬を付与
function StatsService.applyResult(levelKey, winner, loser)
	local pw = profiles[winner]
	local pl = profiles[loser]
	if not pw or not pl then
		return 0
	end
	local rw = pw.ratings[levelKey] or Config.DEFAULT_RATING
	local rl = pl.ratings[levelKey] or Config.DEFAULT_RATING
	local ew = 1 / (1 + 10 ^ ((rl - rw) / 400))
	local dw = math.max(5, math.floor(Config.ELO_K * (1 - ew) + 0.5))
	pw.ratings[levelKey] = rw + dw
	pl.ratings[levelKey] = math.max(100, rl - dw)
	pw.wins = pw.wins + 1
	pl.losses = pl.losses + 1
	-- streak は後で勝敗確定時に連携: ここでは一旦記録
	-- ストリークセーバー消費チェックは MatchService 側で
	pw.streak = pw.streak + 1
	-- loserはセーバーがあればストリーク維持
	if pl.inventory and (pl.inventory.streakSaver or 0) &gt; 0 then
		pl.inventory.streakSaver = pl.inventory.streakSaver - 1
		-- ストリークは減らさない (温情)
	else
		pl.streak = 0
	end
	if pw.streak &gt; pw.bestStreak then
		pw.bestStreak = pw.streak
	end
	-- 統計の初期化
	if pw.totalCorrect == nil then pw.totalCorrect = 0 end
	if pl.totalCorrect == nil then pl.totalCorrect = 0 end
	-- leaderstats 更新 (日本語/英語の両名に対応)
	local lsW = winner:FindFirstChild("leaderstats")
	if lsW then
		local winsValue = lsW:FindFirstChild("勝数") or lsW:FindFirstChild("Wins")
		if winsValue then winsValue.Value = pw.wins end
		local lvlW = lsW:FindFirstChild("レベル") or lsW:FindFirstChild("Level")
		if lvlW then lvlW.Value = pw.level or 1 end
	end
	local lsL = loser:FindFirstChild("leaderstats")
	if lsL then
		local lvlL = lsL:FindFirstChild("レベル") or lsL:FindFirstChild("Level")
		if lvlL then lvlL.Value = pl.level or 1 end
		local winsL = lsL:FindFirstChild("勝数") or lsL:FindFirstChild("Wins")
		if winsL then winsL.Value = pl.wins end
	end
	StatsService.markDirty(winner)
	StatsService.markDirty(loser)
	return dw
end

-- 報酬付与ヘルパー
function StatsService.addCoins(player, n)
	local p = profiles[player]
	if not p then return end
	p.coins = (p.coins or 0) + n
	StatsService.markDirty(player)
end

Players.PlayerRemoving:Connect(function(player)
	if dirty[player] then
		save(player)
	end
	profiles[player] = nil
	dirty[player] = nil
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		return
	end
	for player in pairs(profiles) do
		save(player)
	end
end)

return StatsService
