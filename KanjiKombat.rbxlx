	Name = "TitleSplash", Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(12, 10, 16), BackgroundTransparency = 0.02,
	BorderSizePixel = 0, ZIndex = 20,
}, screen)
