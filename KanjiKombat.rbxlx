local shopButton = UiKit.button({
	Size = UDim2.fromOffset(92, 32), Position = UDim2.new(1, -260, 0, 6),
	BackgroundColor3 = Color3.fromRGB(70, 60, 110), TextSize = 13, ZIndex = 9,
