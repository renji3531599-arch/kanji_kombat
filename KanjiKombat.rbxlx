-- ================================================================ state
local current = I18n.DEFAULT

local function normalize(code)
	code = tostring(code or ""):lower()
	if code:sub(1, 2) == "ja" then return "ja" end
	return "en"
end

function I18n.localeFromId(id) return normalize(id) end
function I18n.setLocale(code) current = normalize(code) return current end
function I18n.getLocale() return current end
function I18n.otherLocale(code) local c = normalize(code or current) return (c == "ja") and "en" or "ja" end
function I18n.localeLabel(code) local c = normalize(code) return (c == "ja") and "日本語" or "English" end

function I18n.detectLocale()
	local id = ""
	pcall(function()
		local Players = game:GetService("Players")
		local plr = Players and Players.LocalPlayer
		if plr and plr.LocaleId and plr.LocaleId ~= "" then id = plr.LocaleId
		else id = game:GetService("LocalizationService").RobloxLocaleId or "" end
	end)
	if id == "" then return nil, "" end
	return normalize(id), id
end

function I18n.raw(key, locale)
	local entry = STRINGS[key]
	if not entry then return nil end
	return entry[normalize(locale or current)] or entry[I18n.DEFAULT] or key
end
function I18n.has(key) return STRINGS[key] ~= nil end
function I18n.keys() local out={} for k in pairs(STRINGS) do out[#out+1]=k end return out end
function I18n.t(key, params)
	local s = I18n.raw(key)
	if not s then warn("[I18n] missing key: "..tostring(key)) return tostring(key) end
	if params then s = (s:gsub("{([%w_]+)}", function(k) local v=params[k] return v~=nil and tostring(v) or ("{"..k.."}") end)) end
	return s
end

function I18n.levelTitle(levelKey)
	local lv = Config.levelByKey(levelKey)
	if not lv then return tostring(levelKey) end
	if current == "en" and lv.en and lv.en.label then return lv.en.label end
	return lv.label
end
function I18n.levelDesc(levelKey)
	local lv = Config.levelByKey(levelKey)
	if not lv then return "" end
	local base
	if current == "en" and lv.en and lv.en.desc then base = lv.en.desc else base = lv.desc end
	if current == "en" and lv.jlpt and lv.jlpt ~= "" then return base .. " · " .. lv.jlpt end
	return base
end
function I18n.levelFull(levelKey)
	local t = I18n.levelTitle(levelKey)
	local d = I18n.levelDesc(levelKey)
	if d == "" then return t end
	return t .. " (" .. d .. ")"
end
function I18n.reading(kana, romaji)
	if current == "en" and romaji and romaji ~= "" then return kana .. " / " .. romaji end
	return kana
end

return I18n
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Romaji</string><ProtectedString name="Source">--!nocheck
-- かな → ローマ字 (ヘボン式ベース / 長音は母音を重ねる wāpuro 式)
-- 英語圏プレイヤー向けに読みの選択肢を "きょうしゅう / kyoushuu" のように併記するために使う。
-- utf8 ライブラリに依存しない実装 (LuaJIT / Luau 両対応) — テストは tools/test_luau.py から実行。

local Romaji = {}

local BASE = {
	["あ"] = "a", ["い"] = "i", ["う"] = "u", ["え"] = "e", ["お"] = "o",
	["か"] = "ka", ["き"] = "ki", ["く"] = "ku", ["け"] = "ke", ["こ"] = "ko",
	["が"] = "ga", ["ぎ"] = "gi", ["ぐ"] = "gu", ["げ"] = "ge", ["ご"] = "go",
	["さ"] = "sa", ["し"] = "shi", ["す"] = "su", ["せ"] = "se", ["そ"] = "so",
	["ざ"] = "za", ["じ"] = "ji", ["ず"] = "zu", ["ぜ"] = "ze", ["ぞ"] = "zo",
	["た"] = "ta", ["ち"] = "chi", ["つ"] = "tsu", ["て"] = "te", ["と"] = "to",
	["だ"] = "da", ["ぢ"] = "ji", ["づ"] = "zu", ["で"] = "de", ["ど"] = "do",
	["な"] = "na", ["に"] = "ni", ["ぬ"] = "nu", ["ね"] = "ne", ["の"] = "no",
	["は"] = "ha", ["ひ"] = "hi", ["ふ"] = "fu", ["へ"] = "he", ["ほ"] = "ho",
	["ば"] = "ba", ["び"] = "bi", ["ぶ"] = "bu", ["べ"] = "be", ["ぼ"] = "bo",
	["ぱ"] = "pa", ["ぴ"] = "pi", ["ぷ"] = "pu", ["ぺ"] = "pe", ["ぽ"] = "po",
	["ま"] = "ma", ["み"] = "mi", ["む"] = "mu", ["め"] = "me", ["も"] = "mo",
	["や"] = "ya", ["ゆ"] = "yu", ["よ"] = "yo",
	["ら"] = "ra", ["り"] = "ri", ["る"] = "ru", ["れ"] = "re", ["ろ"] = "ro",
	["わ"] = "wa", ["ゐ"] = "i", ["ゑ"] = "e", ["を"] = "o", ["ん"] = "n",
	["ゔ"] = "vu",
	["ぁ"] = "a", ["ぃ"] = "i", ["ぅ"] = "u", ["ぇ"] = "e", ["ぉ"] = "o",
	["ゃ"] = "ya", ["ゅ"] = "yu", ["ょ"] = "yo", ["ゎ"] = "wa",
	-- カタカナ (データは基本ひらがなだが一応)
	["ア"] = "a", ["イ"] = "i", ["ウ"] = "u", ["エ"] = "e", ["オ"] = "o",
	["カ"] = "ka", ["キ"] = "ki", ["ク"] = "ku", ["ケ"] = "ke", ["コ"] = "ko",
	["サ"] = "sa", ["シ"] = "shi", ["ス"] = "su", ["セ"] = "se", ["ソ"] = "so",
	["タ"] = "ta", ["チ"] = "chi", ["ツ"] = "tsu", ["テ"] = "te", ["ト"] = "to",
	["ナ"] = "na", ["ニ"] = "ni", ["ヌ"] = "nu", ["ネ"] = "ne", ["ノ"] = "no",
	["ハ"] = "ha", ["ヒ"] = "hi", ["フ"] = "fu", ["ヘ"] = "he", ["ホ"] = "ho",
	["マ"] = "ma", ["ミ"] = "mi", ["ム"] = "mu", ["メ"] = "me", ["モ"] = "mo",
	["ヤ"] = "ya", ["ユ"] = "yu", ["ヨ"] = "yo",
	["ラ"] = "ra", ["リ"] = "ri", ["ル"] = "ru", ["レ"] = "re", ["ロ"] = "ro",
	["ワ"] = "wa", ["ヲ"] = "o", ["ン"] = "n",
}

local COMBO = {
	["きゃ"] = "kya", ["きゅ"] = "kyu", ["きょ"] = "kyo",
	["ぎゃ"] = "gya", ["ぎゅ"] = "gyu", ["ぎょ"] = "gyo",
	["しゃ"] = "sha", ["しゅ"] = "shu", ["しょ"] = "sho",
	["じゃ"] = "ja", ["じゅ"] = "ju", ["じょ"] = "jo",
	["ちゃ"] = "cha", ["ちゅ"] = "chu", ["ちょ"] = "cho",
	["ぢゃ"] = "ja", ["ぢゅ"] = "ju", ["ぢょ"] = "jo",
	["にゃ"] = "nya", ["にゅ"] = "nyu", ["にょ"] = "nyo",
	["ひゃ"] = "hya", ["ひゅ"] = "hyu", ["ひょ"] = "hyo",
	["びゃ"] = "bya", ["びゅ"] = "byu", ["びょ"] = "byo",
	["ぴゃ"] = "pya", ["ぴゅ"] = "pyu", ["ぴょ"] = "pyo",
	["みゃ"] = "mya", ["みゅ"] = "myu", ["みょ"] = "myo",
	["りゃ"] = "rya", ["りゅ"] = "ryu", ["りょ"] = "ryo",
	["ふぁ"] = "fa", ["ふぃ"] = "fi", ["ふぇ"] = "fe", ["ふぉ"] = "fo",
	["うぃ"] = "wi", ["うぇ"] = "we", ["うぉ"] = "wo",
	["しぇ"] = "she", ["じぇ"] = "je", ["ちぇ"] = "che",
	["てぃ"] = "ti", ["でぃ"] = "di", ["とぅ"] = "tu", ["どぅ"] = "du",
	["つぁ"] = "tsa", ["つぃ"] = "tsi", ["つぇ"] = "tse", ["つぉ"] = "tso",
	["ゔぁ"] = "va", ["ゔぃ"] = "vi", ["ゔぇ"] = "ve", ["ゔぉ"] = "vo",
}

-- 同じ発音になるかな (じ/ぢ など) の衝突回避用の代替表記
local ALT = { ["ぢ"] = "di", ["づ"] = "du" }
local ALT_COMBO = { ["ぢゃ"] = "dya", ["ぢゅ"] = "dyu", ["ぢょ"] = "dyo" }

local SMALL = {
	["ぁ"] = true, ["ぃ"] = true, ["ぅ"] = true, ["ぇ"] = true, ["ぉ"] = true,
	["ゃ"] = true, ["ゅ"] = true, ["ょ"] = true, ["ゎ"] = true,
}
local VOWELS = { a = true, i = true, u = true, e = true, o = true }
local N_APOSTROPHE = {
	["あ"] = true, ["い"] = true, ["う"] = true, ["え"] = true, ["お"] = true,
	["や"] = true, ["ゆ"] = true, ["よ"] = true,
	["ぁ"] = true, ["ぃ"] = true, ["ぅ"] = true, ["ぇ"] = true, ["ぉ"] = true,
	["ゃ"] = true, ["ゅ"] = true, ["ょ"] = true,
}

-- UTF-8 文字列を1文字ずつのテーブルに分解 (utf8 ライブラリ非依存)
local function chars(s)
	local out, i, n = {}, 1, #s
	while i &lt;= n do
		local b = string.byte(s, i)
		local len = 1
		if b &gt;= 0xF0 then
			len = 4
		elseif b &gt;= 0xE0 then
			len = 3
		elseif b &gt;= 0xC0 then
			len = 2
		end
		out[#out + 1] = string.sub(s, i, i + len - 1)
		i = i + len
	end
	return out
end

-- i 番目 (1始まり) の音節を返す: romaji, 消費した文字数
local function syllable(cs, i, alt)
	local two = cs[i + 1] and (cs[i] .. cs[i + 1]) or nil
	if two then
		local c = (alt and ALT_COMBO[two]) or COMBO[two]
		if c then
			return c, 2
		end
	end
	local ch = cs[i]
	if ch == "ん" then
		local nxt = cs[i + 1]
		if nxt and N_APOSTROPHE[nxt] then
			return "n'", 1
		end
		return "n", 1
	end
	if alt and ALT[ch] then
		return ALT[ch], 1
	end
	return BASE[ch] or ch, 1
end

-- かな文字列 → ローマ字
function Romaji.convert(kana, alt)
	if type(kana) ~= "string" or kana == "" then
		return kana or ""
	end
	local cs = chars(kana)
	local out = {}
	local i, n = 1, #cs
	while i &lt;= n do
		local c = cs[i]
		if c == "っ" or c == "ッ" then
			local nxt = cs[i + 1]
			if nxt and not SMALL[nxt] and nxt ~= "ー" and nxt ~= "っ" and nxt ~= "ッ" then
				local r = syllable(cs, i + 1, alt)
				if r and r ~= "" then
					if string.sub(r, 1, 2) == "ch" then
						out[#out + 1] = "t" -- 抹茶 = matcha
					else
						local k = string.sub(r, 1, 1)
						if not VOWELS[k] then
							if k == "n" and alt then
								-- なんにゅう (nannyuu) と なっにゅう (nannyuu) の区別
								out[#out + 1] = "n'"
							else
								out[#out + 1] = k -- じゅっもく = jummoku (促音の重ね)
							end
						end
					end
				end
			end
			i = i + 1
		elseif c == "ー" then
			local prev = table.concat(out)
			local v = ""
			for j = #prev, 1, -1 do
				local ch = string.sub(prev, j, j)
				if VOWELS[ch] then
					v = ch
					break
				end
			end
			out[#out + 1] = v -- らーめん = raamen
			i = i + 1
		else
			local r, used = syllable(cs, i, alt)
			out[#out + 1] = r
			i = i + used
		end
	end
	return table.concat(out)
end

-- 選択肢4つのように「並べたときに重複しない」ローマ字を返す (例: じ / ぢ → ji / di)
function Romaji.convertMany(list)
	local out, used = {}, {}
	for i = 1, #list do
		local r = Romaji.convert(list[i])
		if used[r] then
			-- 1) 先に出た同表記のものを代替表記へ移せないか (なっにゅう = nan'nyuu)
			for j = 1, i - 1 do
				if out[j] == r then
					local alt = Romaji.convert(list[j], true)
					if alt ~= r and not used[alt] then
						out[j] = alt
						used[alt] = true
						used[r] = nil
						break
					end
				end
			end
		end
		if used[r] then
			-- 2) 自分を代替表記にする (ぢ = di / づ = du)
			local alt = Romaji.convert(list[i], true)
			if alt ~= r and not used[alt] then
				r = alt
			end
		end
		out[i] = r
		used[r] = true
	end
	return out
end

return Romaji
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX26"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX25"><Properties><string name="Name">KanjiKombat</string><ProtectedString name="Source">--!nonstrict
-- 漢字コンバット サーバーエントリポイント — 超拡張版
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ------------------------------------------------- remotes
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage

local S2C = Instance.new("RemoteEvent")
S2C.Name = "ServerToClient"
S2C.Parent = remotes

local C2S = Instance.new("RemoteEvent")
C2S.Name = "ClientToServer"
C2S.Parent = remotes

local RF = Instance.new("RemoteFunction")
RF.Name = "GetProfile"
RF.Parent = remotes

-- ------------------------------------------------- modules
local Modules = script:WaitForChild("Modules")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))
local QuestionBank = require(Modules:WaitForChild("QuestionBank"))
local StatsService = require(Modules:WaitForChild("StatsService"))
local ArenaService = require(Modules:WaitForChild("ArenaService"))
local LobbyService = require(Modules:WaitForChild("LobbyService"))
local CurrencyService = require(Modules:WaitForChild("CurrencyService"))
local ProgressionService = require(Modules:WaitForChild("ProgressionService"))
local ShopService = require(Modules:WaitForChild("ShopService"))
local MatchService = require(Modules:WaitForChild("MatchService"))

math.randomseed(os.time() + os.clock() * 1000)

-- ------------------------------------------------- world
local world = Instance.new("Folder")
world.Name = "KanjiKombatWorld"
world.Parent = workspace

LobbyService.build(world)
ArenaService.build(world)

-- 通貨・成長の注入
CurrencyService.inject({ Profiles = StatsService.profiles, Dirty = StatsService.dirty, S2C = S2C })
ProgressionService.init({ Profiles = StatsService.profiles, Dirty = StatsService.dirty, S2C = S2C, CurrencyService = CurrencyService })
ShopService.init({ CurrencyService = CurrencyService, StatsService = StatsService, S2C = S2C })

MatchService.init({
	QuestionBank = QuestionBank,
	StatsService = StatsService,
	ArenaService = ArenaService,
	LobbyService = LobbyService,
	CurrencyService = CurrencyService,
	ProgressionService = ProgressionService,
	S2C = S2C,
	C2S = C2S,
})

-- クライアントからの操作を受け取る (統合ルーター)
C2S.OnServerEvent:Connect(function(player, data)
	-- Shop系は先に
	local ok, err = pcall(function()
		if type(data)=="table" and type(data.action)=="string" then
			if data.action=="buyDev" or data.action=="buyPass" or data.action=="buyWithCoins" or data.action=="equipCosmetic" or data.action=="claimDaily" then
				ShopService.onRemote(player, data)
				return
			end
		end
		MatchService.onRemote(player, data)
	end)
	if not ok then warn("[KanjiKombat] onRemote: "..tostring(err)) end
end)

-- ------------------------------------------------- profile plumbing
local function sanitizeProfile(profile)
	local ratings = {}
	for k, v in pairs(profile.ratings) do ratings[k]=v end
	return {
		ratings = ratings,
		wins = profile.wins, losses = profile.losses, streak = profile.streak, bestStreak = profile.bestStreak,
		locale = profile.locale,
		coins = profile.coins, gems = profile.gems,
		level = profile.level, xp = profile.xp,
		passXp = profile.passXp, passTier = profile.passTier, premiumPass = profile.premiumPass,
		inventory = profile.inventory,
		ownedCosmetics = profile.ownedCosmetics, equipped = profile.equipped,
		vip = profile.vip,
		missions = profile.missions,
		dailyStreak = profile.dailyStreak, lastDailyClaim = profile.lastDailyClaim,
		totalCorrect = profile.totalCorrect, totalPerfect = profile.totalPerfect, maxCombo = profile.maxCombo,
	}
end

RF.OnServerInvoke = function(player)
	local p = StatsService.get(player)
	-- 補完
	if CurrencyService then CurrencyService.ensure(p) end
	if ProgressionService then ProgressionService.ensure(p) end
	return sanitizeProfile(p)
end

Players.PlayerAdded:Connect(function(player)
	StatsService.load(player)
	-- 初回通貨同期
	task.delay(0.5, function()
		local prof = StatsService.get(player)
		if CurrencyService then CurrencyService.ensure(prof); CurrencyService.sendUpdate(player) end
		-- デイリーリマインダー
		task.wait(1)
		pcall(function() S2C:FireClient(player, { action="missionProgress", daily = prof.missions.daily, weekly = prof.missions.weekly }) end)
	end)
end)

for _, player in ipairs(Players:GetPlayers()) do task.spawn(StatsService.load, player) end

-- ------------------------------------------------- loops
task.spawn(function()
	while true do
		local ok, err = pcall(MatchService.tick)
		if not ok then warn("[MatchService] "..tostring(err)) end
		task.wait(1)
	end
end)

-- VIP デイリーボーナス (1時間ごとにチェック)
task.spawn(function()
	while true do
		task.wait(3600)
		for _, p in ipairs(Players:GetPlayers()) do
			local prof = StatsService.get(p)
			if prof and prof.vip then
				-- 何もしない (報酬はclaimで)
			end
		end
	end
end)

print("[KanjiKombat] server ready / 起動完了 — v2 豪華版")
print(string.format("[KanjiKombat] levels=%d, K10=%d, K01=%d questions | economy &amp; battlepass loaded",
	#Config.LEVELS, QuestionBank.count("K10"), QuestionBank.count("K01")))
</ProtectedString></Properties><Item class="Folder" referent="RBX11"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">QuestionBank</string><ProtectedString name="Source">--!nonstrict
-- 問題バンク: ServerScriptService.KanjiKombat.Data の12レベル分の問題を読み込む
local QuestionBank = {}

local dataFolder = script.Parent.Parent:WaitForChild("Data")

local banks = {}
local order = { "K10", "K09", "K08", "K07", "K06", "K05", "K04", "K03", "KP2", "K02", "KP1", "K01" }

for _, key in ipairs(order) do
	local mod = dataFolder:WaitForChild("Questions_" .. key)
	local ok, result = pcall(require, mod)
	if ok and type(result) == "table" then
		banks[key] = result
	else
		warn("[QuestionBank] failed to load " .. key)
		banks[key] = {}
	end
end

-- levelKey の問題を1問引く (exclude 内のプロンプトは避ける)
function QuestionBank.draw(levelKey, exclude)
	local bank = banks[levelKey]
	if not bank or #bank == 0 then
		return nil
	end
	exclude = exclude or {}
	for _ = 1, 12 do
		local q = bank[math.random(#bank)]
		if not exclude[q.p] then
			exclude[q.p] = true
			return q
		end
	end
	-- 見つからなければ重複を許容
	local q = bank[math.random(#bank)]
	exclude[q.p] = true
	return q
end

-- 選択肢をシャッフルして正解インデックスを返す (1-4)
function QuestionBank.pack(q)
	local choices = { q.a, q.d[1], q.d[2], q.d[3] }
	for i = #choices, 2, -1 do
		local j = math.random(i)
		choices[i], choices[j] = choices[j], choices[i]
	end
	local correct = 1
	for i, c in ipairs(choices) do
		if c == q.a then
			correct = i
			break
		end
	end
	return choices, correct
end

function QuestionBank.count(levelKey)
	return banks[levelKey] and #banks[levelKey] or 0
end

return QuestionBank
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">StatsService</string><ProtectedString name="Source">--!nonstrict
-- プロフィール (DataStore) とレーティング・通貨・成長の統合管理
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))
local I18n = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("I18n"))

local StatsService = {}

local store
pcall(function()
	store = DataStoreService:GetDataStore("KK_Profile_v2")
end)
-- 旧データ移行用
local legacyStore
pcall(function()
	legacyStore = DataStoreService:GetDataStore("KK_Profile_v1")
end)

local profiles = {} -- [player] = profile
local dirty = {}    -- [player] = true

-- 公開: 他サービスから参照できるように
StatsService.profiles = profiles
StatsService.dirty = dirty

local function defaultProfile()
	local ratings = {}
	for _, lv in ipairs(Config.LEVELS) do
		ratings[lv.key] = Config.DEFAULT_RATING
	end
	-- locale = プレイヤーが🌐ボタンで選んだ設定 (保存される)
	-- uiLocale = 今回のセッションの表示言語 (端末ロケールの自動判定 or locale)
	return {
		ratings = ratings, wins = 0, losses = 0, streak = 0, bestStreak = 0,
		locale = nil, uiLocale = nil,
		-- 通貨・成長・バトルパス
		coins = Config.ECONOMY.START_COINS,
		gems = Config.ECONOMY.START_GEMS,
		level = 1, xp = 0,
		passXp = 0, passTier = 0, premiumPass = false,
		inventory = { hint = 2, shield = 1, secondChance = 0, reroll = 1, streakSaver = 0 },
		dailyStreak = 0, lastDailyClaim = 0,
		ownedCosmetics = { titles = {"novice"}, arenas = {"default"}, emotes = {"bow"} },
		equipped = { title = "novice", arena = "default", emote = "bow" },
		vip = false,
		missions = { daily = {}, weekly = {}, lastDailyReset = 0, lastWeeklyReset = 0 },
		achievements = {},
		boosts = {},
		totalCorrect = 0, totalPerfect = 0, maxCombo = 0,
		createdAt = os.time(),
	}
end

local function localeOf(profile)
	local code = (profile and (profile.uiLocale or profile.locale)) or Config.DEFAULT_LOCALE
	return I18n.localeFromId(code)
end

function StatsService.get(player)
	return profiles[player] or defaultProfile()
end

local function keyFor(player)
	return "u_" .. player.UserId
end

local function migrateLegacy(data)
	-- 旧v1データがあれば新フィールドを補完
	if not data then return nil end
	return data
end

function StatsService.load(player)
	local profile = defaultProfile()
	local loaded = false
	if store then
		local ok, data = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok and type(data) == "table" then
			loaded = true
			-- マージ (新フィールドはデフォルトを上書き)
			for k,v in pairs(data) do
				profile[k] = v
			end
			-- ratings の欠損補完
			if type(data.ratings) == "table" then
				for _, lv in ipairs(Config.LEVELS) do
					if type(profile.ratings[lv.key]) ~= "number" then
						profile.ratings[lv.key] = Config.DEFAULT_RATING
					end
				end
			end
			if type(data.locale) == "string" then
				profile.locale = I18n.localeFromId(data.locale)
			end
		elseif legacyStore then
			local ok2, ldata = pcall(function() return legacyStore:GetAsync(keyFor(player)) end)
			if ok2 and type(ldata)=="table" then
				for k,v in pairs(ldata) do profile[k]=v end
				if type(ldata.ratings)=="table" then
					for _,lv in ipairs(Config.LEVELS) do
						if type(profile.ratings[lv.key])~="number" then profile.ratings[lv.key]=Config.DEFAULT_RATING end
					end
				end
			end
		end
	end
	-- 初回ミッション初期化
	if not next(profile.missions.daily) then
		for _, m in ipairs(Config.MISSIONS.DAILY) do profile.missions.daily[m.key]=0 end
	end
	if not next(profile.missions.weekly) then
		for _, m in ipairs(Config.MISSIONS.WEEKLY) do profile.missions.weekly[m.key]=0 end
	end
	profiles[player] = profile
	StatsService.setupLeaderstats(player, profile)
	-- 初回ボーナス: DataStoreが空ならプレゼント
	if not loaded then
		StatsService.markDirty(player)
	end
end

-- リーダーボード (勝数 / Wins) — 表示言語に合わせて名前を切り替える + レベルも表示
function StatsService.setupLeaderstats(player, profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end
	local wins = ls:FindFirstChild("勝数") or ls:FindFirstChild("Wins")
	if not wins then
		wins = Instance.new("IntValue")
		wins.Parent = ls
	end
	wins.Name = (localeOf(profile) == "ja") and "勝数" or "Wins"
	wins.Value = profile.wins
	-- レベル表示
	local lvl = ls:FindFirstChild("レベル") or ls:FindFirstChild("Level")
	if not lvl then
		lvl = Instance.new("IntValue")
		lvl.Parent = ls
	end
	lvl.Name = (localeOf(profile)=="ja") and "レベル" or "Level"
	lvl.Value = profile.level or 1
end

-- クライアントから通知された表示言語 (source = "manual" のときだけ保存する)
function StatsService.setLocale(player, code, source)
	local profile = profiles[player]
	if not profile then
		return
	end
	local normalized = I18n.localeFromId(code)
	profile.uiLocale = normalized
	if source == "manual" then
		profile.locale = normalized
		StatsService.markDirty(player)
	end
	StatsService.setupLeaderstats(player, profile)
end

function StatsService.markDirty(player)
	dirty[player] = true
end

local function save(player)
	local profile = profiles[player]
	if not store or not profile then
		return
	end
	pcall(function()
		store:SetAsync(keyFor(player), profile)
	end)
end

function StatsService.savePlayer(player)
	save(player)
	dirty[player] = nil
end

function StatsService.saveAll()
	for p,_ in pairs(profiles) do
		if dirty[p] then save(p) end
	end
end

-- Elo: winner/loser は player インスタンス + 追加報酬を付与
function StatsService.applyResult(levelKey, winner, loser)
	local pw = profiles[winner]
	local pl = profiles[loser]
	if not pw or not pl then
		return 0
	end
	local rw = pw.ratings[levelKey] or Config.DEFAULT_RATING
	local rl = pl.ratings[levelKey] or Config.DEFAULT_RATING
	local ew = 1 / (1 + 10 ^ ((rl - rw) / 400))
	local dw = math.max(5, math.floor(Config.ELO_K * (1 - ew) + 0.5))
	pw.ratings[levelKey] = rw + dw
	pl.ratings[levelKey] = math.max(100, rl - dw)
	pw.wins = pw.wins + 1
	pl.losses = pl.losses + 1
	-- streak は後で勝敗確定時に連携: ここでは一旦記録
	-- ストリークセーバー消費チェックは MatchService 側で
	pw.streak = pw.streak + 1
	-- loserはセーバーがあればストリーク維持
	if pl.inventory and (pl.inventory.streakSaver or 0) &gt; 0 then
		pl.inventory.streakSaver = pl.inventory.streakSaver - 1
		-- ストリークは減らさない (温情)
	else
		pl.streak = 0
	end
	if pw.streak &gt; pw.bestStreak then
		pw.bestStreak = pw.streak
	end
	-- 統計
	pw.totalCorrect = (pw.totalCorrect or 0)
	local ls = winner:FindFirstChild("leaderstats")
	local winsValue = ls and (ls:FindFirstChild("勝数") or ls:FindFirstChild("Wins"))
	if winsValue then
		winsValue.Value = pw.wins
	end
	local lvlW = winner:FindFirstChild("leaderstats") and winner.leaderstats:FindFirstChild("Level") or winner.leaderstats and winner.leaderstats:FindFirstChild("レベル")
	if lvlW then lvlW.Value = pw.level end
	local lvlL = loser:FindFirstChild("leaderstats") and loser.leaderstats:FindFirstChild("Level") or loser.leaderstats and loser.leaderstats:FindFirstChild("レベル")
	if lvlL then lvlL.Value = pl.level end
	StatsService.markDirty(winner)
	StatsService.markDirty(loser)
	return dw
end

-- 報酬付与ヘルパー
function StatsService.addCoins(player, n)
	local p = profiles[player]
	if not p then return end
	p.coins = (p.coins or 0) + n
	StatsService.markDirty(player)
end

Players.PlayerRemoving:Connect(function(player)
	if dirty[player] then
		save(player)
	end
	profiles[player] = nil
	dirty[player] = nil
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		return
	end
	for player in pairs(profiles) do
		save(player)
	end
end)

return StatsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source">--!nonstrict
-- 対戦アリーナ生成: 究極豪華版 — 級ごとに全く異なる世界観 (神社 / 竹林 / 城 / 宇宙 など)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local ArenaService = {}
local arenas = {}

local ARENA_BASE_Y = 620
local ARENA_GAP = 300

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do p[k]=v end
	return p
end

local function addLight(parent, color, range, bright)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = bright
	l.Shadows = true
	l.Parent = parent
	return l
end

local THEMES = {
	K10 = { mat=Enum.Material.SmoothPlastic, floor=Color3.fromRGB(85,165,90), accent=Color3.fromRGB(110,205,120), name="わかばの庭 / Sprout Garden", deco="sprout" },
	K09 = { mat=Enum.Material.SmoothPlastic, floor=Color3.fromRGB(95,155,75), accent=Color3.fromRGB(125,190,85), name="さくらの小径", deco="sakura" },
	K08 = { mat=Enum.Material.Slate, floor=Color3.fromRGB(115,135,60), accent=Color3.fromRGB(165,180,65), name="たけの里", deco="bamboo" },
	K07 = { mat=Enum.Material.Slate, floor=Color3.fromRGB(132,118,42), accent=Color3.fromRGB(200,165,45), name="まつりの広場", deco="festival" },
	K06 = { mat=Enum.Material.Concrete, floor=Color3.fromRGB(150,98,34), accent=Color3.fromRGB(225,135,38), name="あきの山道", deco="autumn" },
	K05 = { mat=Enum.Material.Concrete, floor=Color3.fromRGB(170,72,28), accent=Color3.fromRGB(240,105,35), name="ゆうやけの浜", deco="sunset" },
	K04 = { mat=Enum.Material.Marble, floor=Color3.fromRGB(182,52,38), accent=Color3.fromRGB(250,72,50), name="せんじょうの城", deco="castle" },
	K03 = { mat=Enum.Material.Marble, floor=Color3.fromRGB(172,42,62), accent=Color3.fromRGB(245,55,82), name="べにの神殿", deco="shrine" },
	KP2 = { mat=Enum.Material.Metal, floor=Color3.fromRGB(162,38,110), accent=Color3.fromRGB(230,50,145), name="あやかしの森", deco="mystic" },
	K02 = { mat=Enum.Material.Metal, floor=Color3.fromRGB(142,38,152), accent=Color3.fromRGB(200,50,210), name="ほしの天守", deco="star" },
	KP1 = { mat=Enum.Material.Neon, floor=Color3.fromRGB(92,42,188), accent=Color3.fromRGB(145,60,230), name="らいめいの間", deco="thunder" },
	K01 = { mat=Enum.Material.Neon, floor=Color3.fromRGB(45,42,182), accent=Color3.fromRGB(72,64,235), name="てんくうの祭壇 / Celestial Altar", deco="celestial" },
}

function ArenaService.build(folder)
	for i, lv in ipairs(Config.LEVELS) do
		local y = ARENA_BASE_Y + (i - 1) * ARENA_GAP
		local f = Instance.new("Folder")
		f.Name = "Arena_" .. lv.key
		f.Parent = folder

		local th = THEMES[lv.key] or THEMES.K10
		local color = Config.color3(lv)

		-- ── 床 (テーマ別) ─────────────────────────────────
		local floor = part({ Name="Floor", Size=Vector3.new(42,2.2,78), Position=Vector3.new(0,y,0), Color=th.floor, Material=th.mat, Parent=f })
		-- 畳/石/金属の質感を演出: 中央に紋
		part({ Name="FloorEmblemOuter", Size=Vector3.new(14,0.35,14), Position=Vector3.new(0,y+1.15,0), Color=Color3.fromRGB(255,255,255), Transparency=0.82, Parent=f })
		part({ Name="FloorEmblem", Size=Vector3.new(9,0.4,9), Position=Vector3.new(0,y+1.18,0), Color=color, Material=Enum.Material.Neon, Parent=f })
		part({ Name="FloorKanjiCore", Size=Vector3.new(4,0.45,4), Position=Vector3.new(0,y+1.22,0), Color=Color3.fromRGB(18,16,22), Parent=f })
		do
			local k = part({ Name="FloorKanjiLabel", Size=Vector3.new(4,0.2,0.2), Position=Vector3.new(0,y+1.45,0.05), Color=Color3.fromRGB(18,16,22), Parent=f })
			local sg = Instance.new("SurfaceGui")
			sg.Face = Enum.NormalId.Top
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 20
			sg.Parent = k
			local tl = Instance.new("TextLabel")
			tl.Size = UDim2.fromScale(1,1)
			tl.BackgroundTransparency=1
			tl.Font=Enum.Font.GothamBlack
			tl.TextScaled=true
			tl.TextColor3=color
			tl.Text="漢"
			tl.Parent=sg
		end
		-- 格子ライン
		for _, z in ipairs({-24,-12,0,12,24}) do
			part({ Name="Grid", Size=Vector3.new(42,0.22,0.35), Position=Vector3.new(0,y+1.12,z), Color=color, Material=Enum.Material.Neon, Transparency=0.14, Parent=f })
		end
		for _, x in ipairs({-14,0,14}) do
			part({ Name="GridV", Size=Vector3.new(0.35,0.22,78), Position=Vector3.new(x,y+1.12,0), Color=Color3.fromRGB(255,255,255), Transparency=0.78, Parent=f })
		end
		-- センターライン
		part({ Name="CenterLine", Size=Vector3.new(42,0.55,1.4), Position=Vector3.new(0,y+1.3,0), Color=color, Material=Enum.Material.Neon, Parent=f })
		-- 外縁ネオン
		part({ Name="TrimA", Size=Vector3.new(42,0.9,1.6), Position=Vector3.new(0,y+1.35,-38), Color=color, Material=Enum.Material.Neon, Parent=f })
		part({ Name="TrimB", Size=Vector3.new(42,0.9,1.6), Position=Vector3.new(0,y+1.35,38), Color=color, Material=Enum.Material.Neon, Parent=f })
		part({ Name="TrimL", Size=Vector3.new(1.6,0.9,78), Position=Vector3.new(-20.2,y+1.35,0), Color=color, Material=Enum.Material.Neon, Parent=f })
		part({ Name="TrimR", Size=Vector3.new(1.6,0.9,78), Position=Vector3.new(20.2,y+1.35,0), Color=color, Material=Enum.Material.Neon, Parent=f })

		-- ── 四隅の柱 + テーマ装飾 ────────────────────────
		local pillarH = (i&gt;=9) and 20 or (i&gt;=6) and 15 or 12
		for _, sx in ipairs({-19,19}) do for _, sz in ipairs({-36,36}) do
			part({ Name="Pillar", Size=Vector3.new(1.6,pillarH,1.6), Position=Vector3.new(sx, y+pillarH/2, sz), Color=Color3.fromRGB(30,28,38), Material=Enum.Material.Slate, Parent=f })
			-- 柱頭の炎/水晶/提灯
			if th.deco=="celestial" or th.deco=="thunder" then
				local crystal = part({ Name="Crystal", Size=Vector3.new(2,3.2,2), Position=Vector3.new(sx, y+pillarH+1.6, sz), Color=color, Material=Enum.Material.Neon, Parent=f })
				addLight(crystal, color, 20, 2.2)
			elseif th.deco=="sakura" or th.deco=="sprout" then
				local bloom = part({ Name="Bloom", Size=Vector3.new(2.6,2,2.6), Position=Vector3.new(sx, y+pillarH+1, sz), Color=Color3.fromRGB(255,175,190), Material=Enum.Material.Neon, Transparency=0.2, Parent=f })
				addLight(bloom, Color3.fromRGB(255,180,200), 14, 1.2)
			elseif th.deco=="bamboo" then
				part({ Name="BambooTop", Size=Vector3.new(0.7,4,0.7), Position=Vector3.new(sx, y+pillarH+2, sz), Color=Color3.fromRGB(90,165,70), Material=Enum.Material.Wood, Parent=f })
			else
				local flame = part({ Name="Flame", Size=Vector3.new(1.8,1.8,1.8), Position=Vector3.new(sx, y+pillarH+1, sz), Color=color, Material=Enum.Material.Neon, Parent=f })
				addLight(flame, color, 18, 2)
			end
		end end

		-- テーマ別デコレーション
		if th.deco=="bamboo" then
			for bx=1,6 do
				local x = -16 + bx*5.2
				part({ Name="Bamboo"..bx, Size=Vector3.new(0.5,9,0.5), Position=Vector3.new(x, y+4.6, -39.5), Color=Color3.fromRGB(95,170,75), Material=Enum.Material.Wood, Parent=f })
				part({ Name="BambooLeaf"..bx, Size=Vector3.new(1.4,0.4,1.4), Position=Vector3.new(x, y+9.2, -39.5), Color=Color3.fromRGB(110,195,85), Material=Enum.Material.Leaf, Parent=f })
			end
		elseif th.deco=="sakura" then
			for sx=1,4 do
				local x = -12 + sx*8
				part({ Name="SakuraTree"..sx, Size=Vector3.new(0.9,7,0.9), Position=Vector3.new(x, y+3.5, -39), Color=Color3.fromRGB(74,56,48), Material=Enum.Material.Wood, Parent=f })
				part({ Name="SakuraCrown"..sx, Size=Vector3.new(4.5,3,4.5), Position=Vector3.new(x, y+8, -39), Color=Color3.fromRGB(255,175,190), Material=Enum.Material.Leaf, Parent=f })
			end
		elseif th.deco=="castle" then
			part({ Name="CastleWall", Size=Vector3.new(42,8,1.2), Position=Vector3.new(0, y+5, -39.5), Color=Color3.fromRGB(68,64,58), Material=Enum.Material.Slate, Parent=f })
			for cx=1,3 do
				local x = (cx-2)*10
				part({ Name="CastleTurret"..cx, Size=Vector3.new(3,10,3), Position=Vector3.new(x, y+6, -39.5), Color=Color3.fromRGB(72,68,62), Material=Enum.Material.Slate, Parent=f })
				part({ Name="CastleRoof"..cx, Size=Vector3.new(4.2,1.2,4.2), Position=Vector3.new(x, y+11.6, -39.5), Color=Color3.fromRGB(188,30,42), Material=Enum.Material.Wood, Parent=f })
			end
		elseif th.deco=="celestial" then
			-- 浮遊する鳥居と星
			part({ Name="CelestialRing", Size=Vector3.new(18,0.6,18), Position=Vector3.new(0, y+18, 0), Color=color, Material=Enum.Material.Neon, Transparency=0.2, Parent=f })
			for s=1,8 do
				local ang = (s/8)*math.pi*2
				local rx = math.cos(ang)*14
				local rz = math.sin(ang)*14
				local star = part({ Name="Star"..s, Size=Vector3.new(0.8,0.8,0.8), Position=Vector3.new(rx, y+16, rz), Color=Color3.fromRGB(255,240,180), Material=Enum.Material.Neon, Parent=f })
				addLight(star, Color3.fromRGB(255,240,150), 12, 1.5)
			end
		elseif th.deco=="thunder" then
			part({ Name="ThunderCloud", Size=Vector3.new(30,4,12), Position=Vector3.new(0, y+20, 0), Color=Color3.fromRGB(42,38,62), Material=Enum.Material.Slate, Transparency=0.35, Parent=f })
			for b=1,3 do
				part({ Name="Lightning"..b, Size=Vector3.new(0.35,8,0.35), Position=Vector3.new(-8+b*8, y+15, 0), Color=Color3.fromRGB(180,160,255), Material=Enum.Material.Neon, Parent=f })
			end
		elseif th.deco=="festival" then
			for fx=1,5 do
				local x = -16 + fx*8
				local lan = part({ Name="FestLantern"..fx, Size=Vector3.new(1.4,1.8,1.4), Position=Vector3.new(x, y+9, -39), Color=Color3.fromRGB(255,130,90), Material=Enum.Material.Neon, Parent=f })
				addLight(lan, Color3.fromRGB(255,140,90), 12, 1.2)
				part({ Name="FestRope"..fx, Size=Vector3.new(8,0.12,0.12), Position=Vector3.new(x+4, y+10.2, -39), Color=Color3.fromRGB(90,70,60), Parent=f })
			end
		end

		-- ── 観客席 (両サイド) ───────────────────────────────
		for _, sx in ipairs({-1,1}) do
			local xBase = sx*26
			for row=1,3 do
				local zLen = 60 - row*6
				local yOff = y + 3 + row*2.4
				local xOff = xBase + sx*row*1.4
				part({ Name="Stand"..sx.."_"..row, Size=Vector3.new(5,1.2,zLen), Position=Vector3.new(xOff, yOff, 0), Color=Color3.fromRGB(42,40,52), Material=Enum.Material.Concrete, Parent=f })
				-- 席
				part({ Name="StandSeat"..sx.."_"..row, Size=Vector3.new(1.2,0.6,zLen-2), Position=Vector3.new(xOff, yOff+0.9, 0), Color=Color3.fromRGB(62,58,72), Parent=f })
			end
			-- 観客の提灯
			for r=1,3 do
				local lamp = part({ Name="StandLamp"..sx.."_"..r, Size=Vector3.new(1,1,1), Position=Vector3.new(xBase+sx*2, y+10, -20+r*20), Color=Color3.fromRGB(255,210,90), Material=Enum.Material.Neon, Parent=f })
				addLight(lamp, Color3.fromRGB(255,210,90), 10, 1)
			end
		end

		-- ── スコアボード (天井吊り) ───────────────────────
		local board = part({ Name="Board", Size=Vector3.new(16,5,0.8), Position=Vector3.new(0,y+18,0), Color=Color3.fromRGB(16,14,22), Material=Enum.Material.SmoothPlastic, Parent=f })
		do
			local sg = Instance.new("SurfaceGui")
			sg.Face = Enum.NormalId.Front
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 22
			sg.Parent = board
			local tl = Instance.new("TextLabel")
			tl.Size = UDim2.fromScale(1,0.5)
			tl.BackgroundTransparency=1
			tl.Font=Enum.Font.GothamBlack
			tl.TextScaled=true
			tl.TextColor3=color
			tl.Text=lv.label .. " ARENA"
			tl.Parent=sg
			local tl2 = Instance.new("TextLabel")
			tl2.Size=UDim2.fromScale(1,0.3)
			tl2.Position=UDim2.fromScale(0,0.52)
			tl2.BackgroundTransparency=1
			tl2.Font=Enum.Font.Gotham
			tl2.TextScaled=true
			tl2.TextColor3=Color3.fromRGB(220,220,230)
			tl2.Text=th.name
			tl2.Parent=sg
			local tl3 = Instance.new("TextLabel")
			tl3.Size=UDim2.fromScale(1,0.18)
			tl3.Position=UDim2.fromScale(0,0.82)
			tl3.BackgroundTransparency=1
			tl3.Font=Enum.Font.Gotham
			tl3.TextScaled=true
			tl3.TextColor3=Color3.fromRGB(245,210,90)
			tl3.Text="FIRST TO WIN · コンボで大ダメージ!"
			tl3.Parent=sg
			local sg2 = sg:Clone()
			sg2.Face = Enum.NormalId.Back
			sg2.Parent = board
		end
		-- ボードを吊るワイヤー
		part({ Name="BoardWireL", Size=Vector3.new(0.12,6,0.12), Position=Vector3.new(-6,y+21,0), Color=Color3.fromRGB(90,90,100), Parent=f })
		part({ Name="BoardWireR", Size=Vector3.new(0.12,6,0.12), Position=Vector3.new(6,y+21,0), Color=Color3.fromRGB(90,90,100), Parent=f })

		-- ── HPバー台座 (両陣営) ──────────────────────────
		for _, z in ipairs({-24,24}) do
			local off = (z &gt; 0) and -3.6 or 3.6
			part({ Name="HpPedestal"..z, Size=Vector3.new(10,0.6,3), Position=Vector3.new(0,y+1.35,z+off), Color=Color3.fromRGB(28,26,34), Parent=f })
		end

		-- ── スポーンリング (発光) + 魔法陣 ───────────────
		for _, z in ipairs({-22,22}) do
			part({ Name="SpawnRingOuter"..z, Size=Vector3.new(7,0.28,7), Position=Vector3.new(0,y+1.15,z), Color=color, Material=Enum.Material.Neon, Parent=f })
			part({ Name="SpawnRingInner"..z, Size=Vector3.new(3.5,0.32,3.5), Position=Vector3.new(0,y+1.18,z), Color=Color3.fromRGB(255,255,255), Material=Enum.Material.Neon, Transparency=0.35, Parent=f })
			-- 魔法陣の線
			part({ Name="MagicLineA"..z, Size=Vector3.new(6,0.18,0.18), Position=Vector3.new(0,y+1.16,z), Color=color, Material=Enum.Material.Neon, Transparency=0.3, Parent=f })
			part({ Name="MagicLineB"..z, Size=Vector3.new(0.18,0.18,6), Position=Vector3.new(0,y+1.16,z), Color=color, Material=Enum.Material.Neon, Transparency=0.3, Parent=f })
		end

		-- ── 透明壁 + 天井 + スポットライト ───────────────
		local wallDefs = {
			{ Vector3.new(46,32,1), Vector3.new(0,y+16,-39) },
			{ Vector3.new(46,32,1), Vector3.new(0,y+16,39) },
			{ Vector3.new(1,32,80), Vector3.new(-22.5,y+16,0) },
			{ Vector3.new(1,32,80), Vector3.new(22.5,y+16,0) },
		}
		for wi, def in ipairs(wallDefs) do
			local w = part({ Name="Wall"..wi, Size=def[1], Position=def[2], Transparency=1, Parent=f })
			w.CanCollide = true
		end
		part({ Name="Ceiling", Size=Vector3.new(46,1,80), Position=Vector3.new(0,y+32,0), Transparency=1, Parent=f })
		-- スポットライト梁
		for _, sx in ipairs({-10,10}) do for _, sz in ipairs({-18,18}) do
			local spot = part({ Name="Spot"..sx..sz, Size=Vector3.new(0.9,0.9,0.9), Position=Vector3.new(sx,y+28,sz), Color=Color3.fromRGB(255,255,240), Material=Enum.Material.Metal, Parent=f })
			local sl = Instance.new("SpotLight")
			sl.Color = Color3.fromRGB(255,255,240)
			sl.Range = 44
			sl.Angle = 46
			sl.Brightness = 2
			sl.Shadows = true
			sl.Face = Enum.NormalId.Bottom
			sl.Parent = spot
		end end

		arenas[lv.key] = {
			spawnA = CFrame.new(0, y + 4.5, -22) * CFrame.Angles(0, math.pi, 0),
			spawnB = CFrame.new(0, y + 4.5, 22),
			folder = f,
		}
	end
end

function ArenaService.get(levelKey)
	return arenas[levelKey]
end

return ArenaService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">LobbyService</string><ProtectedString name="Source">--!nonstrict
-- ロビーワールド生成: 究極豪華版 — 和風城下町 × ネオン × 祭り
-- 中央広場・噴水・回遊市場・桜並木・神社・道場・VIP御殿・ガチャコーナー・ランキング殿堂・転送門
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local LobbyService = {}

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do p[k]=v end
	return p
end

local function addLight(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range or 18
	l.Brightness = brightness or 2
	l.Shadows = true
	l.Parent = parent
	return l
end

local function addSurfaceText(parentPart, text, subText, color)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 28
	sg.Parent = parentPart
	local a = Instance.new("TextLabel")
	a.Size = UDim2.fromScale(1, 0.6)
	a.BackgroundTransparency = 1
	a.Font = Enum.Font.GothamBlack
	a.TextScaled = true
	a.TextColor3 = color or Color3.fromRGB(245,210,90)
	a.Text = text
	a.Parent = sg
	if subText then
		local b = Instance.new("TextLabel")
		b.Size = UDim2.fromScale(1, 0.35)
		b.Position = UDim2.fromScale(0, 0.62)
		b.BackgroundTransparency = 1
		b.Font = Enum.Font.Gotham
		b.TextScaled = true
		b.TextColor3 = Color3.fromRGB(220,220,230)
		b.Text = subText
		b.Parent = sg
	end
	return sg
end

function LobbyService.build(folder)
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = folder

	-- ── 大地 ───────────────────────────────────────────────
	part({ Name="LobbyFloor", Size=Vector3.new(340,4,340), Position=Vector3.new(0,-1,0), Color=Color3.fromRGB(28,28,38), Material=Enum.Material.Slate, Parent=lobby })
	-- 石畳パターン
	for i=-8,8 do
		local c = (i%2==0) and Color3.fromRGB(42,40,55) or Color3.fromRGB(36,34,48)
		part({ Name="Pavement", Size=Vector3.new(3,0.25,340), Position=Vector3.new(i*9,1.05,0), Color=c, Material=Enum.Material.Concrete, Parent=lobby })
		part({ Name="PavementH", Size=Vector3.new(340,0.25,3), Position=Vector3.new(0,1.06,i*9), Color=c, Material=Enum.Material.Concrete, Parent=lobby })
	end
	-- 外周の石塀
	for _, side in ipairs({-1,1}) do
		part({ Name="OuterWallNS", Size=Vector3.new(340,10,2), Position=Vector3.new(0,5,side*168), Color=Color3.fromRGB(45,42,55), Material=Enum.Material.Slate, Parent=lobby })
		part({ Name="OuterWallEW", Size=Vector3.new(2,10,340), Position=Vector3.new(side*168,5,0), Color=Color3.fromRGB(45,42,55), Material=Enum.Material.Slate, Parent=lobby })
	end

	-- ── セントラルカーペット (参道) ───────────────────────
	part({ Name="Carpet", Size=Vector3.new(14,0.3,150), Position=Vector3.new(0,1.2,-10), Color=Color3.fromRGB(165,32,52), Material=Enum.Material.Fabric, Parent=lobby })
	part({ Name="CarpetGoldL", Size=Vector3.new(0.7,0.32,150), Position=Vector3.new(-7,1.22,-10), Color=Color3.fromRGB(245,210,90), Material=Enum.Material.Neon, Parent=lobby })
	part({ Name="CarpetGoldR", Size=Vector3.new(0.7,0.32,150), Position=Vector3.new(7,1.22,-10), Color=Color3.fromRGB(245,210,90), Material=Enum.Material.Neon, Parent=lobby })
	-- カーペットに家紋 (中央)
	for _, z in ipairs({-45,-20,5}) do
		part({ Name="CarpetEmblem", Size=Vector3.new(4,0.35,4), Position=Vector3.new(0,1.25,z), Color=Color3.fromRGB(245,210,90), Material=Enum.Material.Neon, Parent=lobby })
	end

	-- ── 大鳥居 ───────────────────────────────────────────
	local red = Color3.fromRGB(188,30,42)
	local verm = Color3.fromRGB(200,42,52)
	part({ Name="PillarL", Size=Vector3.new(3.8,28,3.8), Position=Vector3.new(-14,14.5,-88), Color=red, Material=Enum.Material.Wood, Parent=lobby })
	part({ Name="PillarR", Size=Vector3.new(3.8,28,3.8), Position=Vector3.new(14,14.5,-88), Color=red, Material=Enum.Material.Wood, Parent=lobby })
	part({ Name="LintelTop", Size=Vector3.new(42,2.8,5), Position=Vector3.new(0,29.5,-88), Color=verm, Material=Enum.Material.Wood, Parent=lobby })
	part({ Name="LintelMid", Size=Vector3.new(34,2,4), Position=Vector3.new(0,24.5,-88), Color=verm, Material=Enum.Material.Wood, Parent=lobby })
	-- 鳥居の額束
	part({ Name="Gakuzuka", Size=Vector3.new(3,6,1.2), Position=Vector3.new(0,27,-88), Color=Color3.fromRGB(22,20,28), Parent=lobby })
	local gz = part({ Name="GakuSign", Size=Vector3.new(7,3,0.4), Position=Vector3.new(0,27,-87.2), Color=Color3.fromRGB(18,16,22), Parent=lobby })
	addSurfaceText(gz, "KANJI KOMBAT", "漢字コンバット", Color3.fromRGB(245,210,90))
	-- 提灯
	for _, x in ipairs({-9,9}) do
		local lan = part({ Name="ToriiLantern", Size=Vector3.new(2,2.6,2), Position=Vector3.new(x,20.5,-88), Color=Color3.fromRGB(255,230,120), Material=Enum.Material.Neon, Parent=lobby })
		addLight(lan, Color3.fromRGB(255,210,90), 16, 2)
		part({ Name="ToriiTassel", Size=Vector3.new(0.4,2,0.4), Position=Vector3.new(x,18.6,-88), Color=Color3.fromRGB(188,30,42), Parent=lobby })
	end

	-- ── 大看板 (頂上に浮遊) ─────────────────────────────
	local sign = part({ Name="Sign", Size=Vector3.new(42,10,1.4), Position=Vector3.new(0,38,-88), Color=Color3.fromRGB(18,16,22), Parent=lobby })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 38
	sg.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1,0.58)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(245,210,90)
	label.Text = (Config.GAME_NAME_EN or "KANJI KOMBAT") .. " / " .. Config.GAME_NAME
	label.Parent = sg
	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.fromScale(1,0.32)
	sub.Position = UDim2.fromScale(0,0.60)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.Gotham
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(220,220,230)
	sub.Text = "12 LEVELS · 12,000問 · RANKED · BATTLE PASS · DAILY QUESTS"
	sub.Parent = sg
	local sgBack = sg:Clone()
	sgBack.Face = Enum.NormalId.Back
	sgBack.Parent = sign

	-- ── 中央噴水広場 ───────────────────────────────────
	part({ Name="FountainBase", Size=Vector3.new(22,1,22), Position=Vector3.new(0,1.1,0), Color=Color3.fromRGB(50,50,65), Material=Enum.Material.Marble, Parent=lobby })
	part({ Name="FountainRim", Size=Vector3.new(16,1.2,16), Position=Vector3.new(0,1.8,0), Color=Color3.fromRGB(180,180,195), Material=Enum.Material.Marble, Parent=lobby })
	part({ Name="FountainWater", Size=Vector3.new(12,0.4,12), Position=Vector3.new(0,1.6,0), Color=Color3.fromRGB(80,180,220), Material=Enum.Material.Neon, Transparency=0.35, Parent=lobby })
	local pillar = part({ Name="FountainPillar", Size=Vector3.new(2,6,2), Position=Vector3.new(0,4.5,0), Color=Color3.fromRGB(245,210,90), Material=Enum.Material.Metal, Parent=lobby })
	addLight(pillar, Color3.fromRGB(120,200,255), 22, 1.5)
	part({ Name="FountainKanji", Size=Vector3.new(3,3,0.6), Position=Vector3.new(0,7.5,1.2), Color=Color3.fromRGB(18,16,22), Parent=lobby })
	local fk = part({ Name="FountainKanjiSign", Size=Vector3.new(3,3,0.2), Position=Vector3.new(0,7.5,1.6), Color=Color3.fromRGB(18,16,22), Parent=lobby })
	local fsg = Instance.new("SurfaceGui")
	fsg.Face = Enum.NormalId.Front
	fsg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	fsg.PixelsPerStud = 22
	fsg.Parent = fk
	local ftl = Instance.new("TextLabel")
	ftl.Size = UDim2.fromScale(1,1)
	ftl.BackgroundTransparency=1
	ftl.Font = Enum.Font.GothamBlack
	ftl.TextScaled=true
	ftl.TextColor3=Color3.fromRGB(245,210,90)
	ftl.Text="漢"
	ftl.Parent=fsg

	-- ── 桜並木 (12本) ─────────────────────────────────
	local sakuraPositions = {
		Vector3.new(-32,0,-42), Vector3.new(32,0,-42),
		Vector3.new(-46,0,-20), Vector3.new(46,0,-20),
		Vector3.new(-52,0,8), Vector3.new(52,0,8),
		Vector3.new(-48,0,34), Vector3.new(48,0,34),
		Vector3.new(-30,0,56), Vector3.new(30,0,56),
		Vector3.new(-14,0,68), Vector3.new(14,0,68),
	}
	for idx, pos in ipairs(sakuraPositions) do
		part({ Name="SakuraTrunk"..idx, Size=Vector3.new(1.2,10,1.2), Position=Vector3.new(pos.X,5,pos.Z), Color=Color3.fromRGB(74,56,48), Material=Enum.Material.Wood, Parent=lobby })
		local crown = part({ Name="SakuraCrown"..idx, Size=Vector3.new(7,5,7), Position=Vector3.new(pos.X,11.5,pos.Z), Color=Color3.fromRGB(255,175,190), Material=Enum.Material.Leaf, Parent=lobby })
		local bloom = part({ Name="SakuraBloom"..idx, Size=Vector3.new(4,1.5,4), Position=Vector3.new(pos.X,14,pos.Z), Color=Color3.fromRGB(255,205,215), Material=Enum.Material.Neon, Transparency=0.18, Parent=lobby })
		addLight(crown, Color3.fromRGB(255,180,195), 12, 1)
		-- 花びらパーティクル用の小パーツ
		for b=1,2 do
			part({ Name="SakuraPetal"..idx.."_"..b, Size=Vector3.new(0.6,0.06,0.6), Position=Vector3.new(pos.X+(b*2-3),9,pos.Z+(b%2)*2), Color=Color3.fromRGB(255,200,210), Material=Enum.Material.Neon, Transparency=0.4, Parent=lobby })
		end
	end

	-- ── 市場屋台 (6件 + 2大屋台) ────────────────────────
	local stalls = {
		{x=-70, z=-18, label="SHOP / ショップ", color=Color3.fromRGB(245,210,90)},
		{x=70,  z=-18, label="PASS / バトルパス", color=Color3.fromRGB(120,220,255)},
		{x=-70, z=12, label="GACHA / ガチャ", color=Color3.fromRGB(255,140,200)},
		{x=70,  z=12, label="GEMS / ジェム", color=Color3.fromRGB(90,255,160)},
		{x=-52, z=-52, label="BOOST / ブースト", color=Color3.fromRGB(255,210,90)},
		{x=52,  z=-52, label="COSME / アバター", color=Color3.fromRGB(180,140,255)},
	}
	for i, s in ipairs(stalls) do
		part({ Name="StallFloor"..i, Size=Vector3.new(16,1,14), Position=Vector3.new(s.x,0.6,s.z), Color=Color3.fromRGB(60,52,42), Material=Enum.Material.Wood, Parent=lobby })
		part({ Name="StallRoof"..i, Size=Vector3.new(18,1.4,16), Position=Vector3.new(s.x,7.8,s.z), Color=Color3.fromRGB(188,30,42), Material=Enum.Material.Wood, Parent=lobby })
		for _, dx in ipairs({-7,7}) do for _, dz in ipairs({-6,6}) do
			part({ Name="StallPillar"..i, Size=Vector3.new(0.7,7.2,0.7), Position=Vector3.new(s.x+dx,3.9,s.z+dz), Color=Color3.fromRGB(92,72,60), Material=Enum.Material.Wood, Parent=lobby })
		end end
		-- のれん
		part({ Name="StallNoren"..i, Size=Vector3.new(14,2.2,0.3), Position=Vector3.new(s.x,6.2,s.z+7.2), Color=Color3.fromRGB(235,235,242), Material=Enum.Material.Fabric, Parent=lobby })
		-- カウンター
		part({ Name="StallCounter"..i, Size=Vector3.new(12,2.2,3), Position=Vector3.new(s.x,2,s.z+4.5), Color=Color3.fromRGB(38,34,28), Material=Enum.Material.Wood, Parent=lobby })
		-- 看板
		local signPart = part({ Name="StallSign"..i, Size=Vector3.new(11,3.2,0.6), Position=Vector3.new(s.x,10.2,s.z), Color=Color3.fromRGB(22,20,28), Parent=lobby })
		addSurfaceText(signPart, s.label, nil, s.color)
		addLight(signPart, s.color, 14, 1.2)
	end

	-- ── デイリー神社 (拡張: 鳥居 + 狛犬 + 賽銭箱 + 絵馬掛け) ─
