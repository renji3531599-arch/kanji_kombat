-- ================================================================ state
local current = I18n.DEFAULT

local function normalize(code)
	code = tostring(code or ""):lower()
	if code:sub(1, 2) == "ja" then
		return "ja"
	end
	return "en"
end

-- "ja-jp" / "en-us" などのロケールID → "ja" / "en"
function I18n.localeFromId(id)
	return normalize(id)
end

function I18n.setLocale(code)
	current = normalize(code)
	return current
end

function I18n.getLocale()
	return current
end

-- 切り替え先 (ja &lt;-&gt; en)
function I18n.otherLocale(code)
	local c = normalize(code or current)
	return (c == "ja") and "en" or "ja"
end

function I18n.localeLabel(code)
	local c = normalize(code)
	return (c == "ja") and "日本語" or "English"
end

-- 端末ロケールの自動判定 (クライアントのみ。サーバーでは既定値を返す)
function I18n.detectLocale()
	local id = ""
	pcall(function()
		local Players = game:GetService("Players")
		local plr = Players and Players.LocalPlayer
		if plr and plr.LocaleId and plr.LocaleId ~= "" then
			id = plr.LocaleId
		else
			id = game:GetService("LocalizationService").RobloxLocaleId or ""
		end
	end)
	if id == "" then
		return nil, ""
	end
	return normalize(id), id
end

-- ================================================================ translate
function I18n.raw(key, locale)
	local entry = STRINGS[key]
	if not entry then
		return nil
	end
	return entry[normalize(locale or current)] or entry[I18n.DEFAULT] or key
end

function I18n.has(key)
	return STRINGS[key] ~= nil
end

-- 定義済みキーの一覧 (tools/test_luau.py の検証用)
function I18n.keys()
	local out = {}
	for k in pairs(STRINGS) do
		out[#out + 1] = k
	end
	return out
end

-- I18n.t("profileStats", { wins = 3, losses = 1, streak = 2 })
function I18n.t(key, params)
	local s = I18n.raw(key)
	if not s then
		warn("[I18n] missing key: " .. tostring(key))
		return tostring(key)
	end
	if params then
		s = (s:gsub("{([%w_]+)}", function(k)
			local v = params[k]
			return v ~= nil and tostring(v) or ("{" .. k .. "}")
		end))
	end
	return s
end

-- ================================================================ levels
function I18n.levelTitle(levelKey)
	local lv = Config.levelByKey(levelKey)
	if not lv then
		return tostring(levelKey)
	end
	if current == "en" and lv.en and lv.en.label then
		return lv.en.label
	end
	return lv.label
end

function I18n.levelDesc(levelKey)
	local lv = Config.levelByKey(levelKey)
	if not lv then
		return ""
	end
	local base
	if current == "en" and lv.en and lv.en.desc then
		base = lv.en.desc
	else
		base = lv.desc
	end
	-- 英語UIでは JLPT の目安も併記する
	if current == "en" and lv.jlpt and lv.jlpt ~= "" then
		return base .. " · " .. lv.jlpt
	end
	return base
end

-- 級の説明つき表記: 日本語「10級」/ 英語「Level 10 (Grade 1 · ≈ JLPT N5)」
function I18n.levelFull(levelKey)
	local t = I18n.levelTitle(levelKey)
	local d = I18n.levelDesc(levelKey)
	if d == "" then
		return t
	end
	return t .. " (" .. d .. ")"
end

function I18n.rankTitle(rating)
	local rank = Config.rankForRating(tonumber(rating) or Config.DEFAULT_RATING)
	if current == "en" then
		return rank.en or rank.label
	end
	return rank.label
end

-- 読みの表示: 英語UIでは「きょうしゅう / kyoushuu」のよう併記する
function I18n.reading(kana, romaji)
	if current == "en" and romaji and romaji ~= "" then
		return kana .. " / " .. romaji
	end
	return kana
end

return I18n
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Romaji</string><ProtectedString name="Source">--!nocheck
-- かな → ローマ字 (ヘボン式ベース / 長音は母音を重ねる wāpuro 式)
-- 英語圏プレイヤー向けに読みの選択肢を "きょうしゅう / kyoushuu" のように併記するために使う。
-- utf8 ライブラリに依存しない実装 (LuaJIT / Luau 両対応) — テストは tools/test_luau.py から実行。

local Romaji = {}

local BASE = {
	["あ"] = "a", ["い"] = "i", ["う"] = "u", ["え"] = "e", ["お"] = "o",
	["か"] = "ka", ["き"] = "ki", ["く"] = "ku", ["け"] = "ke", ["こ"] = "ko",
	["が"] = "ga", ["ぎ"] = "gi", ["ぐ"] = "gu", ["げ"] = "ge", ["ご"] = "go",
	["さ"] = "sa", ["し"] = "shi", ["す"] = "su", ["せ"] = "se", ["そ"] = "so",
	["ざ"] = "za", ["じ"] = "ji", ["ず"] = "zu", ["ぜ"] = "ze", ["ぞ"] = "zo",
	["た"] = "ta", ["ち"] = "chi", ["つ"] = "tsu", ["て"] = "te", ["と"] = "to",
	["だ"] = "da", ["ぢ"] = "ji", ["づ"] = "zu", ["で"] = "de", ["ど"] = "do",
	["な"] = "na", ["に"] = "ni", ["ぬ"] = "nu", ["ね"] = "ne", ["の"] = "no",
	["は"] = "ha", ["ひ"] = "hi", ["ふ"] = "fu", ["へ"] = "he", ["ほ"] = "ho",
	["ば"] = "ba", ["び"] = "bi", ["ぶ"] = "bu", ["べ"] = "be", ["ぼ"] = "bo",
	["ぱ"] = "pa", ["ぴ"] = "pi", ["ぷ"] = "pu", ["ぺ"] = "pe", ["ぽ"] = "po",
	["ま"] = "ma", ["み"] = "mi", ["む"] = "mu", ["め"] = "me", ["も"] = "mo",
	["や"] = "ya", ["ゆ"] = "yu", ["よ"] = "yo",
	["ら"] = "ra", ["り"] = "ri", ["る"] = "ru", ["れ"] = "re", ["ろ"] = "ro",
	["わ"] = "wa", ["ゐ"] = "i", ["ゑ"] = "e", ["を"] = "o", ["ん"] = "n",
	["ゔ"] = "vu",
	["ぁ"] = "a", ["ぃ"] = "i", ["ぅ"] = "u", ["ぇ"] = "e", ["ぉ"] = "o",
	["ゃ"] = "ya", ["ゅ"] = "yu", ["ょ"] = "yo", ["ゎ"] = "wa",
	-- カタカナ (データは基本ひらがなだが一応)
	["ア"] = "a", ["イ"] = "i", ["ウ"] = "u", ["エ"] = "e", ["オ"] = "o",
	["カ"] = "ka", ["キ"] = "ki", ["ク"] = "ku", ["ケ"] = "ke", ["コ"] = "ko",
	["サ"] = "sa", ["シ"] = "shi", ["ス"] = "su", ["セ"] = "se", ["ソ"] = "so",
	["タ"] = "ta", ["チ"] = "chi", ["ツ"] = "tsu", ["テ"] = "te", ["ト"] = "to",
	["ナ"] = "na", ["ニ"] = "ni", ["ヌ"] = "nu", ["ネ"] = "ne", ["ノ"] = "no",
	["ハ"] = "ha", ["ヒ"] = "hi", ["フ"] = "fu", ["ヘ"] = "he", ["ホ"] = "ho",
	["マ"] = "ma", ["ミ"] = "mi", ["ム"] = "mu", ["メ"] = "me", ["モ"] = "mo",
	["ヤ"] = "ya", ["ユ"] = "yu", ["ヨ"] = "yo",
	["ラ"] = "ra", ["リ"] = "ri", ["ル"] = "ru", ["レ"] = "re", ["ロ"] = "ro",
	["ワ"] = "wa", ["ヲ"] = "o", ["ン"] = "n",
}

local COMBO = {
	["きゃ"] = "kya", ["きゅ"] = "kyu", ["きょ"] = "kyo",
	["ぎゃ"] = "gya", ["ぎゅ"] = "gyu", ["ぎょ"] = "gyo",
	["しゃ"] = "sha", ["しゅ"] = "shu", ["しょ"] = "sho",
	["じゃ"] = "ja", ["じゅ"] = "ju", ["じょ"] = "jo",
	["ちゃ"] = "cha", ["ちゅ"] = "chu", ["ちょ"] = "cho",
	["ぢゃ"] = "ja", ["ぢゅ"] = "ju", ["ぢょ"] = "jo",
	["にゃ"] = "nya", ["にゅ"] = "nyu", ["にょ"] = "nyo",
	["ひゃ"] = "hya", ["ひゅ"] = "hyu", ["ひょ"] = "hyo",
	["びゃ"] = "bya", ["びゅ"] = "byu", ["びょ"] = "byo",
	["ぴゃ"] = "pya", ["ぴゅ"] = "pyu", ["ぴょ"] = "pyo",
	["みゃ"] = "mya", ["みゅ"] = "myu", ["みょ"] = "myo",
	["りゃ"] = "rya", ["りゅ"] = "ryu", ["りょ"] = "ryo",
	["ふぁ"] = "fa", ["ふぃ"] = "fi", ["ふぇ"] = "fe", ["ふぉ"] = "fo",
	["うぃ"] = "wi", ["うぇ"] = "we", ["うぉ"] = "wo",
	["しぇ"] = "she", ["じぇ"] = "je", ["ちぇ"] = "che",
	["てぃ"] = "ti", ["でぃ"] = "di", ["とぅ"] = "tu", ["どぅ"] = "du",
	["つぁ"] = "tsa", ["つぃ"] = "tsi", ["つぇ"] = "tse", ["つぉ"] = "tso",
	["ゔぁ"] = "va", ["ゔぃ"] = "vi", ["ゔぇ"] = "ve", ["ゔぉ"] = "vo",
}

-- 同じ発音になるかな (じ/ぢ など) の衝突回避用の代替表記
local ALT = { ["ぢ"] = "di", ["づ"] = "du" }
local ALT_COMBO = { ["ぢゃ"] = "dya", ["ぢゅ"] = "dyu", ["ぢょ"] = "dyo" }

local SMALL = {
	["ぁ"] = true, ["ぃ"] = true, ["ぅ"] = true, ["ぇ"] = true, ["ぉ"] = true,
	["ゃ"] = true, ["ゅ"] = true, ["ょ"] = true, ["ゎ"] = true,
}
local VOWELS = { a = true, i = true, u = true, e = true, o = true }
local N_APOSTROPHE = {
	["あ"] = true, ["い"] = true, ["う"] = true, ["え"] = true, ["お"] = true,
	["や"] = true, ["ゆ"] = true, ["よ"] = true,
	["ぁ"] = true, ["ぃ"] = true, ["ぅ"] = true, ["ぇ"] = true, ["ぉ"] = true,
	["ゃ"] = true, ["ゅ"] = true, ["ょ"] = true,
}

-- UTF-8 文字列を1文字ずつのテーブルに分解 (utf8 ライブラリ非依存)
local function chars(s)
	local out, i, n = {}, 1, #s
	while i &lt;= n do
		local b = string.byte(s, i)
		local len = 1
		if b &gt;= 0xF0 then
			len = 4
		elseif b &gt;= 0xE0 then
			len = 3
		elseif b &gt;= 0xC0 then
			len = 2
		end
		out[#out + 1] = string.sub(s, i, i + len - 1)
		i = i + len
	end
	return out
end

-- i 番目 (1始まり) の音節を返す: romaji, 消費した文字数
local function syllable(cs, i, alt)
	local two = cs[i + 1] and (cs[i] .. cs[i + 1]) or nil
	if two then
		local c = (alt and ALT_COMBO[two]) or COMBO[two]
		if c then
			return c, 2
		end
	end
	local ch = cs[i]
	if ch == "ん" then
		local nxt = cs[i + 1]
		if nxt and N_APOSTROPHE[nxt] then
			return "n'", 1
		end
		return "n", 1
	end
	if alt and ALT[ch] then
		return ALT[ch], 1
	end
	return BASE[ch] or ch, 1
end

-- かな文字列 → ローマ字
function Romaji.convert(kana, alt)
	if type(kana) ~= "string" or kana == "" then
		return kana or ""
	end
	local cs = chars(kana)
	local out = {}
	local i, n = 1, #cs
	while i &lt;= n do
		local c = cs[i]
		if c == "っ" or c == "ッ" then
			local nxt = cs[i + 1]
			if nxt and not SMALL[nxt] and nxt ~= "ー" and nxt ~= "っ" and nxt ~= "ッ" then
				local r = syllable(cs, i + 1, alt)
				if r and r ~= "" then
					if string.sub(r, 1, 2) == "ch" then
						out[#out + 1] = "t" -- 抹茶 = matcha
					else
						local k = string.sub(r, 1, 1)
						if not VOWELS[k] then
							if k == "n" and alt then
								-- なんにゅう (nannyuu) と なっにゅう (nannyuu) の区別
								out[#out + 1] = "n'"
							else
								out[#out + 1] = k -- じゅっもく = jummoku (促音の重ね)
							end
						end
					end
				end
			end
			i = i + 1
		elseif c == "ー" then
			local prev = table.concat(out)
			local v = ""
			for j = #prev, 1, -1 do
				local ch = string.sub(prev, j, j)
				if VOWELS[ch] then
					v = ch
					break
				end
			end
			out[#out + 1] = v -- らーめん = raamen
			i = i + 1
		else
			local r, used = syllable(cs, i, alt)
			out[#out + 1] = r
			i = i + used
		end
	end
	return table.concat(out)
end

-- 選択肢4つのように「並べたときに重複しない」ローマ字を返す (例: じ / ぢ → ji / di)
function Romaji.convertMany(list)
	local out, used = {}, {}
	for i = 1, #list do
		local r = Romaji.convert(list[i])
		if used[r] then
			-- 1) 先に出た同表記のものを代替表記へ移せないか (なっにゅう = nan'nyuu)
			for j = 1, i - 1 do
				if out[j] == r then
					local alt = Romaji.convert(list[j], true)
					if alt ~= r and not used[alt] then
						out[j] = alt
						used[alt] = true
						used[r] = nil
						break
					end
				end
			end
		end
		if used[r] then
			-- 2) 自分を代替表記にする (ぢ = di / づ = du)
			local alt = Romaji.convert(list[i], true)
			if alt ~= r and not used[alt] then
				r = alt
			end
		end
		out[i] = r
		used[r] = true
	end
	return out
end

return Romaji
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX27"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX26"><Properties><string name="Name">KanjiKombat</string><ProtectedString name="Source">--!nonstrict
-- 漢字コンバット サーバーエントリポイント
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ------------------------------------------------- remotes
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage

local S2C = Instance.new("RemoteEvent")
S2C.Name = "ServerToClient"
S2C.Parent = remotes

local C2S = Instance.new("RemoteEvent")
C2S.Name = "ClientToServer"
C2S.Parent = remotes

local RF = Instance.new("RemoteFunction")
RF.Name = "GetProfile"
RF.Parent = remotes

-- ------------------------------------------------- modules
local Modules = script:WaitForChild("Modules")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))
local QuestionBank = require(Modules:WaitForChild("QuestionBank"))
local StatsService = require(Modules:WaitForChild("StatsService"))
local ArenaService = require(Modules:WaitForChild("ArenaService"))
local LobbyService = require(Modules:WaitForChild("LobbyService"))
local MatchService = require(Modules:WaitForChild("MatchService"))
local PurchaseService = require(Modules:WaitForChild("PurchaseService"))

math.randomseed(os.time() + os.clock() * 1000)

-- ------------------------------------------------- world
local world = Instance.new("Folder")
world.Name = "KanjiKombatWorld"
world.Parent = workspace

LobbyService.build(world)
ArenaService.build(world)

MatchService.init({
	QuestionBank = QuestionBank,
	StatsService = StatsService,
	ArenaService = ArenaService,
	LobbyService = LobbyService,
	S2C = S2C,
	C2S = C2S,
})

PurchaseService.init({
	StatsService = StatsService,
	S2C = S2C,
})

-- クライアントからの操作 (対戦エントリー / 回答 / 練習モード) を受け取る。
-- ここを繋がないとサーバーは何も受信せず、練習モードは問題が1問も出ない。
C2S.OnServerEvent:Connect(function(player, data)
	local ok, err = pcall(MatchService.onRemote, player, data)
	if not ok then
		warn("[MatchService] onRemote: " .. tostring(err))
	end
	local shopOk, shopErr = pcall(PurchaseService.onRemote, player, data)
	if not shopOk then
		warn("[PurchaseService] onRemote: " .. tostring(shopErr))
	end
end)

-- ------------------------------------------------- profile plumbing
local function sanitizeProfile(profile)
	local ratings = {}
	for k, v in pairs(profile.ratings) do
		ratings[k] = v
	end
	return {
		ratings = ratings,
		wins = profile.wins,
		losses = profile.losses,
		streak = profile.streak,
		bestStreak = profile.bestStreak,
		coins = profile.coins or 0,
		xp = profile.xp or 0,
		level = profile.level or 1,
		correctAnswers = profile.correctAnswers or 0,
		answeredQuestions = profile.answeredQuestions or 0,
		bestCombo = profile.bestCombo or 0,
		daily = profile.daily or { battles = 0, claimed = false },
		inventory = profile.inventory or {},
		equipped = profile.equipped or { title = "rookie", aura = "none" },
		locale = profile.locale, -- 保存された表示言語 (未設定なら nil = 自動判定)
	}
end

RF.OnServerInvoke = function(player)
	return sanitizeProfile(StatsService.get(player))
end

Players.PlayerAdded:Connect(function(player)
	StatsService.load(player)
	task.spawn(function()
		PurchaseService.syncPasses(player)
	end)
end)

-- Studio で既に参加済みの場合
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		StatsService.load(player)
		PurchaseService.syncPasses(player)
	end)
end

-- ------------------------------------------------- loops
task.spawn(function()
	while true do
		local ok, err = pcall(MatchService.tick)
		if not ok then
			warn("[MatchService] " .. tostring(err))
		end
		task.wait(1)
	end
end)

print("[KanjiKombat] server ready / 起動完了")
print(string.format("[KanjiKombat] levels=%d, K10=%d, K01=%d questions",
	#Config.LEVELS, QuestionBank.count("K10"), QuestionBank.count("K01")))
</ProtectedString></Properties><Item class="Folder" referent="RBX12"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">QuestionBank</string><ProtectedString name="Source">--!nonstrict
-- 問題バンク: ServerScriptService.KanjiKombat.Data の12レベル分の問題を読み込む
local QuestionBank = {}

local dataFolder = script.Parent.Parent:WaitForChild("Data")

local banks = {}
local order = { "K10", "K09", "K08", "K07", "K06", "K05", "K04", "K03", "KP2", "K02", "KP1", "K01" }

for _, key in ipairs(order) do
	local mod = dataFolder:WaitForChild("Questions_" .. key)
	local ok, result = pcall(require, mod)
	if ok and type(result) == "table" then
		banks[key] = result
	else
		warn("[QuestionBank] failed to load " .. key)
		banks[key] = {}
	end
end

-- levelKey の問題を1問引く (exclude 内のプロンプトは避ける)
function QuestionBank.draw(levelKey, exclude)
	local bank = banks[levelKey]
	if not bank or #bank == 0 then
		return nil
	end
	exclude = exclude or {}
	for _ = 1, 12 do
		local q = bank[math.random(#bank)]
		if not exclude[q.p] then
			exclude[q.p] = true
			return q
		end
	end
	-- 見つからなければ重複を許容
	local q = bank[math.random(#bank)]
	exclude[q.p] = true
	return q
end

-- 選択肢をシャッフルして正解インデックスを返す (1-4)
function QuestionBank.pack(q)
	local choices = { q.a, q.d[1], q.d[2], q.d[3] }
	for i = #choices, 2, -1 do
		local j = math.random(i)
		choices[i], choices[j] = choices[j], choices[i]
	end
	local correct = 1
	for i, c in ipairs(choices) do
		if c == q.a then
			correct = i
			break
		end
	end
	return choices, correct
end

function QuestionBank.count(levelKey)
	return banks[levelKey] and #banks[levelKey] or 0
end

return QuestionBank
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">StatsService</string><ProtectedString name="Source">--!nonstrict
-- プロフィール、Elo、ランク、ゲーム内進行を一元管理するサービス。
-- Robux 購入の付与も必ずこのモジュールを経由し、クライアントの値を信用しない。
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))
local I18n = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("I18n"))

local StatsService = {}

local store
pcall(function()
	store = DataStoreService:GetDataStore("KK_Profile_v2")
end)

local profiles = {} -- [player] = profile
local dirty = {}    -- [player] = true

local function todayKey()
	return os.date("!%Y-%m-%d")
end

local function defaultProfile()
	local ratings = {}
	for _, lv in ipairs(Config.LEVELS) do
		ratings[lv.key] = Config.DEFAULT_RATING
	end
	return {
		ratings = ratings,
	wins = 0,
	losses = 0,
	streak = 0,
	bestStreak = 0,
	coins = 0,
	xp = 0,
	level = 1,
	correctAnswers = 0,
	answeredQuestions = 0,
	bestCombo = 0,
	fastestMs = 0,
	locale = nil,
	uiLocale = nil,
	inventory = {},
	equipped = { title = "rookie", aura = "none" },
	daily = { date = todayKey(), battles = 0, claimed = false },
	processedReceipts = {},
	lastReward = nil,
	}
end

local function profileOf(player)
	return profiles[player]
end

local function normalizeProfile(profile)
	local base = defaultProfile()
	if type(profile) ~= "table" then
		return base
	end
	for key, default in pairs(base) do
		if type(default) ~= "table" and type(profile[key]) == type(default) then
			base[key] = profile[key]
		end
	end
	if type(profile.ratings) == "table" then
		for _, lv in ipairs(Config.LEVELS) do
			if type(profile.ratings[lv.key]) == "number" then
				base.ratings[lv.key] = math.floor(profile.ratings[lv.key])
			end
		end
	end
	for _, field in ipairs({ "inventory", "equipped", "daily", "processedReceipts" }) do
		if type(profile[field]) == "table" then
			base[field] = profile[field]
		end
	end
	if type(profile.locale) == "string" then
		base.locale = I18n.localeFromId(profile.locale)
	end
	if type(profile.uiLocale) == "string" then
		base.uiLocale = I18n.localeFromId(profile.uiLocale)
	end
	if type(base.daily.date) ~= "string" or base.daily.date ~= todayKey() then
		base.daily = { date = todayKey(), battles = 0, claimed = false }
	else
		base.daily.battles = math.max(0, math.floor(tonumber(base.daily.battles) or 0))
		base.daily.claimed = base.daily.claimed == true
	end
	base.coins = math.max(0, math.floor(tonumber(base.coins) or 0))
	base.xp = math.max(0, math.floor(tonumber(base.xp) or 0))
	base.level = math.max(1, math.floor(tonumber(base.level) or 1))
	return base
end

function StatsService.get(player)
	return profileOf(player) or defaultProfile()
end

function StatsService.isLoaded(player)
	return profileOf(player) ~= nil
end

local function keyFor(player)
	return "u_" .. player.UserId
end

function StatsService.load(player)
	local profile = defaultProfile()
	if store then
		local ok, data = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok and type(data) == "table" then
			profile = normalizeProfile(data)
		end
	end
	profiles[player] = profile
	StatsService.setupLeaderstats(player, profile)
end

local function updateLeaderstat(player, profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local wins = ls:FindFirstChild("勝数") or ls:FindFirstChild("Wins")
	if wins then
		wins.Value = profile.wins
	end
	local rating = ls:FindFirstChild("最高レート") or ls:FindFirstChild("Rating")
	if rating then
		local best = Config.DEFAULT_RATING
		for _, value in pairs(profile.ratings) do
			best = math.max(best, tonumber(value) or Config.DEFAULT_RATING)
		end
		rating.Value = best
	end
end

-- リーダーボードはプレイヤーの言語に合わせる。ただし値は同じ。
function StatsService.setupLeaderstats(player, profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end
	local wins = ls:FindFirstChild("勝数") or ls:FindFirstChild("Wins")
	if not wins then
		wins = Instance.new("IntValue")
		wins.Parent = ls
	end
	wins.Name = (I18n.localeFromId(profile.uiLocale or profile.locale) == "ja") and "勝数" or "Wins"
	wins.Value = profile.wins

	local rating = ls:FindFirstChild("最高レート") or ls:FindFirstChild("Rating")
	if not rating then
		rating = Instance.new("IntValue")
		rating.Parent = ls
	end
	rating.Name = (I18n.localeFromId(profile.uiLocale or profile.locale) == "ja") and "最高レート" or "Rating"
	local best = Config.DEFAULT_RATING
	for _, value in pairs(profile.ratings) do
		best = math.max(best, tonumber(value) or Config.DEFAULT_RATING)
	end
	rating.Value = best
end

function StatsService.markDirty(player)
	if profiles[player] then
		dirty[player] = true
	end
end

function StatsService.addCoins(player, amount)
	local profile = profileOf(player)
	amount = math.floor(tonumber(amount) or 0)
	if not profile or amount == 0 then
		return profile and profile.coins or 0
	end
	profile.coins = math.max(0, profile.coins + amount)
	StatsService.markDirty(player)
	return profile.coins
end

local function xpForLevel(level)
	return 250 + (math.max(1, level) - 1) * 75
end

function StatsService.addXp(player, amount)
	local profile = profileOf(player)
	amount = math.max(0, math.floor(tonumber(amount) or 0))
	if not profile or amount == 0 then
		return profile and profile.level or 1
	end
	profile.xp = profile.xp + amount
	while profile.xp &gt;= xpForLevel(profile.level) do
		profile.xp = profile.xp - xpForLevel(profile.level)
		profile.level = profile.level + 1
		profile.coins = profile.coins + 25
	end
	StatsService.markDirty(player)
	return profile.level
end

function StatsService.grantItem(player, itemKey)
	local profile = profileOf(player)
	if not profile or type(itemKey) ~= "string" or itemKey == "" then
		return false
	end
	profile.inventory[itemKey] = true
	StatsService.markDirty(player)
	return true
end

function StatsService.hasItem(player, itemKey)
	local profile = profileOf(player)
	return profile and profile.inventory and profile.inventory[itemKey] == true or false
end

function StatsService.equip(player, slot, itemKey)
	local profile = profileOf(player)
	if not profile or (slot ~= "title" and slot ~= "aura") then
		return false
	end
	if itemKey ~= "rookie" and itemKey ~= "none" and not StatsService.hasItem(player, itemKey) then
		return false
	end
	profile.equipped[slot] = itemKey
	StatsService.markDirty(player)
	return true
end

function StatsService.recordAnswer(player, correct, elapsed)
	local profile = profileOf(player)
	if not profile then
		return
	end
	profile.answeredQuestions = profile.answeredQuestions + 1
	if correct then
		profile.correctAnswers = profile.correctAnswers + 1
	end
	if correct and tonumber(elapsed) and elapsed &gt; 0 then
		local ms = math.floor(elapsed * 1000 + 0.5)
		if profile.fastestMs == 0 or ms &lt; profile.fastestMs then
			profile.fastestMs = ms
		end
	end
	StatsService.markDirty(player)
end

function StatsService.awardMatch(player, won, bestCombo, correct, total)
	local profile = profileOf(player)
	if not profile then
		return { coins = 0, xp = 0 }
	end
	local progression = Config.PROGRESSION
	local coins = won and progression.COINS_WIN or progression.COINS_LOSS
	local xp = won and progression.XP_WIN or progression.XP_LOSS
	profile.daily.battles = profile.daily.battles + 1
	if bestCombo &gt; profile.bestCombo then
		profile.bestCombo = bestCombo
	end
	if profile.daily.battles &gt;= progression.DAILY_GOAL and not profile.daily.claimed then
		profile.daily.claimed = true
		coins = coins + 100
	end
	coins = coins + math.max(0, math.floor((correct or 0) * 2))
	xp = xp + math.max(0, math.floor((correct or 0) * progression.XP_CORRECT))
	StatsService.addCoins(player, coins)
	StatsService.addXp(player, xp)
	profile.lastReward = { coins = coins, xp = xp, correct = correct or 0, total = total or 0 }
	StatsService.markDirty(player)
	return { coins = coins, xp = xp }
end

function StatsService.awardPractice(player, correct)
	if correct then
		StatsService.addCoins(player, Config.PROGRESSION.COINS_PRACTICE)
		StatsService.addXp(player, Config.PROGRESSION.XP_CORRECT)
	end
end

-- 手動ロケールは保存。自動ロケールは今セッションの leaderstats だけ変える。
function StatsService.setLocale(player, code, source)
	local profile = profileOf(player)
	if not profile then
		return
	end
	local normalized = I18n.localeFromId(code)
	profile.uiLocale = normalized
	if source == "manual" then
		profile.locale = normalized
		StatsService.markDirty(player)
	end
	StatsService.setupLeaderstats(player, profile)
end

function StatsService.receiptSeen(player, purchaseId)
	local profile = profileOf(player)
	if not profile or type(purchaseId) ~= "string" then
		return false
	end
	for _, id in ipairs(profile.processedReceipts) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

function StatsService.rememberReceipt(player, purchaseId)
	local profile = profileOf(player)
	if not profile or type(purchaseId) ~= "string" then
		return
	end
	profile.processedReceipts[#profile.processedReceipts + 1] = purchaseId
	while #profile.processedReceipts &gt; 30 do
		table.remove(profile.processedReceipts, 1)
	end
	StatsService.markDirty(player)
end

-- Elo: winner/loser は player インスタンス。勝敗は必ずサーバーが決める。
function StatsService.applyResult(levelKey, winner, loser)
	local pw = profileOf(winner)
	local pl = profileOf(loser)
	if not pw or not pl then
		return 0
	end
	local rw = pw.ratings[levelKey] or Config.DEFAULT_RATING
	local rl = pl.ratings[levelKey] or Config.DEFAULT_RATING
	local ew = 1 / (1 + 10 ^ ((rl - rw) / 400))
	local dw = math.max(5, math.floor(Config.ELO_K * (1 - ew) + 0.5))
	pw.ratings[levelKey] = rw + dw
	pl.ratings[levelKey] = math.max(100, rl - dw)
	pw.wins = pw.wins + 1
	pl.losses = pl.losses + 1
	pw.streak = pw.streak + 1
	pl.streak = 0
	if pw.streak &gt; pw.bestStreak then
		pw.bestStreak = pw.streak
	end
	updateLeaderstat(winner, pw)
	updateLeaderstat(loser, pl)
	StatsService.markDirty(winner)
	StatsService.markDirty(loser)
	return dw
end

function StatsService.applyDraw(playerA, playerB)
	local a, b = profileOf(playerA), profileOf(playerB)
	if a then a.streak = 0 end
	if b then b.streak = 0 end
	StatsService.markDirty(playerA)
	StatsService.markDirty(playerB)
end

local function save(player)
	local profile = profileOf(player)
	if not store or not profile then
		return
	end
	pcall(function()
		store:SetAsync(keyFor(player), profile)
	end)
end

function StatsService.savePlayer(player)
	save(player)
	dirty[player] = nil
end

Players.PlayerRemoving:Connect(function(player)
	-- MatchService の PlayerRemoving も同じイベントで不戦勝を確定する。
	-- 先に一度保存し、他のハンドラが追加した報酬を defer 後にもう一度保存できるようにする。
	if dirty[player] then
		save(player)
		dirty[player] = nil
	end
	task.defer(function()
		if profiles[player] and dirty[player] then
			save(player)
		end
		profiles[player] = nil
		dirty[player] = nil
	end)
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		return
	end
	for player in pairs(profiles) do
		save(player)
	end
end)

return StatsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source">--!nonstrict
-- 対戦アリーナの生成 (各級ごとに空中に1面)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local ArenaService = {}
local arenas = {} -- [levelKey] = { spawnA=CFrame, spawnB=CFrame, center=CFrame, folder=Instance }

local ARENA_BASE_Y = 600
local ARENA_GAP = 260

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

function ArenaService.build(folder)
	for i, lv in ipairs(Config.LEVELS) do
		local y = ARENA_BASE_Y + (i - 1) * ARENA_GAP
		local f = Instance.new("Folder")
		f.Name = "Arena_" .. lv.key
		f.Parent = folder

		local color = Config.color3(lv)
		local floor = part({
			Name = "Floor",
			Size = Vector3.new(30, 2, 60),
			Position = Vector3.new(0, y, 0),
			Color = Color3.fromRGB(35, 35, 45),
			Material = Enum.Material.Slate,
			Parent = f,
		})

		-- 両陣営のスポーン台。対戦開始時に色が見えるので「自分の側」が直感的。
		for side, z in ipairs({ -20, 20 }) do
			local pad = part({
				Name = side == 1 and "SpawnPadA" or "SpawnPadB",
				Size = Vector3.new(12, 0.35, 8),
				Position = Vector3.new(0, y + 1.2, z),
				Color = side == 1 and Color3.fromRGB(70, 125, 170) or Color3.fromRGB(170, 65, 85),
				Material = Enum.Material.Neon,
				Parent = f,
			})
			local light = Instance.new("PointLight")
			light.Color = pad.Color
			light.Brightness = 1.4
			light.Range = 12
			light.Parent = pad
		end

		-- センターライン
		part({
			Name = "CenterLine",
			Size = Vector3.new(30, 0.4, 1),
			Position = Vector3.new(0, y + 1.1, 0),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = f,
		})

		-- 級カラーの縁取り
		part({
			Name = "TrimA",
			Size = Vector3.new(30, 0.6, 1.4),
			Position = Vector3.new(0, y + 1.2, -29.5),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = f,
		})
		part({
			Name = "TrimB",
			Size = Vector3.new(30, 0.6, 1.4),
			Position = Vector3.new(0, y + 1.2, 29.5),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = f,
		})

		-- 観戦者にも級が分かる小さな立体看板。
		local sign = part({
			Name = "LevelSign",
			Size = Vector3.new(18, 4, 0.35),
			Position = Vector3.new(0, y + 8, 0),
			Color = Color3.fromRGB(20, 18, 28),
			Parent = f,
		})
		local signGui = Instance.new("SurfaceGui")
		signGui.Face = Enum.NormalId.Front
		signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		signGui.PixelsPerStud = 30
		signGui.Parent = sign
		local signText = Instance.new("TextLabel")
		signText.Size = UDim2.fromScale(1, 1)
		signText.BackgroundTransparency = 1
		signText.Font = Enum.Font.GothamBlack
		signText.TextScaled = true
		signText.TextColor3 = color
		signText.Text = lv.label .. "  /  " .. (lv.en and lv.en.label or lv.label)
		signText.Parent = signGui

		-- 透明な壁 (落下防止)
		local wallDefs = {
			{ Vector3.new(32, 30, 1), Vector3.new(0, y + 15, -30.5) },
			{ Vector3.new(32, 30, 1), Vector3.new(0, y + 15, 30.5) },
			{ Vector3.new(1, 30, 62), Vector3.new(-15.5, y + 15, 0) },
			{ Vector3.new(1, 30, 62), Vector3.new(15.5, y + 15, 0) },
		}
		for wi, def in ipairs(wallDefs) do
			local w = part({
				Name = "Wall" .. wi,
				Size = def[1],
				Position = def[2],
				Transparency = 1,
				Parent = f,
			})
			w.CanCollide = true
		end

		-- 天面 (上から飛び込めないように)
		part({
			Name = "Ceiling",
			Size = Vector3.new(32, 1, 62),
			Position = Vector3.new(0, y + 30, 0),
			Transparency = 1,
			Parent = f,
		})

		arenas[lv.key] = {
			spawnA = CFrame.new(0, y + 4, -20) * CFrame.Angles(0, math.pi, 0),
			spawnB = CFrame.new(0, y + 4, 20),
			folder = f,
		}
	end
end

function ArenaService.get(levelKey)
	return arenas[levelKey]
end

return ArenaService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">LobbyService</string><ProtectedString name="Source">--!nonstrict
-- ロビーマップ生成: 広場 + 鳥居風ゲート + 大看板
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local LobbyService = {}

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

function LobbyService.build(folder)
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = folder

	part({
		Name = "LobbyFloor",
		Size = Vector3.new(160, 2, 160),
		Position = Vector3.new(0, 0, 0),
		Color = Color3.fromRGB(52, 48, 60),
		Material = Enum.Material.Slate,
		Parent = lobby,
	})

	-- カーペット
	part({
		Name = "Carpet",
		Size = Vector3.new(10, 0.2, 70),
		Position = Vector3.new(0, 1.05, -20),
		Color = Color3.fromRGB(160, 40, 50),
		Material = Enum.Material.Fabric,
		Parent = lobby,
	})

	-- 鳥居風ゲート
	local red = Color3.fromRGB(190, 40, 50)
	part({ Name = "PillarL", Size = Vector3.new(3, 22, 3), Position = Vector3.new(-11, 12, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })
	part({ Name = "PillarR", Size = Vector3.new(3, 22, 3), Position = Vector3.new(11, 12, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })
	part({ Name = "LintelTop", Size = Vector3.new(34, 2, 4), Position = Vector3.new(0, 24, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })
	part({ Name = "LintelMid", Size = Vector3.new(26, 1.6, 3), Position = Vector3.new(0, 20, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })

	-- 大看板
	local sign = part({
		Name = "Sign",
		Size = Vector3.new(30, 8, 1),
		Position = Vector3.new(0, 31, -55),
		Color = Color3.fromRGB(20, 18, 26),
		Parent = lobby,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(245, 210, 90)
	-- ロゴはラテン表記 + 和文を併記 (日本語/英語どちらのプレイヤーにも読めるように)
	label.Text = (Config.GAME_NAME_EN or "KANJI KOMBAT") .. " / " .. Config.GAME_NAME
	label.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.fromScale(1, 0.35)
	sub.Position = UDim2.fromScale(0, 0.65)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.Gotham
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(220, 220, 230)
	sub.Text = "READING BATTLES / 読み勝負 ・ 漢検10級〜1級 ・ 12,000問"
	sub.Parent = gui

	-- 商店の立体サイン。画面UIと同じ名前にして初見でも導線を作る。
	local shopSign = part({
		Name = "ShopSign",
		Size = Vector3.new(16, 5, 0.8),
		Position = Vector3.new(44, 8, -34),
		Color = Color3.fromRGB(35, 24, 48),
		Parent = lobby,
	})
	local shopGui = Instance.new("SurfaceGui")
	shopGui.Face = Enum.NormalId.Front
	shopGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	shopGui.PixelsPerStud = 35
	shopGui.Parent = shopSign
	local shopText = Instance.new("TextLabel")
	shopText.Size = UDim2.fromScale(1, 1)
	shopText.BackgroundTransparency = 1
	shopText.Font = Enum.Font.GothamBlack
	shopText.TextScaled = true
	shopText.TextColor3 = Color3.fromRGB(245, 210, 90)
	shopText.Text = "SHOP / 商店"
	shopText.Parent = shopGui
	for _, x in ipairs({ -6, 6 }) do
		part({ Name = "ShopPillar", Size = Vector3.new(1, 8, 1), Position = Vector3.new(44 + x, 4, -34), Color = Color3.fromRGB(100, 55, 130), Material = Enum.Material.Neon, Parent = lobby })
	end

	-- 周囲の灯篭風ポール
	for i = -1, 1, 2 do
		for j = -1, 1, 2 do
			part({
				Name = "Lantern",
				Size = Vector3.new(1.4, 9, 1.4),
				Position = Vector3.new(55 * i, 5.5, 55 * j),
				Color = Color3.fromRGB(30, 28, 36),
				Parent = lobby,
			})
			part({
				Name = "LanternLight",
				Size = Vector3.new(1.8, 1.8, 1.8),
				Position = Vector3.new(55 * i, 10.5, 55 * j),
				Color = Color3.fromRGB(255, 200, 90),
				Material = Enum.Material.Neon,
				Parent = lobby,
			})
		end
	end

	-- スポーン
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Name = "Spawn"
	spawnLoc.Size = Vector3.new(12, 1, 12)
	spawnLoc.Position = Vector3.new(0, 1.5, 30)
	spawnLoc.Anchored = true
	spawnLoc.Neutral = true
	spawnLoc.Duration = 0
	spawnLoc.Color = Color3.fromRGB(90, 75, 110)
	spawnLoc.Parent = lobby

	LobbyService.spawnCFrame = CFrame.new(0, 8, 30)
	LobbyService.spectateCFrame = CFrame.new(0, 8, 10)
end

function LobbyService.getSpawn()
	return LobbyService.spawnCFrame or CFrame.new(0, 8, 30)
end

return LobbyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">MatchService</string><ProtectedString name="Source">--!nonstrict
-- マッチメイキング、同時回答バトル、スキル、練習モード。
-- クライアントは「選んだ番号」しか送れず、正解・制限時間・ダメージは全てサーバー判定。
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local MatchService = {}

local QuestionBank, StatsService, ArenaService, LobbyService
local S2C, C2S

local queues = {}       -- [levelKey] = { player, ... }
local queueMeta = {}    -- [player] = { joinedAt, warned }
local inMatch = {}      -- [player] = match
local matches = {}      -- [match] = true
local practice = {}     -- [player] = state

local function send(player, action, data)
	data = data or {}
	data.action = action
	pcall(function()
		S2C:FireClient(player, data)
	end)
end

local function profileRating(player, levelKey)
	local profile = StatsService.get(player)
	return (profile.ratings and profile.ratings[levelKey]) or Config.DEFAULT_RATING
end

local function broadcastQueueCounts()
	local counts = {}
	for key, q in pairs(queues) do
		local n = 0
		for _, p in ipairs(q) do
			if p.Parent and not inMatch[p] then
				n = n + 1
			end
		end
		counts[key] = n
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		send(pl, "queue", counts)
	end
end

function MatchService.init(deps)
	QuestionBank = deps.QuestionBank
	StatsService = deps.StatsService
	ArenaService = deps.ArenaService
	LobbyService = deps.LobbyService
	S2C = deps.S2C
	C2S = deps.C2S
end

-- ================================================================ queue
function MatchService.leaveQueue(player)
	for key, q in pairs(queues) do
		for i = #q, 1, -1 do
			if q[i] == player then
				table.remove(q, i)
			end
		end
		if #q == 0 then
			queues[key] = nil
		end
	end
	queueMeta[player] = nil
	broadcastQueueCounts()
end

function MatchService.joinQueue(player, levelKey)
	if not Config.levelByKey(levelKey) or inMatch[player] or practice[player] then
		return
	end
	MatchService.leaveQueue(player)
	queues[levelKey] = queues[levelKey] or {}
	queues[levelKey][#queues[levelKey] + 1] = player
	queueMeta[player] = { joinedAt = os.clock(), warned = false, levelKey = levelKey }
	send(player, "toast", { key = "toastSearching", args = { level = levelKey } })
	broadcastQueueCounts()
end

local function popTwo(levelKey)
	local q = queues[levelKey]
	if not q then
		return nil
	end
	for i = #q, 1, -1 do
		local p = q[i]
		if not p.Parent or inMatch[p] then
			table.remove(q, i)
			queueMeta[p] = nil
		end
	end
	if #q &lt; 2 then
		return nil
	end

	-- 最古参を軸に、同じ級の中でレートが最も近い相手を選ぶ。
	-- 待ち時間は tick で広がるため、過疎級でも置き去りにしない。
	local a = table.remove(q, 1)
	local aRating = profileRating(a, levelKey)
	local bestIndex, bestScore = 1, math.huge
	for i, p in ipairs(q) do
		local ratingGap = math.abs(profileRating(p, levelKey) - aRating)
		local waited = os.clock() - ((queueMeta[p] and queueMeta[p].joinedAt) or os.clock())
		local score = ratingGap - math.min(waited * 8, 240)
		if score &lt; bestScore then
			bestScore, bestIndex = score, i
		end
	end
	local b = table.remove(q, bestIndex)
	queueMeta[a], queueMeta[b] = nil, nil
	return a, b
end

function MatchService.tick()
	for _, lv in ipairs(Config.LEVELS) do
		while true do
			local a, b = popTwo(lv.key)
			if not a then
				break
			end
			MatchService.startMatch(lv.key, a, b)
		end
	end
	-- 45秒以上待っている人には練習モードを案内するが、キューからは消さない。
	for player, meta in pairs(queueMeta) do
		if not meta.warned and os.clock() - meta.joinedAt &gt;= Config.QUEUE_TIMEOUT then
			meta.warned = true
			send(player, "toast", { key = "searching", args = {} })
		end
	end
end

-- ================================================================ match helpers
local function teleport(player, cf)
	local char = player.Character
	if char and char.PrimaryPart then
		char:PivotTo(cf)
	end
end

local function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

local function playerState(match, player)
	return match.state[player]
end

local function publicState(state)
	return {
		combo = state.combo,
		bestCombo = state.bestCombo,
		energy = state.energy,
		shield = state.shield,
		focus = state.focus,
		correct = state.correct,
		answered = state.answered,
	}
end

local function sendState(match, player, action, extra)
	local data = extra or {}
	data.state = publicState(playerState(match, player))
	send(player, action, data)
end

function MatchService.startMatch(levelKey, p1, p2)
	local arena = ArenaService.get(levelKey)
	if not arena or not p1.Parent or not p2.Parent then
		return
	end
	MatchService.leaveQueue(p1)
	MatchService.leaveQueue(p2)

	local match = {
		levelKey = levelKey,
		players = { p1, p2 },
		hp = { [p1] = Config.MAX_HP, [p2] = Config.MAX_HP },
		state = {
			[p1] = { combo = 0, bestCombo = 0, energy = 0, shield = 0, focus = 0, correct = 0, answered = 0 },
			[p2] = { combo = 0, bestCombo = 0, energy = 0, shield = 0, focus = 0, correct = 0, answered = 0 },
		},
		exclude = {},
		round = 0,
		answers = {},
		answerCount = 0,
		questionId = 0,
		activeQuestion = nil,
		dead = false,
	}
	matches[match] = true
	inMatch[p1], inMatch[p2] = match, match

	task.spawn(function()
		teleport(p1, arena.spawnA)
		teleport(p2, arena.spawnB)
		send(p1, "matchIntro", { levelKey = levelKey, opponent = p2.DisplayName, total = Config.ROUND_COUNT })
		send(p2, "matchIntro", { levelKey = levelKey, opponent = p1.DisplayName, total = Config.ROUND_COUNT })
		task.wait(Config.INTRO_TIME)

		local winner, reason
		for round = 1, Config.ROUND_COUNT do
			if match.dead then
				return
			end
			local outcome = MatchService.playRound(match, round, false)
			if outcome and outcome.winner then
				winner, reason = outcome.winner, outcome.reason
				break
			end
			task.wait(0.35)
		end

		-- 通常ラウンドで決着しなかった場合、HP差を優先する。
		if not winner and match.hp[p1] ~= match.hp[p2] then
			winner = match.hp[p1] &gt; match.hp[p2] and p1 or p2
			reason = "HP"
		end

		-- HPが同じなら、先に正答した側だけが勝つサドンデスへ。
		local suddenCount = 0
		while not match.dead and not winner and match.hp[p1] == match.hp[p2] and suddenCount &lt; 10 do
			suddenCount = suddenCount + 1
			local outcome = MatchService.playRound(match, Config.ROUND_COUNT + suddenCount, true)
			if outcome and outcome.winner then
				winner, reason = outcome.winner, outcome.reason
				break
			end
		end

		if not winner and match.hp[p1] ~= match.hp[p2] then
			winner = match.hp[p1] &gt; match.hp[p2] and p1 or p2
			reason = "HP"
		end

		if not winner then
			match.finished = true
			StatsService.applyDraw(p1, p2)
			send(p1, "matchEnd", { draw = true, summary = MatchService.summaryFor(match, p1) })
			send(p2, "matchEnd", { draw = true, summary = MatchService.summaryFor(match, p2) })
			task.wait(2.5)
			MatchService.endMatch(match, nil)
			return
		end

		MatchService.finishMatch(match, winner, reason or "KO")
		task.wait(4)
		MatchService.endMatch(match, winner)
	end)
end

function MatchService.summaryFor(match, player)
	local state = playerState(match, player)
	return {
		correct = state.correct,
		total = state.answered,
		bestCombo = state.bestCombo,
		accuracy = state.answered &gt; 0 and math.floor(state.correct / state.answered * 100 + 0.5) or 0,
	}
end

function MatchService.finishMatch(match, winner, reason)
	if match.dead or match.finished then
		return
	end
	match.finished = true
	local loser = (match.players[1] == winner) and match.players[2] or match.players[1]
	local delta = StatsService.applyResult(match.levelKey, winner, loser)
	for _, p in ipairs(match.players) do
		local isWin = p == winner
		local summary = MatchService.summaryFor(match, p)
		local reward = StatsService.awardMatch(p, isWin, summary.bestCombo, summary.correct, summary.total)
		local profile = StatsService.get(p)
		send(p, "matchEnd", {
			win = isWin,
			reason = reason,
			opponent = (isWin and loser or winner).DisplayName,
			rating = profile.ratings[match.levelKey],
			delta = isWin and delta or -delta,
			wins = profile.wins,
			losses = profile.losses,
			streak = profile.streak,
			summary = summary,
			reward = reward,
		})
	end
end

-- 1ラウンド進行。return = { winner = Player?, reason = string? }
function MatchService.playRound(match, round, sudden)
	match.round = round
	match.answers = {}
	match.answerCount = 0
	local q = QuestionBank.draw(match.levelKey, match.exclude)
	if not q then
		return nil
	end
	local choices, correct = QuestionBank.pack(q)
	local started = os.clock()
	local deadline = started + Config.QUESTION_TIME
	match.questionId = match.questionId + 1
	match.activeQuestion = { id = match.questionId, round = round, correct = correct, deadline = deadline, started = started }

	local p1, p2 = match.players[1], match.players[2]
	sendState(match, p1, "question", {
		questionId = match.questionId, round = round, total = Config.ROUND_COUNT,
		sudden = sudden, prompt = q.p, isKanji = (#q.p == 1), choices = choices,
		timeLimit = Config.QUESTION_TIME, hpMe = match.hp[p1], hpOp = match.hp[p2],
		opState = publicState(playerState(match, p2)),
	})
	sendState(match, p2, "question", {
		questionId = match.questionId, round = round, total = Config.ROUND_COUNT,
		sudden = sudden, prompt = q.p, isKanji = (#q.p == 1), choices = choices,
		timeLimit = Config.QUESTION_TIME, hpMe = match.hp[p2], hpOp = match.hp[p1],
		opState = publicState(playerState(match, p1)),
	})

	while os.clock() &lt; deadline and match.answerCount &lt; 2 do
		task.wait(0.05)
	end
	task.wait(0.05)

	local function resultOf(player)
		local a = match.answers[player]
		if not a or a.t &gt; deadline + Config.QUESTION_GRACE then
			return { correct = false, t = math.huge, idx = 0, elapsed = Config.QUESTION_TIME }
		end
		return {
			correct = a.idx == correct,
			t = a.t,
			idx = a.idx,
			elapsed = math.max(0, a.t - started),
		}
	end

	local r1, r2 = resultOf(p1), resultOf(p2)
	local firstT = math.min(r1.correct and r1.t or math.huge, r2.correct and r2.t or math.huge)
	local first1 = r1.correct and r1.t == firstT
	local first2 = r2.correct and r2.t == firstT

	local function rawDamage(player, result, isFirst)
		local state = playerState(match, player)
		state.answered = state.answered + 1
		if not result.correct then
			state.combo = 0
			StatsService.recordAnswer(player, false, result.elapsed)
			return 0, { fast = false, first = false, focus = false, combo = 0 }
		end
		state.correct = state.correct + 1
		state.combo = math.min(Config.DMG_COMBO_CAP, state.combo + 1)
		state.bestCombo = math.max(state.bestCombo, state.combo)
		local damage = Config.DMG_BASE + math.max(0, state.combo - 1) * Config.DMG_COMBO_STEP
		local fast = result.elapsed &lt;= 3
		if fast then damage = damage + Config.DMG_FAST_BONUS end
		if isFirst then damage = damage + Config.DMG_FIRST_BONUS end
		local focused = state.focus &gt; 0
		if focused then
			damage = math.floor(damage * Config.DMG_FOCUS_MULTIPLIER + 0.5)
			state.focus = 0
		end
		local gained = Config.ENERGY_CORRECT + (fast and Config.ENERGY_FAST or 0)
		state.energy = clamp(state.energy + gained, 0, Config.ENERGY_MAX)
		StatsService.recordAnswer(player, true, result.elapsed)
		return damage, { fast = fast, first = isFirst, focus = focused, combo = state.combo, energy = gained }
	end

	local raw1, parts1 = rawDamage(p1, r1, first1)
	local raw2, parts2 = rawDamage(p2, r2, first2)
	local function takeDamage(target, amount)
		local state = playerState(match, target)
		local blocked = 0
		if amount &gt; 0 and state.shield &gt; 0 then
			blocked = math.floor(amount * Config.SHIELD_REDUCTION + 0.5)
			amount = math.max(0, amount - blocked)
			state.shield = 0
		end
		return amount, blocked
	end
	local taken1, blocked1 = takeDamage(p1, raw2)
	local taken2, blocked2 = takeDamage(p2, raw1)
	match.hp[p1] = math.max(0, match.hp[p1] - taken1)
	match.hp[p2] = math.max(0, match.hp[p2] - taken2)

	local function resultPayload(me, other, result, parts, dealt, taken, blocked)
		return {
			round = round, questionId = match.questionId, correct = result.correct,
			correctIdx = correct, myIdx = result.idx, dealt = dealt, taken = taken,
			blocked = blocked, opCorrect = result == r1 and r2.correct or r1.correct,
			state = publicState(playerState(match, me)),
			opState = publicState(playerState(match, other)),
			damageParts = parts,
			hpMe = match.hp[me], hpOp = match.hp[other],
		}
	end
	send(p1, "answerResult", resultPayload(p1, p2, r1, parts1, raw1, taken1, blocked1))
	send(p2, "answerResult", resultPayload(p2, p1, r2, parts2, raw2, taken2, blocked2))
	match.activeQuestion = nil

	-- KO は「片方だけ0」なら即時、両方なら先に正答した方を勝者にする。
	if match.hp[p1] &lt;= 0 or match.hp[p2] &lt;= 0 then
		if match.hp[p1] &lt;= 0 and match.hp[p2] &lt;= 0 then
			if first1 and not first2 then return { winner = p1, reason = "KO" } end
			if first2 and not first1 then return { winner = p2, reason = "KO" } end
			return nil
		end
		return { winner = match.hp[p1] &lt;= 0 and p2 or p1, reason = "KO" }
	end

	if sudden then
		if r1.correct and not r2.correct then
			return { winner = p1, reason = "SUDDEN" }
		elseif r2.correct and not r1.correct then
			return { winner = p2, reason = "SUDDEN" }
		elseif r1.correct and r2.correct and first1 ~= first2 then
			return { winner = first1 and p1 or p2, reason = "SUDDEN" }
		end
	end
	return nil
end

function MatchService.useSkill(player, skill)
	local match = inMatch[player]
	if not match or match.dead or not match.activeQuestion then
		return
	end
	local state = playerState(match, player)
	if skill == "guard" then
		if state.energy &lt; Config.ENERGY_GUARD_COST then
			send(player, "skillResult", { ok = false, key = "skillNotReady" })
			return
		end
		state.energy = state.energy - Config.ENERGY_GUARD_COST
		state.shield = Config.GUARD_SHIELD
		sendState(match, player, "skillResult", { ok = true, key = "skillUsed", args = { skill = "Guard" } })
	elseif skill == "focus" then
		if state.energy &lt; Config.ENERGY_FOCUS_COST then
			send(player, "skillResult", { ok = false, key = "skillNotReady" })
			return
		end
		state.energy = state.energy - Config.ENERGY_FOCUS_COST
		state.focus = 1
		sendState(match, player, "skillResult", { ok = true, key = "skillUsed", args = { skill = "Focus" } })
	end
end

function MatchService.endMatch(match, winner)
	if not matches[match] then
		return
	end
	match.dead = true
	match.activeQuestion = nil
	matches[match] = nil
	for _, p in ipairs(match.players) do
		if inMatch[p] == match then
			inMatch[p] = nil
		end
		teleport(p, LobbyService.getSpawn())
		send(p, "toLobby", {})
	end
	broadcastQueueCounts()
end

-- ================================================================ practice
function MatchService.practiceStart(player, levelKey)
	if not Config.levelByKey(levelKey) or inMatch[player] then
		return
	end
	MatchService.leaveQueue(player)
	practice[player] = {
		levelKey = levelKey,
		streak = 0,
		exclude = {},
		active = true,
		questionId = 0,
	}
	MatchService.practiceNext(player)
end

function MatchService.practiceNext(player)
	local st = practice[player]
	if not st or not st.active then
		return
	end
	local q = QuestionBank.draw(st.levelKey, st.exclude)
	if not q then
		return
	end
	local choices, correct = QuestionBank.pack(q)
	st.correct = correct
	st.questionId = st.questionId + 1
	st.started = os.clock()
	st.deadline = st.started + 20
	send(player, "practiceQ", {
		questionId = st.questionId, prompt = q.p, isKanji = (#q.p == 1), choices = choices,
		timeLimit = 20, streak = st.streak, levelKey = st.levelKey,
	})
end

function MatchService.practiceSubmit(player, idx)
	local st = practice[player]
	if not st or not st.active or not st.correct or os.clock() &gt; st.deadline + Config.QUESTION_GRACE then
		return
	end
	local ok = idx == st.correct
	local correctIdx = st.correct
	if ok then
		st.streak = st.streak + 1
	else
		st.streak = 0
	end
	StatsService.recordAnswer(player, ok, math.max(0, os.clock() - st.started))
	StatsService.awardPractice(player, ok)
	st.correct = nil
	send(player, "practiceResult", { correct = ok, correctIdx = correctIdx, streak = st.streak })
	if ok then
		MatchService.practiceNext(player)
	end
end

function MatchService.practiceStop(player)
	local st = practice[player]
	if st then
		st.active = false
	end
	practice[player] = nil
end

-- ================================================================ router
function MatchService.onRemote(player, data)
	if type(data) ~= "table" or type(data.action) ~= "string" then
		return
	end
	local a = data.action
	if a == "queue" and type(data.levelKey) == "string" then
		MatchService.joinQueue(player, data.levelKey)
	elseif a == "cancelQueue" then
		MatchService.leaveQueue(player)
	elseif a == "submit" then
		local match = inMatch[player]
		local q = match and match.activeQuestion
		if q and q.round == data.round and (data.questionId == nil or q.id == data.questionId) and not match.answers[player]
			and type(data.idx) == "number" and os.clock() &lt;= q.deadline + Config.QUESTION_GRACE then
			local idx = math.floor(data.idx)
			if idx &gt;= 1 and idx &lt;= 4 then
				match.answers[player] = { idx = idx, t = os.clock() }
				match.answerCount = match.answerCount + 1
			end
		end
	elseif a == "useSkill" and type(data.skill) == "string" then
		MatchService.useSkill(player, data.skill)
	elseif a == "practiceStart" and type(data.levelKey) == "string" then
		MatchService.practiceStop(player)
		MatchService.practiceStart(player, data.levelKey)
	elseif a == "practiceSubmit" and type(data.idx) == "number" then
		local idx = math.floor(data.idx)
		if idx &gt;= 1 and idx &lt;= 4 then
			MatchService.practiceSubmit(player, idx)
		end
	elseif a == "practiceNext" then
		MatchService.practiceNext(player)
	elseif a == "practiceStop" then
		MatchService.practiceStop(player)
	elseif a == "setLocale" and type(data.locale) == "string" then
		StatsService.setLocale(player, data.locale, data.source)
	end
end

Players.PlayerRemoving:Connect(function(player)
	MatchService.leaveQueue(player)
	MatchService.practiceStop(player)
	local match = inMatch[player]
	if match and not match.dead and not match.finished then
		local other = match.players[1] == player and match.players[2] or match.players[1]
		if other and other.Parent then
			match.dead = true
			local delta = StatsService.applyResult(match.levelKey, other, player)
			local reward = StatsService.awardMatch(other, true, playerState(match, other).bestCombo,
				playerState(match, other).correct, playerState(match, other).answered)
			local profile = StatsService.get(other)
			send(other, "matchEnd", {
				win = true, reason = "leave", opponent = player.DisplayName,
				rating = profile.ratings[match.levelKey], delta = delta,
				wins = profile.wins, losses = profile.losses, streak = profile.streak,
				summary = MatchService.summaryFor(match, other), reward = reward,
			})
			task.delay(3, function()
				MatchService.endMatch(match, other)
			end)
		end
	end
end)

return MatchService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">PurchaseService</string><ProtectedString name="Source">--!nonstrict
-- Robux / ゲーム内ショップ。購入判定と付与はサーバーだけで行う。
-- 商品 ID が 0 の項目は安全な未設定状態として購入ボタンを無効化する。
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local PurchaseService = {}
local StatsService
local S2C
local productsById = {}
local passesById = {}
local itemsByKey = {}

local function send(player, action, data)
	data = data or {}
	data.action = action
	pcall(function()
		S2C:FireClient(player, data)
	end)
end

local function buildIndex()
	productsById, passesById, itemsByKey = {}, {}, {}
	for _, item in ipairs(Config.SHOP_ITEMS) do
		itemsByKey[item.key] = item
		if tonumber(item.id) and item.id &gt; 0 then
			if item.kind == "gamepass" then
				passesById[item.id] = item
			else
				productsById[item.id] = item
			end
		end
	end
end

local function grantItem(player, item)
	if not item or not StatsService.isLoaded(player) then
		return false
	end
	local grant = item.grant or {}
	if grant.coins then
		StatsService.addCoins(player, grant.coins)
	end
	if grant.xp then
		StatsService.addXp(player, grant.xp)
	end
	if grant.item then
		StatsService.grantItem(player, grant.item)
	end
	return true
end

local function owned(player, item)
	if item.kind == "gamepass" and item.grant and item.grant.item then
		return StatsService.hasItem(player, item.grant.item)
	end
	return false
end

function PurchaseService.catalogFor(player)
	local catalog = {}
	for _, item in ipairs(Config.SHOP_ITEMS) do
		catalog[#catalog + 1] = {
			key = item.key,
			kind = item.kind,
			id = item.id,
			robux = item.robux,
			icon = item.icon,
			nameKey = item.nameKey,
			descKey = item.descKey,
			owned = owned(player, item),
			configured = tonumber(item.id) ~= nil and item.id &gt; 0,
		}
	end
	return catalog
end

function PurchaseService.sendState(player)
	if not StatsService or not StatsService.isLoaded(player) then
		return
	end
	local profile = StatsService.get(player)
	send(player, "shopState", {
		coins = profile.coins,
		catalog = PurchaseService.catalogFor(player),
		inventory = profile.inventory,
		equipped = profile.equipped,
	})
end

function PurchaseService.syncPasses(player)
	if not StatsService or not StatsService.isLoaded(player) then
		return
	end
	for passId, item in pairs(passesById) do
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
		end)
		if ok and owns then
			grantItem(player, item)
		end
	end
	PurchaseService.sendState(player)
end

function PurchaseService.grantProduct(player, item, purchaseId)
	if not grantItem(player, item) then
		return false
	end
	if purchaseId then
		StatsService.rememberReceipt(player, purchaseId)
	end
	local profile = StatsService.get(player)
	send(player, "purchaseGranted", {
		itemKey = item.key,
		nameKey = item.nameKey,
		coins = profile.coins,
		xp = profile.xp,
		level = profile.level,
	})
	PurchaseService.sendState(player)
	return true
end

local function receiptDecision(name)
	return Enum.ProductPurchaseDecision[name]
end

local function processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	local item = productsById[receiptInfo.ProductId]
	if not item then
		-- このゲームの所有物でない商品は別の ProcessReceipt 実装に任せる。
		return receiptDecision("NotProcessedYet")
	end
	if not player or not StatsService.isLoaded(player) then
		return receiptDecision("NotProcessedYet")
	end
	local purchaseId = tostring(receiptInfo.PurchaseId or "")
	if purchaseId ~= "" and StatsService.receiptSeen(player, purchaseId) then
		return receiptDecision("PurchaseGranted")
	end
	if PurchaseService.grantProduct(player, item, purchaseId ~= "" and purchaseId or nil) then
		return receiptDecision("PurchaseGranted")
	end
	return receiptDecision("NotProcessedYet")
end

function PurchaseService.init(deps)
	StatsService = deps.StatsService
	S2C = deps.S2C
	buildIndex()

	-- ProcessReceipt はゲーム全体で一度だけ設定する。
	MarketplaceService.ProcessReceipt = processReceipt
	pcall(function()
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
			local item = passesById[passId]
			if purchased and item and StatsService.isLoaded(player) then
				grantItem(player, item)
				local profile = StatsService.get(player)
				send(player, "purchaseGranted", {
					itemKey = item.key,
					nameKey = item.nameKey,
					coins = profile.coins,
					xp = profile.xp,
					level = profile.level,
				})
				PurchaseService.sendState(player)
			end
		end)
	end)
end

function PurchaseService.onRemote(player, data)
	if type(data) ~= "table" then
		return
	end
	if data.action == "shopRefresh" then
		PurchaseService.sendState(player)
	elseif data.action == "equipItem" and type(data.slot) == "string" and type(data.itemKey) == "string" then
		if StatsService.equip(player, data.slot, data.itemKey) then
			PurchaseService.sendState(player)
		end
	end
end

return PurchaseService
