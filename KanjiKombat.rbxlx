	-- バトルパス: 30ティア、1ティア=200XP相当、フリートラック+プレミアム
	PASS_TIERS = 30,
	PASS_XP_PER_TIER = 200,
	PASS_SEASON_DAYS = 30,
}

do
	local t = {}
	for lv = 1, GameConfig.PROGRESSION.MAX_LEVEL do
		t[lv] = 100 + (lv - 1) * 22
	end
	GameConfig.PROGRESSION.XP_TABLE = t
end

