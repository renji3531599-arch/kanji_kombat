-- 多言語対応 (日本語 / 英語)。KKShared.I18n として共有される。
-- 超拡張版: ショップ・バトルパス・対戦演出の全文言をカバー

local Config = require(script.Parent:WaitForChild("GameConfig"))

local I18n = {}

I18n.LOCALES = Config.LOCALES
I18n.DEFAULT = Config.DEFAULT_LOCALE or "en"

