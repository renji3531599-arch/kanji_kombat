local dailyButtonTop = UiKit.button({
	Size = UDim2.fromOffset(92, 32), Position = UDim2.new(1, -460, 0, 6),
	BackgroundColor3 = Color3.fromRGB(110, 70, 50), TextSize = 13, ZIndex = 9,
