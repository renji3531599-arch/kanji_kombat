{p="蹲る",a="うずくまる",d={"つくばう","さえずる","くすぐる"},t="w"},
{p="唸る",a="うなる",d={"うなり","うがい","てん"},t="w"},
{p="下婢",a="かひ",d={"がひ","かび","かぴ"},t="w"},
{p="桿菌",a="かんきん",d={"がんきん","かんぎん","てこきん"},t="w"},
{p="研鑽",a="けんさん",d={"げんさん","けんざん","とぐさん"},t="w"},
{p="篆刻",a="てんこく",d={"でんこく","てんごく","てんきざみ"},t="w"},
{p="衒気",a="げんき",d={"けんき","げんぎ","げんけ"},t="w"},
{p="絆",a="きずな",d={"ぎずな","あだな","つなぐ"},t="w"},
{p="南溟",a="なんめい",d={"なめい","みなみめい","なんうみ"},t="w"},
{p="驀地",a="ばくち",d={"はくち","ぱくち","ばくぢ"},t="w"},
{p="檄文",a="げきぶん",d={"げきもん","げきあや","げきふみ"},t="w"},
{p="睾丸",a="こうがん",d={"ごうがん","こうかん","ぞうがん"},t="w"},
{p="狡猾",a="こうかつ",d={"ごうかつ","こうがつ","きょうかつ"},t="w"},
{p="蠢動",a="しゅんどう",d={"じゅんどう","しゅんとう","ぜんどう"},t="w"},
{p="収斂",a="しゅうれん",d={"じゅうれん","しゅうえん","じゅうたん"},t="w"},
{p="俚語",a="りご",d={"りこ","りん","いちご"},t="w"},
