	sub.Parent = gui

	-- 左右のショップ屋台
	for _, side in ipairs({-1,1}) do
		local x = side * 38
		-- 屋台床
		part({ Name="StallFloor"..side, Size=Vector3.new(16,1,14), Position=Vector3.new(x,0.6,-18), Color=Color3.fromRGB(55,48,42), Material=Enum.Material.Wood, Parent=lobby })
