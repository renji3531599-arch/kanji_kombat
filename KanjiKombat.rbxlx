-- 漢字コンバット shared configuration (ReplicatedStorage.KKShared.GameConfig)

local GameConfig = {}

GameConfig.GAME_NAME = "漢字コンバット"

-- レベル定義。label/desc は日本語UI、en = { label, desc } は英語UI用、
-- jlpt は英語UI向けの「JLPT の目安」(あくまで目安。漢検の級とは別制度)。
GameConfig.LEVELS = {
	{ key = "K10", label = "10級",  desc = "小学校1年生修了程度", kanji = 80,   color = { 90, 185, 105 },
		en = { label = "Level 10", desc = "Grade 1 (elementary)" }, jlpt = "≈ JLPT N5" },
	{ key = "K09", label = "9級",   desc = "小学校2年生修了程度", kanji = 240,  color = { 110, 175, 70 },
		en = { label = "Level 9", desc = "Grade 2 (elementary)" }, jlpt = "≈ JLPT N5" },
	{ key = "K08", label = "8級",   desc = "小学校3年生修了程度", kanji = 440,  color = { 150, 165, 50 },
		en = { label = "Level 8", desc = "Grade 3 (elementary)" }, jlpt = "≈ JLPT N4" },
	{ key = "K07", label = "7級",   desc = "小学校4年生修了程度", kanji = 642,  color = { 190, 155, 40 },
		en = { label = "Level 7", desc = "Grade 4 (elementary)" }, jlpt = "≈ JLPT N3" },
	{ key = "K06", label = "6級",   desc = "小学校5年生修了程度", kanji = 835,  color = { 215, 130, 35 },
		en = { label = "Level 6", desc = "Grade 5 (elementary)" }, jlpt = "≈ JLPT N3" },
	{ key = "K05", label = "5級",   desc = "小学校6年生修了程度", kanji = 1026, color = { 235, 100, 30 },
		en = { label = "Level 5", desc = "Grade 6 (elementary)" }, jlpt = "≈ JLPT N2" },
	{ key = "K04", label = "4級",   desc = "中学校在学程度",      kanji = 1339, color = { 240, 70, 45 },
		en = { label = "Level 4", desc = "Junior high (in progress)" }, jlpt = "≈ JLPT N2" },
	{ key = "K03", label = "3級",   desc = "中学校卒業程度",      kanji = 1623, color = { 235, 50, 75 },
		en = { label = "Level 3", desc = "Junior high graduate" }, jlpt = "≈ JLPT N1" },
	{ key = "KP2", label = "準2級", desc = "高校在学程度",        kanji = 1951, color = { 220, 45, 130 },
		en = { label = "Level Pre-2", desc = "High school (in progress)" }, jlpt = "≈ JLPT N1" },
	{ key = "K02", label = "2級",   desc = "高校卒業程度",        kanji = 2136, color = { 190, 45, 190 },
		en = { label = "Level 2", desc = "High school graduate" }, jlpt = "≈ JLPT N1" },
	{ key = "KP1", label = "準1級", desc = "大学・一般程度",      kanji = 2997, color = { 140, 50, 220 },
		en = { label = "Level Pre-1", desc = "University / adult" }, jlpt = "beyond JLPT N1" },
	{ key = "K01", label = "1級",   desc = "大学・一般程度",      kanji = 6357, color = { 70, 60, 225 },
		en = { label = "Level 1", desc = "University / adult · expert" }, jlpt = "beyond JLPT N1" },
}

GameConfig.GAME_NAME_EN = "KANJI KOMBAT" -- 英語UI用のタイトル (ロゴ表記)
GameConfig.LOCALES = { "ja", "en" }       -- 対応ロケール (切り替え順)
GameConfig.DEFAULT_LOCALE = "en"          -- 日本語以外のロケールは英語UIにフォールバック

GameConfig.ROUND_COUNT = 10        -- 1マッチの問題数
GameConfig.QUESTION_TIME = 12      -- 制限時間(秒)
GameConfig.INTRO_TIME = 3
GameConfig.REVEAL_TIME = 1.6
GameConfig.MAX_HP = 100
GameConfig.DMG_BASE = 20           -- 正答時の基本ダメージ
GameConfig.DMG_FAST_BONUS = 10     -- 3秒以内の正答ボーナス
GameConfig.DMG_FIRST_BONUS = 5     -- 一番乗りボーナス
GameConfig.QUEUE_TIMEOUT = 45      -- マッチが組まれなければ練習を勧める
GameConfig.ELO_K = 32
GameConfig.DEFAULT_RATING = 1000

function GameConfig.levelByKey(key)
	for _, lv in ipairs(GameConfig.LEVELS) do
		if lv.key == key then
			return lv
		end
	end
	return nil
end

function GameConfig.color3(lv)
	local c = lv.color
	return Color3.fromRGB(c[1], c[2], c[3])
end

return GameConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">I18n</string><ProtectedString name="Source">--!nocheck
-- 多言語対応 (日本語 / 英語)。KKShared.I18n として共有される。
--
-- 方針:
--   * 端末のロケール (Player.LocaleId / LocalizationService.RobloxLocaleId) で自動判定し、
--     ja* なら日本語、それ以外は英語にフォールバックする。
--   * プレイヤーが手動で切り替えた場合はその選択を DataStore に保存して優先する。
--   * サーバーは文章を送らず「キー + パラメータ」を送る (送信側の環境に依存しない)。

local Config = require(script.Parent:WaitForChild("GameConfig"))

local I18n = {}

I18n.LOCALES = Config.LOCALES
I18n.DEFAULT = Config.DEFAULT_LOCALE or "en"

-- ================================================================ strings
-- {name} 形式のプレースホルダを I18n.t(key, {name = ...}) で置換する
local STRINGS = {
	-- ---------------------------------------------------------- lobby / title
	title = {
		ja = "漢字コンバット",
		en = Config.GAME_NAME_EN or "KANJI KOMBAT",
	},
	subtitle = {
		ja = "読みオンリー対戦 〜 級を選んで対戦相手と即バトル！",
		en = "Kanji reading battles. Pick a level and fight instantly!",
	},
	splashSubtitle = {
		ja = "読みオンリー対戦 · 漢検10級〜1級 · 12,000問",
		en = "Kanji reading battles · Kanken levels 10 to 1 · 12,000 questions",
	},
	titleStart = {
		ja = "クリックでスタート",
		en = "Click to start",
	},
	levelsNote = {
		ja = "出題範囲：漢検10級〜1級・各1,000問（計12,000問）",
		en = "Levels follow Kanken (Japan Kanji Aptitude Test) grades 10 → 1, 1,000 questions each.",
	},
	profileLoading = {
		ja = "プロフィール読込中…",
		en = "Loading profile…",
	},
	profileStats = {
		ja = "通算 {wins}勝 {losses}敗　連続 {streak}",
		en = "{wins}W {losses}L · streak {streak}",
	},
	rating = {
		ja = "レート {rating}",
		en = "Rating {rating}",
	},
	levelInfo = {
		ja = "漢字 {kanji}字 / 1,000問",
		en = "1,000 questions · {kanji} kanji",
	},
	levelQueue = {
		ja = "対戦待ち {n}人",
		en = "{n} waiting now",
	},

	-- ---------------------------------------------------------- language switch
	languageButton = {
		ja = "🌐 English",
		en = "🌐 日本語",
	},
	languageChanged = {
		ja = "言語: 日本語",
		en = "Language: English",
	},
	languageChangedAuto = {
		ja = "言語: 日本語（端末設定から自動判定）",
		en = "Language: English (auto-detected)",
	},

	-- ---------------------------------------------------------- lobby buttons
	battleButton = {
		ja = "対戦エントリー",
		en = "Find a Match",
	},
	practiceButton = {
		ja = "練習",
		en = "Practice",
	},
	cancelButton = {
		ja = "キャンセル",
		en = "Cancel",
	},
	pickLevel = {
		ja = "級を選んでね！",
		en = "Pick a level first!",
	},
	selected = {
		ja = "{level}（{desc}）を選択中",
		en = "Selected: {level} — {desc}",
	},
	searching = {
		ja = "マッチング中…",
		en = "Searching for an opponent…",
	},
	toastSearching = {
		ja = "{level} の対戦相手を探しています…",
		en = "Looking for an opponent at {level}…",
	},

	-- ---------------------------------------------------------- battle
	opponentLabel = {
		ja = "相手HP",
		en = "Opponent HP",
	},
	myHpLabel = {
		ja = "自分HP",
		en = "Your HP",
	},
	roundLabel = {
		ja = "ROUND {round}/{total}",
		en = "ROUND {round}/{total}",
	},
	suddenDeath = {
		ja = "サドンデス！",
		en = "SUDDEN DEATH!",
	},
	hintWord = {
		ja = "この言葉の読み方を選べ",
		en = "Choose the reading of this word",
	},
	hintKanji = {
		ja = "この漢字の読み方を選べ",
		en = "Choose the reading of this kanji",
	},
	preparing = {
		ja = "準備中…",
		en = "Get ready…",
	},
	answerCorrect = {
		ja = "正解！ 与ダメージ {dealt}",
		en = "Correct! +{dealt} damage",
	},
	answerWrong = {
		ja = "ざんねん… 正解は「{answer}」",
		en = "Missed — the answer is “{answer}”",
	},

	-- ---------------------------------------------------------- practice
	practiceTitle = {
		ja = "練習モード",
		en = "Practice Mode",
	},
	practiceSubtitle = {
		ja = "1人で読みトレーニング。連続正解をのばそう",
		en = "Solo reading drill — build your streak",
	},
	practiceStreak = {
		ja = "連続正解 {streak}",
		en = "Streak: {streak}",
	},
	practiceCorrect = {
		ja = "正解！ {answer}",
		en = "Correct! {answer}",
	},
	practiceWrong = {
		ja = "はずれ… 正解は「{answer}」",
		en = "Wrong… the answer is “{answer}”",
	},
	practiceExit = {
		ja = "練習をやめる",
		en = "Quit Practice",
	},

	-- ---------------------------------------------------------- result
	resultWin = {
		ja = "WIN！",
		en = "YOU WIN!",
	},
	resultLose = {
		ja = "LOSE…",
		en = "YOU LOSE…",
	},
	resultDraw = {
		ja = "DRAW",
		en = "DRAW",
	},
	resultDetail = {
		ja = "VS {opponent}（{reason}）\nレート {before} → {after}（{delta}）\n通算 {wins}勝 {losses}敗",
		en = "vs {opponent} ({reason})\nRating {before} → {after} ({delta})\n{wins}W / {losses}L",
	},
	resultDetailDraw = {
		ja = "HPが同じまま10問終了",
		en = "Ten rounds finished with equal HP",
	},
	reasonMatch = {
		ja = "対戦",
		en = "head-to-head",
	},
	reasonKill = {
		ja = "KO勝ち",
		en = "KO",
	},
	reasonLeave = {
		ja = "不戦勝",
		en = "opponent left",
	},
	backToLobby = {
		ja = "ロビーへ",
		en = "Back to Lobby",
	},
}

-- ================================================================ state
local current = I18n.DEFAULT

local function normalize(code)
	code = tostring(code or ""):lower()
	if code:sub(1, 2) == "ja" then
		return "ja"
	end
	return "en"
end

-- "ja-jp" / "en-us" などのロケールID → "ja" / "en"
function I18n.localeFromId(id)
	return normalize(id)
end

function I18n.setLocale(code)
	current = normalize(code)
	return current
end

function I18n.getLocale()
	return current
end

-- 切り替え先 (ja &lt;-&gt; en)
function I18n.otherLocale(code)
	local c = normalize(code or current)
	return (c == "ja") and "en" or "ja"
end

function I18n.localeLabel(code)
	local c = normalize(code)
	return (c == "ja") and "日本語" or "English"
end

-- 端末ロケールの自動判定 (クライアントのみ。サーバーでは既定値を返す)
function I18n.detectLocale()
	local id = ""
	pcall(function()
		local Players = game:GetService("Players")
		local plr = Players and Players.LocalPlayer
		if plr and plr.LocaleId and plr.LocaleId ~= "" then
			id = plr.LocaleId
		else
			id = game:GetService("LocalizationService").RobloxLocaleId or ""
		end
	end)
	if id == "" then
		return nil, ""
	end
	return normalize(id), id
end

-- ================================================================ translate
function I18n.raw(key, locale)
	local entry = STRINGS[key]
	if not entry then
		return nil
	end
	return entry[normalize(locale or current)] or entry[I18n.DEFAULT] or key
end

function I18n.has(key)
	return STRINGS[key] ~= nil
end

-- 定義済みキーの一覧 (tools/test_luau.py の検証用)
function I18n.keys()
	local out = {}
	for k in pairs(STRINGS) do
		out[#out + 1] = k
	end
	return out
end

-- I18n.t("profileStats", { wins = 3, losses = 1, streak = 2 })
function I18n.t(key, params)
	local s = I18n.raw(key)
	if not s then
		warn("[I18n] missing key: " .. tostring(key))
		return tostring(key)
	end
	if params then
		s = (s:gsub("{([%w_]+)}", function(k)
			local v = params[k]
			return v ~= nil and tostring(v) or ("{" .. k .. "}")
		end))
	end
	return s
end

-- ================================================================ levels
function I18n.levelTitle(levelKey)
	local lv = Config.levelByKey(levelKey)
	if not lv then
		return tostring(levelKey)
	end
	if current == "en" and lv.en and lv.en.label then
		return lv.en.label
	end
	return lv.label
end

function I18n.levelDesc(levelKey)
	local lv = Config.levelByKey(levelKey)
	if not lv then
		return ""
	end
	local base
	if current == "en" and lv.en and lv.en.desc then
		base = lv.en.desc
	else
		base = lv.desc
	end
	-- 英語UIでは JLPT の目安も併記する
	if current == "en" and lv.jlpt and lv.jlpt ~= "" then
		return base .. " · " .. lv.jlpt
	end
	return base
end

-- 級の説明つき表記: 日本語「10級」/ 英語「Level 10 (Grade 1 · ≈ JLPT N5)」
function I18n.levelFull(levelKey)
	local t = I18n.levelTitle(levelKey)
	local d = I18n.levelDesc(levelKey)
	if d == "" then
		return t
	end
	return t .. " (" .. d .. ")"
end

-- 読みの表示: 英語UIでは「きょうしゅう / kyoushuu」のよう併記する
function I18n.reading(kana, romaji)
	if current == "en" and romaji and romaji ~= "" then
		return kana .. " / " .. romaji
	end
	return kana
end

return I18n
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Romaji</string><ProtectedString name="Source">--!nocheck
-- かな → ローマ字 (ヘボン式ベース / 長音は母音を重ねる wāpuro 式)
-- 英語圏プレイヤー向けに読みの選択肢を "きょうしゅう / kyoushuu" のように併記するために使う。
-- utf8 ライブラリに依存しない実装 (LuaJIT / Luau 両対応) — テストは tools/test_luau.py から実行。

local Romaji = {}

local BASE = {
	["あ"] = "a", ["い"] = "i", ["う"] = "u", ["え"] = "e", ["お"] = "o",
	["か"] = "ka", ["き"] = "ki", ["く"] = "ku", ["け"] = "ke", ["こ"] = "ko",
	["が"] = "ga", ["ぎ"] = "gi", ["ぐ"] = "gu", ["げ"] = "ge", ["ご"] = "go",
	["さ"] = "sa", ["し"] = "shi", ["す"] = "su", ["せ"] = "se", ["そ"] = "so",
	["ざ"] = "za", ["じ"] = "ji", ["ず"] = "zu", ["ぜ"] = "ze", ["ぞ"] = "zo",
	["た"] = "ta", ["ち"] = "chi", ["つ"] = "tsu", ["て"] = "te", ["と"] = "to",
	["だ"] = "da", ["ぢ"] = "ji", ["づ"] = "zu", ["で"] = "de", ["ど"] = "do",
	["な"] = "na", ["に"] = "ni", ["ぬ"] = "nu", ["ね"] = "ne", ["の"] = "no",
	["は"] = "ha", ["ひ"] = "hi", ["ふ"] = "fu", ["へ"] = "he", ["ほ"] = "ho",
	["ば"] = "ba", ["び"] = "bi", ["ぶ"] = "bu", ["べ"] = "be", ["ぼ"] = "bo",
	["ぱ"] = "pa", ["ぴ"] = "pi", ["ぷ"] = "pu", ["ぺ"] = "pe", ["ぽ"] = "po",
	["ま"] = "ma", ["み"] = "mi", ["む"] = "mu", ["め"] = "me", ["も"] = "mo",
	["や"] = "ya", ["ゆ"] = "yu", ["よ"] = "yo",
	["ら"] = "ra", ["り"] = "ri", ["る"] = "ru", ["れ"] = "re", ["ろ"] = "ro",
	["わ"] = "wa", ["ゐ"] = "i", ["ゑ"] = "e", ["を"] = "o", ["ん"] = "n",
	["ゔ"] = "vu",
	["ぁ"] = "a", ["ぃ"] = "i", ["ぅ"] = "u", ["ぇ"] = "e", ["ぉ"] = "o",
	["ゃ"] = "ya", ["ゅ"] = "yu", ["ょ"] = "yo", ["ゎ"] = "wa",
	-- カタカナ (データは基本ひらがなだが一応)
	["ア"] = "a", ["イ"] = "i", ["ウ"] = "u", ["エ"] = "e", ["オ"] = "o",
	["カ"] = "ka", ["キ"] = "ki", ["ク"] = "ku", ["ケ"] = "ke", ["コ"] = "ko",
	["サ"] = "sa", ["シ"] = "shi", ["ス"] = "su", ["セ"] = "se", ["ソ"] = "so",
	["タ"] = "ta", ["チ"] = "chi", ["ツ"] = "tsu", ["テ"] = "te", ["ト"] = "to",
	["ナ"] = "na", ["ニ"] = "ni", ["ヌ"] = "nu", ["ネ"] = "ne", ["ノ"] = "no",
	["ハ"] = "ha", ["ヒ"] = "hi", ["フ"] = "fu", ["ヘ"] = "he", ["ホ"] = "ho",
	["マ"] = "ma", ["ミ"] = "mi", ["ム"] = "mu", ["メ"] = "me", ["モ"] = "mo",
	["ヤ"] = "ya", ["ユ"] = "yu", ["ヨ"] = "yo",
	["ラ"] = "ra", ["リ"] = "ri", ["ル"] = "ru", ["レ"] = "re", ["ロ"] = "ro",
	["ワ"] = "wa", ["ヲ"] = "o", ["ン"] = "n",
}

local COMBO = {
	["きゃ"] = "kya", ["きゅ"] = "kyu", ["きょ"] = "kyo",
	["ぎゃ"] = "gya", ["ぎゅ"] = "gyu", ["ぎょ"] = "gyo",
	["しゃ"] = "sha", ["しゅ"] = "shu", ["しょ"] = "sho",
	["じゃ"] = "ja", ["じゅ"] = "ju", ["じょ"] = "jo",
	["ちゃ"] = "cha", ["ちゅ"] = "chu", ["ちょ"] = "cho",
	["ぢゃ"] = "ja", ["ぢゅ"] = "ju", ["ぢょ"] = "jo",
	["にゃ"] = "nya", ["にゅ"] = "nyu", ["にょ"] = "nyo",
	["ひゃ"] = "hya", ["ひゅ"] = "hyu", ["ひょ"] = "hyo",
	["びゃ"] = "bya", ["びゅ"] = "byu", ["びょ"] = "byo",
	["ぴゃ"] = "pya", ["ぴゅ"] = "pyu", ["ぴょ"] = "pyo",
	["みゃ"] = "mya", ["みゅ"] = "myu", ["みょ"] = "myo",
	["りゃ"] = "rya", ["りゅ"] = "ryu", ["りょ"] = "ryo",
	["ふぁ"] = "fa", ["ふぃ"] = "fi", ["ふぇ"] = "fe", ["ふぉ"] = "fo",
	["うぃ"] = "wi", ["うぇ"] = "we", ["うぉ"] = "wo",
	["しぇ"] = "she", ["じぇ"] = "je", ["ちぇ"] = "che",
	["てぃ"] = "ti", ["でぃ"] = "di", ["とぅ"] = "tu", ["どぅ"] = "du",
	["つぁ"] = "tsa", ["つぃ"] = "tsi", ["つぇ"] = "tse", ["つぉ"] = "tso",
	["ゔぁ"] = "va", ["ゔぃ"] = "vi", ["ゔぇ"] = "ve", ["ゔぉ"] = "vo",
}

-- 同じ発音になるかな (じ/ぢ など) の衝突回避用の代替表記
local ALT = { ["ぢ"] = "di", ["づ"] = "du" }
local ALT_COMBO = { ["ぢゃ"] = "dya", ["ぢゅ"] = "dyu", ["ぢょ"] = "dyo" }

local SMALL = {
	["ぁ"] = true, ["ぃ"] = true, ["ぅ"] = true, ["ぇ"] = true, ["ぉ"] = true,
	["ゃ"] = true, ["ゅ"] = true, ["ょ"] = true, ["ゎ"] = true,
}
local VOWELS = { a = true, i = true, u = true, e = true, o = true }
local N_APOSTROPHE = {
	["あ"] = true, ["い"] = true, ["う"] = true, ["え"] = true, ["お"] = true,
	["や"] = true, ["ゆ"] = true, ["よ"] = true,
	["ぁ"] = true, ["ぃ"] = true, ["ぅ"] = true, ["ぇ"] = true, ["ぉ"] = true,
	["ゃ"] = true, ["ゅ"] = true, ["ょ"] = true,
}

-- UTF-8 文字列を1文字ずつのテーブルに分解 (utf8 ライブラリ非依存)
local function chars(s)
	local out, i, n = {}, 1, #s
	while i &lt;= n do
		local b = string.byte(s, i)
		local len = 1
		if b &gt;= 0xF0 then
			len = 4
		elseif b &gt;= 0xE0 then
			len = 3
		elseif b &gt;= 0xC0 then
			len = 2
		end
		out[#out + 1] = string.sub(s, i, i + len - 1)
		i = i + len
	end
	return out
end

-- i 番目 (1始まり) の音節を返す: romaji, 消費した文字数
local function syllable(cs, i, alt)
	local two = cs[i + 1] and (cs[i] .. cs[i + 1]) or nil
	if two then
		local c = (alt and ALT_COMBO[two]) or COMBO[two]
		if c then
			return c, 2
		end
	end
	local ch = cs[i]
	if ch == "ん" then
		local nxt = cs[i + 1]
		if nxt and N_APOSTROPHE[nxt] then
			return "n'", 1
		end
		return "n", 1
	end
	if alt and ALT[ch] then
		return ALT[ch], 1
	end
	return BASE[ch] or ch, 1
end

-- かな文字列 → ローマ字
function Romaji.convert(kana, alt)
	if type(kana) ~= "string" or kana == "" then
		return kana or ""
	end
	local cs = chars(kana)
	local out = {}
	local i, n = 1, #cs
	while i &lt;= n do
		local c = cs[i]
		if c == "っ" or c == "ッ" then
			local nxt = cs[i + 1]
			if nxt and not SMALL[nxt] and nxt ~= "ー" and nxt ~= "っ" and nxt ~= "ッ" then
				local r = syllable(cs, i + 1, alt)
				if r and r ~= "" then
					if string.sub(r, 1, 2) == "ch" then
						out[#out + 1] = "t" -- 抹茶 = matcha
					else
						local k = string.sub(r, 1, 1)
						if not VOWELS[k] then
							if k == "n" and alt then
								-- なんにゅう (nannyuu) と なっにゅう (nannyuu) の区別
								out[#out + 1] = "n'"
							else
								out[#out + 1] = k -- じゅっもく = jummoku (促音の重ね)
							end
						end
					end
				end
			end
			i = i + 1
		elseif c == "ー" then
			local prev = table.concat(out)
			local v = ""
			for j = #prev, 1, -1 do
				local ch = string.sub(prev, j, j)
				if VOWELS[ch] then
					v = ch
					break
				end
			end
			out[#out + 1] = v -- らーめん = raamen
			i = i + 1
		else
			local r, used = syllable(cs, i, alt)
			out[#out + 1] = r
			i = i + used
		end
	end
	return table.concat(out)
end

-- 選択肢4つのように「並べたときに重複しない」ローマ字を返す (例: じ / ぢ → ji / di)
function Romaji.convertMany(list)
	local out, used = {}, {}
	for i = 1, #list do
		local r = Romaji.convert(list[i])
		if used[r] then
			-- 1) 先に出た同表記のものを代替表記へ移せないか (なっにゅう = nan'nyuu)
			for j = 1, i - 1 do
				if out[j] == r then
					local alt = Romaji.convert(list[j], true)
					if alt ~= r and not used[alt] then
						out[j] = alt
						used[alt] = true
						used[r] = nil
						break
					end
				end
			end
		end
		if used[r] then
			-- 2) 自分を代替表記にする (ぢ = di / づ = du)
			local alt = Romaji.convert(list[i], true)
			if alt ~= r and not used[alt] then
				r = alt
			end
		end
		out[i] = r
		used[r] = true
	end
	return out
end

return Romaji
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX26"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX25"><Properties><string name="Name">KanjiKombat</string><ProtectedString name="Source">--!nonstrict
-- 漢字コンバット サーバーエントリポイント
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ------------------------------------------------- remotes
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage

local S2C = Instance.new("RemoteEvent")
S2C.Name = "ServerToClient"
S2C.Parent = remotes

local C2S = Instance.new("RemoteEvent")
C2S.Name = "ClientToServer"
C2S.Parent = remotes

local RF = Instance.new("RemoteFunction")
RF.Name = "GetProfile"
RF.Parent = remotes

-- ------------------------------------------------- modules
local Modules = script:WaitForChild("Modules")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))
local QuestionBank = require(Modules:WaitForChild("QuestionBank"))
local StatsService = require(Modules:WaitForChild("StatsService"))
local ArenaService = require(Modules:WaitForChild("ArenaService"))
local LobbyService = require(Modules:WaitForChild("LobbyService"))
local MatchService = require(Modules:WaitForChild("MatchService"))

math.randomseed(os.time() + os.clock() * 1000)

-- ------------------------------------------------- world
local world = Instance.new("Folder")
world.Name = "KanjiKombatWorld"
world.Parent = workspace

LobbyService.build(world)
ArenaService.build(world)

MatchService.init({
	QuestionBank = QuestionBank,
	StatsService = StatsService,
	ArenaService = ArenaService,
	LobbyService = LobbyService,
	S2C = S2C,
	C2S = C2S,
})

-- クライアントからの操作 (対戦エントリー / 回答 / 練習モード) を受け取る。
-- ここを繋がないとサーバーは何も受信せず、練習モードは問題が1問も出ない。
C2S.OnServerEvent:Connect(function(player, data)
	local ok, err = pcall(MatchService.onRemote, player, data)
	if not ok then
		warn("[MatchService] onRemote: " .. tostring(err))
	end
end)

-- ------------------------------------------------- profile plumbing
local function sanitizeProfile(profile)
	local ratings = {}
	for k, v in pairs(profile.ratings) do
		ratings[k] = v
	end
	return {
		ratings = ratings,
		wins = profile.wins,
		losses = profile.losses,
		streak = profile.streak,
		bestStreak = profile.bestStreak,
		locale = profile.locale, -- 保存された表示言語 (未設定なら nil = 自動判定)
	}
end

RF.OnServerInvoke = function(player)
	return sanitizeProfile(StatsService.get(player))
end

Players.PlayerAdded:Connect(function(player)
	StatsService.load(player)
end)

-- Studio で既に参加済みの場合
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(StatsService.load, player)
end

-- ------------------------------------------------- loops
task.spawn(function()
	while true do
		local ok, err = pcall(MatchService.tick)
		if not ok then
			warn("[MatchService] " .. tostring(err))
		end
		task.wait(1)
	end
end)

print("[KanjiKombat] server ready / 起動完了")
print(string.format("[KanjiKombat] levels=%d, K10=%d, K01=%d questions",
	#Config.LEVELS, QuestionBank.count("K10"), QuestionBank.count("K01")))
</ProtectedString></Properties><Item class="Folder" referent="RBX11"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">QuestionBank</string><ProtectedString name="Source">--!nonstrict
-- 問題バンク: ServerScriptService.KanjiKombat.Data の12レベル分の問題を読み込む
local QuestionBank = {}

local dataFolder = script.Parent.Parent:WaitForChild("Data")

local banks = {}
local order = { "K10", "K09", "K08", "K07", "K06", "K05", "K04", "K03", "KP2", "K02", "KP1", "K01" }

for _, key in ipairs(order) do
	local mod = dataFolder:WaitForChild("Questions_" .. key)
	local ok, result = pcall(require, mod)
	if ok and type(result) == "table" then
		banks[key] = result
	else
		warn("[QuestionBank] failed to load " .. key)
		banks[key] = {}
	end
end

-- levelKey の問題を1問引く (exclude 内のプロンプトは避ける)
function QuestionBank.draw(levelKey, exclude)
	local bank = banks[levelKey]
	if not bank or #bank == 0 then
		return nil
	end
	exclude = exclude or {}
	for _ = 1, 12 do
		local q = bank[math.random(#bank)]
		if not exclude[q.p] then
			exclude[q.p] = true
			return q
		end
	end
	-- 見つからなければ重複を許容
	local q = bank[math.random(#bank)]
	exclude[q.p] = true
	return q
end

-- 選択肢をシャッフルして正解インデックスを返す (1-4)
function QuestionBank.pack(q)
	local choices = { q.a, q.d[1], q.d[2], q.d[3] }
	for i = #choices, 2, -1 do
		local j = math.random(i)
		choices[i], choices[j] = choices[j], choices[i]
	end
	local correct = 1
	for i, c in ipairs(choices) do
		if c == q.a then
			correct = i
			break
		end
	end
	return choices, correct
end

function QuestionBank.count(levelKey)
	return banks[levelKey] and #banks[levelKey] or 0
end

return QuestionBank
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">StatsService</string><ProtectedString name="Source">--!nonstrict
-- プロフィール (DataStore) とレーティング管理
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))
local I18n = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("I18n"))

local StatsService = {}

local store
pcall(function()
	store = DataStoreService:GetDataStore("KK_Profile_v1")
end)

local profiles = {} -- [player] = profile
local dirty = {}    -- [player] = true

local function defaultProfile()
	local ratings = {}
	for _, lv in ipairs(Config.LEVELS) do
		ratings[lv.key] = Config.DEFAULT_RATING
	end
	-- locale = プレイヤーが🌐ボタンで選んだ設定 (保存される)
	-- uiLocale = 今回のセッションの表示言語 (端末ロケールの自動判定 or locale)
	return { ratings = ratings, wins = 0, losses = 0, streak = 0, bestStreak = 0,
		locale = nil, uiLocale = nil }
end

local function localeOf(profile)
	local code = (profile and (profile.uiLocale or profile.locale)) or Config.DEFAULT_LOCALE
	return I18n.localeFromId(code)
end

function StatsService.get(player)
	return profiles[player] or defaultProfile()
end

local function keyFor(player)
	return "u_" .. player.UserId
end

function StatsService.load(player)
	local profile = defaultProfile()
	if store then
		local ok, data = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok and type(data) == "table" then
			if type(data.wins) == "number" then
				profile.wins = data.wins
			end
			if type(data.losses) == "number" then
				profile.losses = data.losses
			end
			if type(data.streak) == "number" then
				profile.streak = data.streak
			end
			if type(data.bestStreak) == "number" then
				profile.bestStreak = data.bestStreak
			end
			if type(data.locale) == "string" then
				profile.locale = I18n.localeFromId(data.locale)
			end
			if type(data.ratings) == "table" then
				for _, lv in ipairs(Config.LEVELS) do
					local r = data.ratings[lv.key]
					if type(r) == "number" then
						profile.ratings[lv.key] = r
					end
				end
			end
		end
	end
	profiles[player] = profile
	StatsService.setupLeaderstats(player, profile)
end

-- リーダーボード (勝数 / Wins) — 表示言語に合わせて名前を切り替える
function StatsService.setupLeaderstats(player, profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end
	local wins = ls:FindFirstChild("勝数") or ls:FindFirstChild("Wins")
	if not wins then
		wins = Instance.new("IntValue")
		wins.Parent = ls
	end
	wins.Name = (localeOf(profile) == "ja") and "勝数" or "Wins"
	wins.Value = profile.wins
end

-- クライアントから通知された表示言語 (source = "manual" のときだけ保存する)
function StatsService.setLocale(player, code, source)
	local profile = profiles[player]
	if not profile then
		return
	end
	local normalized = I18n.localeFromId(code)
	profile.uiLocale = normalized
	if source == "manual" then
		profile.locale = normalized
		StatsService.markDirty(player)
	end
	StatsService.setupLeaderstats(player, profile)
end

function StatsService.markDirty(player)
	dirty[player] = true
end

local function save(player)
	local profile = profiles[player]
	if not store or not profile then
		return
	end
	pcall(function()
		store:SetAsync(keyFor(player), profile)
	end)
end

function StatsService.savePlayer(player)
	save(player)
	dirty[player] = nil
end

-- Elo: winner/loser は player インスタンス
function StatsService.applyResult(levelKey, winner, loser)
	local pw = profiles[winner]
	local pl = profiles[loser]
	if not pw or not pl then
		return
	end
	local rw = pw.ratings[levelKey] or Config.DEFAULT_RATING
	local rl = pl.ratings[levelKey] or Config.DEFAULT_RATING
	local ew = 1 / (1 + 10 ^ ((rl - rw) / 400))
	local dw = math.max(5, math.floor(Config.ELO_K * (1 - ew) + 0.5))
	pw.ratings[levelKey] = rw + dw
	pl.ratings[levelKey] = math.max(100, rl - dw)
	pw.wins = pw.wins + 1
	pl.losses = pl.losses + 1
	pw.streak = pw.streak + 1
	pl.streak = 0
	if pw.streak &gt; pw.bestStreak then
		pw.bestStreak = pw.streak
	end
	local ls = winner:FindFirstChild("leaderstats")
	local winsValue = ls and (ls:FindFirstChild("勝数") or ls:FindFirstChild("Wins"))
	if winsValue then
		winsValue.Value = pw.wins
	end
	StatsService.markDirty(winner)
	StatsService.markDirty(loser)
	return dw
end

Players.PlayerRemoving:Connect(function(player)
	if dirty[player] then
		save(player)
	end
	profiles[player] = nil
	dirty[player] = nil
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		return
	end
	for player in pairs(profiles) do
		save(player)
	end
end)

return StatsService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source">--!nonstrict
-- 対戦アリーナの生成 (各級ごとに空中に1面)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local ArenaService = {}
local arenas = {} -- [levelKey] = { spawnA=CFrame, spawnB=CFrame, center=CFrame, folder=Instance }

local ARENA_BASE_Y = 600
local ARENA_GAP = 260

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

function ArenaService.build(folder)
	for i, lv in ipairs(Config.LEVELS) do
		local y = ARENA_BASE_Y + (i - 1) * ARENA_GAP
		local f = Instance.new("Folder")
		f.Name = "Arena_" .. lv.key
		f.Parent = folder

		local color = Config.color3(lv)
		local floor = part({
			Name = "Floor",
			Size = Vector3.new(30, 2, 60),
			Position = Vector3.new(0, y, 0),
			Color = Color3.fromRGB(35, 35, 45),
			Parent = f,
		})

		-- センターライン
		part({
			Name = "CenterLine",
			Size = Vector3.new(30, 0.4, 1),
			Position = Vector3.new(0, y + 1.1, 0),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = f,
		})

		-- 級カラーの縁取り
		part({
			Name = "TrimA",
			Size = Vector3.new(30, 0.6, 1.4),
			Position = Vector3.new(0, y + 1.2, -29.5),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = f,
		})
		part({
			Name = "TrimB",
			Size = Vector3.new(30, 0.6, 1.4),
			Position = Vector3.new(0, y + 1.2, 29.5),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = f,
		})

		-- 透明な壁 (落下防止)
		local wallDefs = {
			{ Vector3.new(32, 30, 1), Vector3.new(0, y + 15, -30.5) },
			{ Vector3.new(32, 30, 1), Vector3.new(0, y + 15, 30.5) },
			{ Vector3.new(1, 30, 62), Vector3.new(-15.5, y + 15, 0) },
			{ Vector3.new(1, 30, 62), Vector3.new(15.5, y + 15, 0) },
		}
		for wi, def in ipairs(wallDefs) do
			local w = part({
				Name = "Wall" .. wi,
				Size = def[1],
				Position = def[2],
				Transparency = 1,
				Parent = f,
			})
			w.CanCollide = true
		end

		-- 天面 (上から飛び込めないように)
		part({
			Name = "Ceiling",
			Size = Vector3.new(32, 1, 62),
			Position = Vector3.new(0, y + 30, 0),
			Transparency = 1,
			Parent = f,
		})

		arenas[lv.key] = {
			spawnA = CFrame.new(0, y + 4, -20) * CFrame.Angles(0, math.pi, 0),
			spawnB = CFrame.new(0, y + 4, 20),
			folder = f,
		}
	end
end

function ArenaService.get(levelKey)
	return arenas[levelKey]
end

return ArenaService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">LobbyService</string><ProtectedString name="Source">--!nonstrict
-- ロビーマップ生成: 広場 + 鳥居風ゲート + 大看板
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local LobbyService = {}

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

function LobbyService.build(folder)
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = folder

	part({
		Name = "LobbyFloor",
		Size = Vector3.new(160, 2, 160),
		Position = Vector3.new(0, 0, 0),
		Color = Color3.fromRGB(52, 48, 60),
		Material = Enum.Material.Slate,
		Parent = lobby,
	})

	-- カーペット
	part({
		Name = "Carpet",
		Size = Vector3.new(10, 0.2, 70),
		Position = Vector3.new(0, 1.05, -20),
		Color = Color3.fromRGB(160, 40, 50),
		Material = Enum.Material.Fabric,
		Parent = lobby,
	})

	-- 鳥居風ゲート
	local red = Color3.fromRGB(190, 40, 50)
	part({ Name = "PillarL", Size = Vector3.new(3, 22, 3), Position = Vector3.new(-11, 12, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })
	part({ Name = "PillarR", Size = Vector3.new(3, 22, 3), Position = Vector3.new(11, 12, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })
	part({ Name = "LintelTop", Size = Vector3.new(34, 2, 4), Position = Vector3.new(0, 24, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })
	part({ Name = "LintelMid", Size = Vector3.new(26, 1.6, 3), Position = Vector3.new(0, 20, -55), Color = red, Material = Enum.Material.Wood, Parent = lobby })

	-- 大看板
	local sign = part({
		Name = "Sign",
		Size = Vector3.new(30, 8, 1),
		Position = Vector3.new(0, 31, -55),
		Color = Color3.fromRGB(20, 18, 26),
		Parent = lobby,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(245, 210, 90)
	-- ロゴはラテン表記 + 和文を併記 (日本語/英語どちらのプレイヤーにも読めるように)
	label.Text = (Config.GAME_NAME_EN or "KANJI KOMBAT") .. " / " .. Config.GAME_NAME
	label.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.fromScale(1, 0.35)
	sub.Position = UDim2.fromScale(0, 0.65)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.Gotham
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(220, 220, 230)
	sub.Text = "READING BATTLES / 読み勝負 ・ 漢検10級〜1級 ・ 12,000問"
	sub.Parent = gui

	-- 周囲の灯篭風ポール
	for i = -1, 1, 2 do
		for j = -1, 1, 2 do
			part({
				Name = "Lantern",
				Size = Vector3.new(1.4, 9, 1.4),
				Position = Vector3.new(55 * i, 5.5, 55 * j),
				Color = Color3.fromRGB(30, 28, 36),
				Parent = lobby,
			})
			part({
				Name = "LanternLight",
				Size = Vector3.new(1.8, 1.8, 1.8),
				Position = Vector3.new(55 * i, 10.5, 55 * j),
				Color = Color3.fromRGB(255, 200, 90),
				Material = Enum.Material.Neon,
				Parent = lobby,
			})
		end
	end

	-- スポーン
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Name = "Spawn"
	spawnLoc.Size = Vector3.new(12, 1, 12)
	spawnLoc.Position = Vector3.new(0, 1.5, 30)
	spawnLoc.Anchored = true
	spawnLoc.Neutral = true
	spawnLoc.Duration = 0
	spawnLoc.Color = Color3.fromRGB(90, 75, 110)
	spawnLoc.Parent = lobby

	LobbyService.spawnCFrame = CFrame.new(0, 8, 30)
	LobbyService.spectateCFrame = CFrame.new(0, 8, 10)
end

function LobbyService.getSpawn()
	return LobbyService.spawnCFrame or CFrame.new(0, 8, 30)
end

return LobbyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">MatchService</string><ProtectedString name="Source">--!nonstrict
-- マッチメイキングと対戦進行、練習モード
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("KKShared"):WaitForChild("GameConfig"))

local MatchService = {}

local QuestionBank, StatsService, ArenaService, LobbyService
local S2C, C2S -- RemoteEvents

local queues = {}     -- [levelKey] = {player, ...}
local inMatch = {}    -- [player] = match
local matches = {}    -- [match] = true
local practice = {}   -- [player] = state

local function send(player, action, data)
	data = data or {}
	data.action = action
	pcall(function()
		S2C:FireClient(player, data)
	end)
end

local function broadcastQueueCounts()
	local counts = {}
	for key, q in pairs(queues) do
		counts[key] = #q
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		send(pl, "queue", counts)
	end
end

function MatchService.init(deps)
	QuestionBank = deps.QuestionBank
	StatsService = deps.StatsService
	ArenaService = deps.ArenaService
	LobbyService = deps.LobbyService
	S2C = deps.S2C
	C2S = deps.C2S
end

-- ------------------------------------------------------------- queue
function MatchService.joinQueue(player, levelKey)
	if not Config.levelByKey(levelKey) then
		return
	end
	if inMatch[player] then
		return
	end
	MatchService.leaveQueue(player)
	if not queues[levelKey] then
		queues[levelKey] = {}
	end
	table.insert(queues[levelKey], player)
	-- 言語はクライアント側で決める (キー + パラメータだけ送る)
	send(player, "toast", { key = "toastSearching", args = { level = levelKey } })
	broadcastQueueCounts()
end

function MatchService.leaveQueue(player)
	for key, q in pairs(queues) do
		for i, p in ipairs(q) do
			if p == player then
				table.remove(q, i)
				break
			end
		end
	end
	broadcastQueueCounts()
end

local function popTwo(levelKey)
	local q = queues[levelKey]
	if not q then
		return nil
	end
	-- 退場済みプレイヤーを掃除
	for i = #q, 1, -1 do
		local p = q[i]
		if not p.Parent or inMatch[p] then
			table.remove(q, i)
		end
	end
	if #q &lt; 2 then
		return nil
	end
	local a = table.remove(q, 1)
	local b = table.remove(q, 1)
	return a, b
end

function MatchService.tick()
	for _, lv in ipairs(Config.LEVELS) do
		while true do
			local a, b = popTwo(lv.key)
			if not a then
				break
			end
			MatchService.startMatch(lv.key, a, b)
		end
	end
end

-- ------------------------------------------------------------- match
local function teleport(player, cf)
	local char = player.Character
	if char and char.PrimaryPart then
		char:PivotTo(cf)
	end
end

function MatchService.startMatch(levelKey, p1, p2)
	local arena = ArenaService.get(levelKey)
	if not arena then
		return
	end
	inMatch[p1] = true
	inMatch[p2] = true
	MatchService.leaveQueue(p1)
	MatchService.leaveQueue(p2)

	local match = {
		levelKey = levelKey,
		players = { p1, p2 },
		hp = { [p1] = Config.MAX_HP, [p2] = Config.MAX_HP },
		exclude = {},
		round = 0,
		answers = {},
		answerCount = 0,
		dead = false,
	}
	matches[match] = true

	task.spawn(function()
		teleport(p1, arena.spawnA)
		teleport(p2, arena.spawnB)
		send(p1, "matchIntro", { levelKey = levelKey, opponent = p2.DisplayName, total = Config.ROUND_COUNT })
		send(p2, "matchIntro", { levelKey = levelKey, opponent = p1.DisplayName, total = Config.ROUND_COUNT })
		task.wait(Config.INTRO_TIME)

		local loser = nil
		for round = 1, Config.ROUND_COUNT do
			if match.dead then
				break
			end
			local ko = MatchService.playRound(match, round, false)
			if ko then
				loser = ko
				break
			end
			task.wait(0.35)
		end
		if match.dead then
			MatchService.endMatch(match, nil)
			return
		end

		-- 決着してなければサドンデス (最大10問)
		local suddenCount = 0
		while not match.dead and not loser and match.hp[p1] == match.hp[p2] and suddenCount &lt; 10 do
			suddenCount = suddenCount + 1
			loser = MatchService.playRound(match, match.round + 1, true)
			if loser == "none" then
				loser = nil -- 両方不正解なら次のサドンデス問へ
			end
		end

		local winner, reason
		if loser then
			winner = (loser == p1) and p2 or p1
			reason = "KO"
		elseif match.hp[p1] &gt; match.hp[p2] then
			winner = p1
			loser = p2
			reason = "HP"
		elseif match.hp[p2] &gt; match.hp[p1] then
			winner = p2
			loser = p1
			reason = "HP"
		else
			-- 完全引き分け: 勝数に影響させず終了
			send(p1, "matchEnd", { draw = true })
			send(p2, "matchEnd", { draw = true })
			task.wait(2.5)
			MatchService.endMatch(match, nil)
			return
		end

		local dw = StatsService.applyResult(levelKey, winner, loser)
		for _, p in ipairs(match.players) do
			local prof = StatsService.get(p)
			local isWin = (p == winner)
			send(p, "matchEnd", {
				win = isWin,
				reason = reason,
				opponent = (p == winner) and loser.DisplayName or winner.DisplayName,
				rating = prof.ratings[levelKey],
				delta = isWin and dw or -dw,
				wins = prof.wins,
				losses = prof.losses,
				streak = prof.streak,
			})
		end
		task.wait(4)
		MatchService.endMatch(match, winner)
	end)
end

-- 1ラウンド進行。KO時は敗者playerを返す。サドンデス時は勝者を返す("none"=両方誤答)
function MatchService.playRound(match, round, sudden)
	match.round = round
	match.answers = {}
	match.answerCount = 0
	local q = QuestionBank.draw(match.levelKey, match.exclude)
	if not q then
		return nil
	end
	local choices, correct = QuestionBank.pack(q)
	local deadline = os.clock() + Config.QUESTION_TIME
	match.correct = correct
	match.deadline = deadline

	local hp1, hp2 = match.hp[match.players[1]], match.hp[match.players[2]]
	send(match.players[1], "question", {
		round = round, total = Config.ROUND_COUNT, sudden = sudden,
		prompt = q.p, isKanji = (#q.p == 1), choices = choices,
		timeLimit = Config.QUESTION_TIME, hpMe = hp1, hpOp = hp2,
	})
	send(match.players[2], "question", {
		round = round, total = Config.ROUND_COUNT, sudden = sudden,
		prompt = q.p, isKanji = (#q.p == 1), choices = choices,
		timeLimit = Config.QUESTION_TIME, hpMe = hp2, hpOp = hp1,
	})

	while os.clock() &lt; deadline and match.answerCount &lt; 2 do
		task.wait(0.05)
	end
	task.wait(0.1) -- 正答直前の提出を受け取る猶予

	local function resultOf(p)
		local a = match.answers[p]
		if not a or os.clock() - 0 &gt; deadline + 0.6 then
			-- 期内のみ有効 (下で判定し直す)
		end
		if not a then
			return { correct = false, t = math.huge, idx = 0 }
		end
		return {
			correct = (a.idx == match.correct) and a.t &lt;= deadline + 0.6,
			t = a.t,
			idx = a.idx,
		}
	end

	local r1 = resultOf(match.players[1])
	local r2 = resultOf(match.players[2])

	-- ダメージ計算
	local dmg1, dmg2 = 0, 0
	local firstT = math.min(r1.t, r2.t)
	if r1.correct then
		dmg1 = Config.DMG_BASE
		if r1.t - (deadline - Config.QUESTION_TIME) &lt;= 3 then
			dmg1 = dmg1 + Config.DMG_FAST_BONUS
		end
		if r1.t == firstT then
			dmg1 = dmg1 + Config.DMG_FIRST_BONUS
		end
	end
	if r2.correct then
		dmg2 = Config.DMG_BASE
		if r2.t - (deadline - Config.QUESTION_TIME) &lt;= 3 then
			dmg2 = dmg2 + Config.DMG_FAST_BONUS
		end
		if r2.t == firstT then
			dmg2 = dmg2 + Config.DMG_FIRST_BONUS
		end
	end
	match.hp[match.players[1]] = math.max(0, hp1 - dmg2)
	match.hp[match.players[2]] = math.max(0, hp2 - dmg1)

	local nowHp1, nowHp2 = match.hp[match.players[1]], match.hp[match.players[2]]
	send(match.players[1], "answerResult", {
		round = round, correct = r1.correct, correctIdx = match.correct,
		myIdx = r1.idx, dealt = dmg1, taken = dmg2,
		hpMe = nowHp1, hpOp = nowHp2,
		opCorrect = r2.correct,
	})
	send(match.players[2], "answerResult", {
		round = round, correct = r2.correct, correctIdx = match.correct,
		myIdx = r2.idx, dealt = dmg2, taken = dmg1,
		hpMe = nowHp2, hpOp = nowHp1,
	})

	if sudden then
		if r1.correct and r2.correct then
			return (r1.t &lt;= r2.t) and match.players[2] or match.players[1] -- 速い方の相手が敗者…いや勝者判定は呼び出し側
		elseif r1.correct then
			return match.players[2] == nil and "none" or "win1"
		elseif r2.correct then
			return "win2"
		end
		return "none"
	end

	if nowHp1 &lt;= 0 then
		return match.players[1]
	elseif nowHp2 &lt;= 0 then
		return match.players[2]
	end
	return nil
end

function MatchService.endMatch(match, winner)
	match.dead = true
	matches[match] = nil
	for _, p in ipairs(match.players) do
		inMatch[p] = nil
		teleport(p, LobbyService.getSpawn())
		send(p, "toLobby", {})
	end
end

-- ------------------------------------------------------------- practice
function MatchService.practiceStart(player, levelKey)
	if not Config.levelByKey(levelKey) then
		return
	end
	practice[player] = { levelKey = levelKey, streak = 0, exclude = {}, active = true }
	MatchService.practiceNext(player)
end

function MatchService.practiceNext(player)
	local st = practice[player]
	if not st or not st.active then
		return
	end
	local q = QuestionBank.draw(st.levelKey, st.exclude)
	if not q then
		return
	end
	local choices, correct = QuestionBank.pack(q)
	st.correct = correct
	send(player, "practiceQ", {
		prompt = q.p, isKanji = (#q.p == 1), choices = choices,
		timeLimit = 20, streak = st.streak,
		levelKey = st.levelKey,
	})
end

function MatchService.practiceSubmit(player, idx)
	local st = practice[player]
	if not st or not st.active then
		return
	end
	if not st.correct then
		return -- まだ問題を出していない (最初の practiceQ が届く前のクリック)
	end
	local ok = (idx == st.correct)
	if ok then
		st.streak = st.streak + 1
	else
		st.streak = 0
	end
	send(player, "practiceResult", { correct = ok, correctIdx = st.correct, streak = st.streak })
	if ok then
		MatchService.practiceNext(player)
	end
end

function MatchService.practiceStop(player)
	local st = practice[player]
	if st then
		st.active = false
	end
	practice[player] = nil
end

-- ------------------------------------------------------------- router
function MatchService.onRemote(player, data)
	if type(data) ~= "table" or type(data.action) ~= "string" then
		return
	end
	local a = data.action
	if a == "queue" and type(data.levelKey) == "string" then
		MatchService.joinQueue(player, data.levelKey)
	elseif a == "cancelQueue" then
		MatchService.leaveQueue(player)
	elseif a == "submit" and inMatch[player] then
		-- find the match
		for m in pairs(matches) do
			if m.players[1] == player or m.players[2] == player then
				if m.round == data.round and not m.answers[player] and type(data.idx) == "number" then
					local idx = math.floor(data.idx)
					if idx &gt;= 1 and idx &lt;= 4 then
						m.answers[player] = { idx = idx, t = os.clock() }
						m.answerCount = m.answerCount + 1
					end
				end
				break
			end
		end
	elseif a == "practiceStart" and type(data.levelKey) == "string" then
		MatchService.practiceStop(player)
		MatchService.practiceStart(player, data.levelKey)
	elseif a == "practiceSubmit" and type(data.idx) == "number" then
		local idx = math.floor(data.idx)
		if idx &gt;= 1 and idx &lt;= 4 then
			MatchService.practiceSubmit(player, idx)
		end
	elseif a == "practiceNext" then
		MatchService.practiceNext(player)
	elseif a == "practiceStop" then
		MatchService.practiceStop(player)
	elseif a == "setLocale" and type(data.locale) == "string" then
		StatsService.setLocale(player, data.locale, data.source)
	end
end

Players.PlayerRemoving:Connect(function(player)
	MatchService.leaveQueue(player)
	MatchService.practiceStop(player)
	if inMatch[player] then
		for m in pairs(matches) do
			if m.players[1] == player or m.players[2] == player then
				local other = (m.players[1] == player) and m.players[2] or m.players[1]
				if not m.dead then
					m.dead = true
					-- 残った側を勝ちに
					local prof = StatsService.get(other)
					send(other, "matchEnd", {
						win = true, reason = "leave",
						opponent = player.DisplayName,
						rating = prof.ratings[m.levelKey],
						delta = 10, wins = prof.wins, losses = prof.losses, streak = prof.streak,
					})
					task.delay(3, function()
						MatchService.endMatch(m, other)
					end)
				end
			end
		end
	end
end)

return MatchService
