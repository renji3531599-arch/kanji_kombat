}, screen)
local pracTitle = UiKit.label({
	Size = UDim2.fromOffset(600, 32), Position = UDim2.new(0.5, -300, 0, 20),
	Font = Enum.Font.GothamBold, TextColor3 = COL_GOLD, Text = "",
}, prac)
local pracSub = UiKit.label({
